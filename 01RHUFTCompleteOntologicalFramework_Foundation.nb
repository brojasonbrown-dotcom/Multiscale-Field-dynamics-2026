 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"091481fd-824c-e443-be3f-d67993034041"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Emergence of matter, time, gravity, and electromagnetism", "Section",ExpressionUUID->"736f7c06-4b3f-d149-a663-269dbe13f60e"],

Cell[CellGroupData[{

Cell["11.1. Matter", "Subsection",ExpressionUUID->"52d85cee-82e9-fe4f-95b6-f4eb64a92f0d"],

Cell["\<\
In this framework, matter would not be primitive substance. It would be \
stable closure under recursive field maintenance. \
\>", "Text",ExpressionUUID->"2620e34b-3a1b-5749-92b7-fde5d4ac0f3b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.2. Time", "Subsection",ExpressionUUID->"968276b1-a630-cc47-a141-ec42ff09804a"],

Cell["\<\
Time may be interpreted as ordered recurrence or countable asymmetry in field \
update.\
\>", "Text",ExpressionUUID->"6c270399-6d10-f445-94e7-7f53ffe298bc"],

Cell["A conceptual definition is: ", "Text",ExpressionUUID->"3e8bcc8e-0b5a-f841-ade7-a3e627135128"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"time is the ordering parameter of irreversible stabilization \
sequences.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"d2e3390c-a71a-ee45-9275-cfb04bdb0a9b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.3. Gravity", "Subsection",ExpressionUUID->"2aa3923a-ebcd-f146-9cdc-59c0ad1ae9b1"],

Cell["\<\
Gravity could be reinterpreted as geometry-dependent drift of closure density \
or compression in the field\[CloseCurlyQuote]s stable relational structure. \
\>", "Text",ExpressionUUID->"6a6b02df-646f-5f4a-b9f9-aae6472ffabd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.4. Electromagnetism", "Subsection",ExpressionUUID->"aad476fd-813d-bc40-8a00-277e8b0b260d"],

Cell["\<\
Electromagnetism may emerge from polarized relational organization and \
phase-sensitive propagation across structured media of distinction. \
\>", "Text",ExpressionUUID->"b8a9ba3d-d5e4-8a45-9d2f-b9f806ece737"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.5. Status note", "Subsection",ExpressionUUID->"ad9f5295-84f3-b043-95e4-150ea3f162e0"],

Cell["\<\
All of these are hypotheses unless tied to equations that reproduce known \
experimental results. \
\>", "Text",ExpressionUUID->"79397792-2455-9e4b-b88d-cfda5f6ad911"],

