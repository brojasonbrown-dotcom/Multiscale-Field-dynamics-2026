Cell[CellGroupData[{

Cell["\<\
16. Boundary between established physics and metaphysical extension\
\>", "Section",ExpressionUUID->"69018a87-f6da-8649-9fee-91d0881a9dc1"],

Cell[CellGroupData[{

Cell["16.1. Established physics includes", "Subsection",ExpressionUUID->"b358113e-5667-974e-8fcd-8738a35abd71"],

Cell["experimentally validated quantum theory,", "Item",ExpressionUUID->"b2b45261-06bc-ff4c-85ac-8f7503500823"],

Cell["relativity,", "Item",ExpressionUUID->"0fdba41d-e124-6341-a3a2-414eb3364b14"],

Cell["standard measurement theory in operational settings,", "Item",ExpressionUUID->"bea6b22d-8cac-9546-bdc7-15677bc4ac4f"],

Cell["known field equations and particle phenomenology.", "Item",ExpressionUUID->"cca1660f-8253-894a-b822-b1b4bf7a23dd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
16.2. This framework extends beyond established physics when it asserts\
\>", "Subsection",ExpressionUUID->"fcec2b7c-9887-a440-a572-bda3465b575c"],

Cell["ontological potential prior to physical law,", "Item",ExpressionUUID->"8bfc1199-3c72-2c47-8a3a-98d91c830952"],

Cell["recursive self-measurement as fundamental,", "Item",ExpressionUUID->"0110fdc3-b90a-d043-ab31-d7bbc2729560"],

Cell["closure invariants underlying constants,", "Item",ExpressionUUID->"8c05f7c9-75e7-934f-adeb-8f64fbdce2ac"],

Cell["consciousness as intrinsic interiority of recursive systems,", "Item",ExpressionUUID->"1d60c7c7-ce44-b648-a61d-ee4843641f88"],

Cell["\<\
spiritual or symbolic categories as field-correlative descriptions.\
\>", "Item",ExpressionUUID->"3585a011-1c22-9443-b911-186b3bb381b1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["16.3. Why this boundary matters", "Subsection",ExpressionUUID->"df497643-2e4d-7849-b4fc-8622bf94004f"],

Cell["\<\
Without this boundary, the theory loses scientific credibility. With it, the \
theory can be both ambitious and rigorous. \
\>", "Text",ExpressionUUID->"396e5b55-c0b1-2842-91d7-0dda7235ebba"],

