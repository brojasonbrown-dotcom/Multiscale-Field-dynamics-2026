Cell[CellGroupData[{

Cell["13. Consciousness as recursive interiority", "Section",ExpressionUUID->"9fb1287c-5e3e-f34c-bd59-4b054947cd08"],

Cell[CellGroupData[{

Cell["13.1. Strong and weak versions", "Subsection",ExpressionUUID->"a9b5a5e7-5d20-1846-a7e8-aab4c313e9a5"],

Cell["A weak version: ", "Text",ExpressionUUID->"4157f6e6-8a89-3f49-804b-7efb6fb578fa"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"consciousness correlates with systems that model aspects of \
their own state recursively.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"cbc033bd-e6e1-064e-bd7c-f0fce5695fff"],

Cell["A stronger ontological version: ", "Text",ExpressionUUID->"4ece8e21-f16e-664e-b22e-197bfe2d9cc8"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"consciousness is the interior aspect of recursive \
self-measurement under sufficient closure, memory, and integration.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
