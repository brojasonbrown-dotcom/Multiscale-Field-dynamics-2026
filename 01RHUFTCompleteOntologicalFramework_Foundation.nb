Cell[CellGroupData[{

Cell["4. Formal state space", "Section",ExpressionUUID->"23236fc5-8bc0-2e46-9f83-4b1a7532871a"],

Cell[CellGroupData[{

Cell["4.1. Why a state space is required", "Subsection",ExpressionUUID->"23f2e76b-7d54-6941-9bef-4769778c4b3a"],

Cell["\<\
To make the framework computationally meaningful, the field must be \
represented by explicit state variables. \
\>", "Text",ExpressionUUID->"583707d4-054f-c94c-92ab-408921107a3d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2. Candidate state tuple", "Subsection",ExpressionUUID->"8d4676fa-58f7-024c-86b8-693f1be38f25"],

Cell[TextData[{
 "Let the field state at scale index ",
 StyleBox["n", "TI"],
 " and update index ",
 StyleBox["t", "TI"],
 " be: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalPsi]", 
          StyleBox["n", "TI"], 
          StyleBox["t", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[Rho]", 
               StyleBox["I", "TI"]], ",", 
              StyleBox["c", "TI"], ",", "\[CurlyPhi]", ",", 
              StyleBox["d", "TI"], ",", "\[Kappa]", ",", 
              StyleBox["g", "TI"], ",", 
              StyleBox["m", "TI"], ",", 
              StyleBox["r", "TI"]}], ")"}], 
          StyleBox["n", "TI"], 
          StyleBox["t", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Psi_n^t = (\\rho_I, c, \\varphi, d, \\kappa, g, m, r)_n^t", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "730973c4-c9e1-c642-b91c-a92e5be22d62"],
 "where: "
}], "Text",ExpressionUUID->"331db7e0-4a59-5a44-8cc9-e97fe90f282d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Rho]", 
        StyleBox["I", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho_I", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f98f7671-ffe3-924d-8881-07c0975ca89a"],
 " = information density,"
}], "Item",ExpressionUUID->"45f79dc0-89ad-cf4a-9999-9eb4a19bf38e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["c", "TI"], TraditionalForm], "errors" -> {}, "input" -> "c", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "292d243a-3328-0049-ba36-6577cca9c005"],
 " = coherence,"
}], "Item",ExpressionUUID->"2f769b97-28e0-6f41-a7bb-1a609570aa9f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CurlyPhi]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\varphi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b62167ce-a0b7-1a43-9b4c-a7ebc1d999ed"],
 " = phase/alignment,"
}], "Item",ExpressionUUID->"8147df7f-2269-2f4c-ad50-18455ac827dd"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["d", "TI"], TraditionalForm], "errors" -> {}, "input" -> "d", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e6ab34b9-79e1-5347-bbca-45cf9acf4896"],
 " = drift from an attractor,"
}], "Item",ExpressionUUID->"9e8757b2-3352-f340-b676-c0da195d3580"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Kappa]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\kappa", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f2779ca5-9fad-184b-82da-564670f8531f"],
 " = closure score,"
}], "Item",ExpressionUUID->"13658577-b76a-de47-ae54-5c6714bc70fd"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "394da38c-d871-0f49-9e61-79c86562dd79"],
 " = geometry class,"
}], "Item",ExpressionUUID->"3e7cf7bf-0e42-6d4b-9a8d-91861fb1323f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["m", "TI"], TraditionalForm], "errors" -> {}, "input" -> "m", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7a51ceb7-662f-2840-b1b7-2bf11d482653"],
 " = memory trace,"
}], "Item",ExpressionUUID->"e9bd77c1-53a4-fb49-ad33-617375a03da0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["r", "TI"], TraditionalForm], "errors" -> {}, "input" -> "r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "73140434-6f28-c640-86f5-ddc87775cbce"],
 " = observational resolution."
}], "Item",ExpressionUUID->"705c699f-d2bf-9940-9566-27d498989b86"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.3. Wolfram Language representation", "Subsection",ExpressionUUID->"0872e7da-8625-784b-869e-824f6654ffe0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "fieldState", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fieldState", "[", 
    RowBox[{
    "informationDensity_", ",", "coherence_", ",", "phase_", ",", "drift_", ",",
      "closure_", ",", "\[IndentingNewLine]", "   ", "geometry_", ",", 
     "memory_", ",", "resolution_"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<InformationDensity\>\"", "->", "informationDensity"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Coherence\>\"", "->", "coherence"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Phase\>\"", "->", "phase"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<Drift\>\"", "->", "drift"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<Closure\>\"", "->", "closure"}], ",", "\[IndentingNewLine]",
      "  ", 
     RowBox[{"\"\<Geometry\>\"", "->", "geometry"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Memory\>\"", "->", "memory"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<Resolution\>\"", "->", "resolution"}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",ExpressionUUID->\
"0b2bde38-7622-6343-a72c-5483e1058ed0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.4. State admissibility", "Subsection",ExpressionUUID->"c63ca40e-a88f-c845-8ffb-ba71c06ea34f"],

Cell["A valid state must satisfy domain conditions. For example: ", "CodeText",ExpressionUUID->"0ee6c3cd-f461-5a47-b411-ed6417b79fcf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "admissibleStateQ", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"admissibleStateQ", "[", "state_Association", "]"}], ":=", 
   RowBox[{"And", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"KeyExistsQ", "[", 
      RowBox[{"state", ",", "\"\<InformationDensity\>\""}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"KeyExistsQ", "[", 
      RowBox[{"state", ",", "\"\<Coherence\>\""}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"KeyExistsQ", "[", 
      RowBox[{"state", ",", "\"\<Phase\>\""}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"KeyExistsQ", "[", 
      RowBox[{"state", ",", "\"\<Drift\>\""}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"KeyExistsQ", "[", 
      RowBox[{"state", ",", "\"\<Closure\>\""}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"KeyExistsQ", "[", 
      RowBox[{"state", ",", "\"\<Geometry\>\""}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"KeyExistsQ", "[", 
      RowBox[{"state", ",", "\"\<Memory\>\""}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"KeyExistsQ", "[", 
      RowBox[{"state", ",", "\"\<Resolution\>\""}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"NumericQ", "[", 
      RowBox[{"state", "[", "\"\<InformationDensity\>\"", "]"}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"NumericQ", "[", 
      RowBox[{"state", "[", "\"\<Coherence\>\"", "]"}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"NumericQ", "[", 
      RowBox[{"state", "[", "\"\<Phase\>\"", "]"}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"NumericQ", "[", 
      RowBox[{"state", "[", "\"\<Drift\>\"", "]"}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"NumericQ", "[", 
      RowBox[{"state", "[", "\"\<Closure\>\"", "]"}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"NumericQ", "[", 
      RowBox[{"state", "[", "\"\<Resolution\>\"", "]"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"4176dd4a-8696-334c-8930-4498d2dcaea7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.5. Interpretation", "Subsection",ExpressionUUID->"eefc5c94-6f9b-3941-99ed-4cc2d229adc8"],

Cell["\<\
This state space is not yet standard quantum mechanics, general relativity, \
or neuroscience. It is a proposed ontological state space whose relation to \
those theories must be established by mappings. \
\>", "Text",ExpressionUUID->"190c6b28-6ff6-7c42-b98e-ac1bbb51408a"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"3a4e053e-3719-1244-baf8-7a235b402503"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Measurement operator algebra", "Section",ExpressionUUID->"bcf4c569-1bd1-274c-ab5b-9ec072aa4b1c"],

Cell[CellGroupData[{

Cell["5.1. General idea", "Subsection",ExpressionUUID->"9bac7a55-4fd6-a24a-a77a-7be671a4f924"],

Cell["\<\
Measurement is generalized from laboratory intervention to recursive state \
discrimination. \
\>", "Text",ExpressionUUID->"6e1325c2-e38c-4042-8bff-bebb137b5029"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.2. Operator chain", "Subsection",ExpressionUUID->"1c1fc129-d58c-734d-a870-05db39b6278a"],

Cell[TextData[{
 "A useful proposal is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["U", "TI"], 
          StyleBox["n", "TI"]], "\[EmptySmallCircle]", 
         SubscriptBox[
          StyleBox["S", "TI"], 
          StyleBox["n", "TI"]], "\[EmptySmallCircle]", 
         SubscriptBox[
          StyleBox["Q", "TI"], 
          StyleBox["n", "TI"]], "\[EmptySmallCircle]", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["n", "TI"]], "\[EmptySmallCircle]", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "M_n = U_n \\circ S_n \\circ Q_n \\circ R_n \\circ P_n", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cb635de9-afa4-7543-8984-6f0bca67ee4b"],
 "where: "
}], "Text",ExpressionUUID->"84fbb2ef-3d1b-af4e-853d-7be8291e9d83"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "P_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3cf14a5-4c06-4e49-be84-7ce784b91bc0"],
 " = projection/selective access at scale ",
 StyleBox["n", "TI"],
 ","
}], "Item",ExpressionUUID->"2e92d067-def8-ac4d-b75a-cebced7020c6"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "R_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0508891-b202-d940-a42a-536567bbe68f"],
 " = relational comparison,"
}], "Item",ExpressionUUID->"3bc27873-db54-094e-8e2f-db0ae7beb66e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Q", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "Q_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cb93495e-a7b5-1542-9d06-12600a69daea"],
 " = quality or coherence weighting,"
}], "Item",ExpressionUUID->"25829aea-751c-624f-8189-f6ec76309546"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["S", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "S_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2e33c12b-f795-a04d-b71f-bf35977b4367"],
 " = stabilization operator,"
}], "Item",ExpressionUUID->"2db9f067-c66b-324a-84cb-ca7422b7e960"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["U", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "U_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a18cd07d-a7e4-9b41-994f-be529dda54b8"],
 " = update or memory incorporation."
}], "Item",ExpressionUUID->"8039a522-5751-6a4f-a18c-a5c7aef5e457"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.3. Wolfram Language skeleton", "Subsection",ExpressionUUID->"7ba5193a-a4cf-914c-8cba-9efb9a286d9d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "projectionOp", ",", "relationOp", ",", "qualityOp", ",", 
     "stabilizationOp", ",", "updateOp", ",", "\[IndentingNewLine]", "  ", 
     "measurementOp"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"projectionOp", "[", 
     RowBox[{"state_", ",", "scale_"}], "]"}], ":=", 
    RowBox[{"Append", "[", 
     RowBox[{"state", ",", 
      RowBox[{"\"\<ProjectedScale\>\"", "->", "scale"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"relationOp", "[", "state_", "]"}], ":=", 
    RowBox[{"Append", "[", 
     RowBox[{"state", ",", 
      RowBox[{"\"\<RelationalScore\>\"", "->", "\[IndentingNewLine]", "   ", 
       RowBox[{
        RowBox[{"state", "[", "\"\<InformationDensity\>\"", "]"}], " ", 
        RowBox[{"state", "[", "\"\<Coherence\>\"", "]"}]}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qualityOp", "[", "state_", "]"}], ":=", 
    RowBox[{"Append", "[", 
     RowBox[{"state", ",", 
      RowBox[{"\"\<QualityScore\>\"", "->", "\[IndentingNewLine]", "   ", 
       RowBox[{
        RowBox[{"state", "[", "\"\<Closure\>\"", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"state", "[", "\"\<Drift\>\"", "]"}]}], ")"}]}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stabilizationOp", "[", "state_", "]"}], ":=", 
    RowBox[{"Append", "[", 
     RowBox[{"state", ",", 
      RowBox[{"\"\<StabilizedQ\>\"", "->", "\[IndentingNewLine]", "   ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"state", "[", "\"\<Closure\>\"", "]"}], ">", "1"}], "&&", 
         RowBox[{
          RowBox[{"state", "[", "\"\<Drift\>\"", "]"}], "<", 
          RowBox[{"1", "/", 
           RowBox[{"state", "[", "\"\<Coherence\>\"", "]"}]}]}]}], ")"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"updateOp", "[", "state_", "]"}], ":=", 
    RowBox[{"Append", "[", 
     RowBox[{"state", ",", 
      RowBox[{"\"\<UpdatedMemory\>\"", "->", "\[IndentingNewLine]", "   ", 
       RowBox[{
        RowBox[{"state", "[", "\"\<Memory\>\"", "]"}], "+", 
        RowBox[{
         RowBox[{"state", "[", "\"\<Closure\>\"", "]"}], " ", 
         RowBox[{"state", "[", "\"\<Coherence\>\"", "]"}]}]}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementOp", "[", 
    RowBox[{"state_", ",", "scale_"}], "]"}], ":=", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{
    RowBox[{"RightComposition", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"projectionOp", "[", 
        RowBox[{"#", ",", "scale"}], "]"}], " ", "&"}], ",", 
      "\[IndentingNewLine]", "    ", "relationOp", ",", "\[IndentingNewLine]",
       "    ", "qualityOp", ",", "\[IndentingNewLine]", "    ", 
      "stabilizationOp", ",", "\[IndentingNewLine]", "    ", "updateOp"}], 
     "\[IndentingNewLine]", "  ", "]"}], "[", "state", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"8fbfe428-fd1b-5b45-ac17-0e3a3b36a212"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.4. Why operator algebra matters", "Subsection",ExpressionUUID->"98afd0da-8f5a-0e41-81ee-943e4097cf5f"],

Cell["\<\
If measurement is fundamental, then physics becomes not merely the evolution \
of states, but the evolution of states under recursive discrimination and \
stabilization.\
\>", "Text",ExpressionUUID->"47fbf85f-d317-b74f-9130-7bab146e861c"],

Cell["\<\
This is a major reinterpretation and should be treated as a hypothesis to be \
formalized carefully. \
\>", "Text",ExpressionUUID->"cdc8cc31-f12d-5748-a3c9-97e1f238740f"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"7f87d9e9-d197-544c-9d4c-92f3b5565ff8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Scale stabilization law", "Section",ExpressionUUID->"289df7fd-5ce0-974e-8e3a-2e88eb503c62"],

Cell[CellGroupData[{

Cell["6.1. Motivating principle", "Subsection",ExpressionUUID->"422978fb-a846-df4a-bb2b-d60e9ed0bfb6"],

Cell["\<\
A structure is real at a scale if it remains recursively distinguishable and \
dynamically persistent when interrogated at that scale. \
\>", "Text",ExpressionUUID->"a60352db-d832-0f4a-8263-54f8758cc0fb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.2. Generic criterion", "Subsection",ExpressionUUID->"d75b4fe0-b3a9-f244-a726-a7c6fa0045e5"],

Cell[TextData[{
 "A candidate realization rule is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Realized", FontSlant -> "Plain"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", "\[CapitalPsi]", ")"}], " ", 
         "\[DoubleLongLeftRightArrow] ", "\[Kappa]", 
         RowBox[{"(", "\[CapitalPsi]", ")"}], ">", 
         SubscriptBox["\[Kappa]", 
          StyleBox["c", "TI"]], " ", "\[Wedge] ", 
         StyleBox["d", "TI"], 
         RowBox[{"(", "\[CapitalPsi]", ")"}], "<", 
         SubscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["c", "TI"]], " ", "\[Wedge] ", 
         StyleBox["c", "TI"], 
         RowBox[{"(", "\[CapitalPsi]", ")"}], ">", 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["c", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{Realized}_n(\\Psi) \\iff \\kappa(\\Psi) > \\kappa_c \\; \
\\wedge \\; d(\\Psi) < d_c \\; \\wedge \\; c(\\Psi) > c_c", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d059ba65-fde2-a14b-b051-f718f26c146a"]
}], "Text",ExpressionUUID->"99ce5b23-10a8-764b-a967-91f4afd560e7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.3. Wolfram Language implementation", "Subsection",ExpressionUUID->"dae4013f-d169-cb42-a8e9-0faa9539e4f0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "realizedAtScaleQ", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"realizedAtScaleQ", "[", 
    RowBox[{
    "state_", ",", "closureThreshold_", ",", "driftThreshold_", ",", 
     "coherenceThreshold_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"state", "[", "\"\<Closure\>\"", "]"}], ">", 
     "closureThreshold"}], "&&", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"state", "[", "\"\<Drift\>\"", "]"}], "<", "driftThreshold"}], "&&",
     "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"state", "[", "\"\<Coherence\>\"", "]"}], ">", 
     "coherenceThreshold"}]}]}], ";"}]}], "Input",ExpressionUUID->"97e95736-\
4ee3-0a42-bb4d-59411fbb301f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.4. Scale-locking", "Subsection",ExpressionUUID->"fbe274bd-b7d2-d148-a5c0-a10beda78b34"],

Cell["\<\
A sense, instrument, or theory accesses only those structures whose stability \
exceeds threshold at its operating resolution.\
\>", "Text",ExpressionUUID->"f798bb34-9b9d-0043-8315-c39feeef1f69"],

Cell["\<\
This idea will later support the interpretation of senses as scale-specific \
measurement channels. \
\>", "Text",ExpressionUUID->"d21cd6fd-20c5-164f-85d1-e5abc14d2f74"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"6bf52ba7-7261-904a-a6df-b2aed360a6ee"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Geometry of closure", "Section",ExpressionUUID->"1d0157e1-c8b7-fc4c-abd7-f79d0fc9e53d"],

Cell[CellGroupData[{

Cell["7.1. Why geometry enters ontology", "Subsection",ExpressionUUID->"604ca374-3d0a-c74e-87ad-8400df82fca2"],

Cell["\<\
If persistent structure requires closure, then geometry is not ornamental. It \
becomes one of the forms by which stability is achieved. \
\>", "Text",ExpressionUUID->"4b27e9bf-91e3-c846-8c51-eb230011b1b9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2. Minimal closure motifs", "Subsection",ExpressionUUID->"daa964fc-fbbd-bb46-bdd8-c3407fb49862"],

Cell["Candidate motifs include: ", "Text",ExpressionUUID->"61dd5d31-98ce-a746-9537-9e2f13076476"],

Cell["pair or dipole,", "Item",ExpressionUUID->"8b2a2657-ecd9-6a41-9389-14018d3e73c8"],

Cell["triangle,", "Item",ExpressionUUID->"094f0acc-c1ec-c24b-8775-e41cc6a591a4"],

Cell["loop,", "Item",ExpressionUUID->"0f816e25-1e92-fd4e-94e4-a0de11f6358a"],

Cell["sphere,", "Item",ExpressionUUID->"4cfc0dfd-177c-be41-b285-c381d999b6ce"],

Cell["torus,", "Item",ExpressionUUID->"c7a4d0fe-5bf2-9e48-87bc-5ef13215ff52"],

Cell["nested toroidal recursions,", "Item",ExpressionUUID->"d2200ad0-76a0-564b-8ec7-a4569049da30"],

Cell["graph cycles,", "Item",ExpressionUUID->"6cc0aff4-85cd-5944-a4d7-0cd23d393a78"],

Cell["recurrent attractor manifolds.", "Item",ExpressionUUID->"60d6180e-5dfc-f946-89b2-b8610cd63076"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.3. Dipole as first nontrivial distinction", "Subsection",ExpressionUUID->"0e6b480e-3ebf-9c46-ae93-97ff0c96b13f"],

Cell["\<\
A dipole may be interpreted as the smallest persistent polarity structure: a \
relation with contrast, direction, tension, and return. \
\>", "Text",ExpressionUUID->"624739b5-83a1-7144-b67d-d1361541b8b1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.4. Triangle as minimal stable relational area", "Subsection",ExpressionUUID->"12fe044c-2247-3140-811f-39019a218489"],

Cell["\<\
Triangles are special because they are the smallest rigid relational \
enclosure in Euclidean geometry. If field nodes form local surface tension \
networks, triangulation becomes a natural stabilization mechanism. \
\>", "Text",ExpressionUUID->"2ad603f0-8d75-7844-9f41-5484c906d6b2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.5. Toroidal closure", "Subsection",ExpressionUUID->"1e7589df-f6b2-6c49-9822-87b4246184cb"],

Cell["A torus supports: ", "Text",ExpressionUUID->"10b60ff3-2419-d149-b4bd-31ed5bbb21dc"],

Cell["circulation,", "Item",ExpressionUUID->"d438fe86-3890-f242-a0ca-c06e21494598"],

Cell["recurrence,", "Item",ExpressionUUID->"3eabb777-187d-144e-bcc2-49136133c553"],

Cell["interior/exterior distinction,", "Item",ExpressionUUID->"18624f61-ab31-a343-a11c-301b65a66fa8"],

Cell["self-returning flow.", "Item",ExpressionUUID->"8d774a84-504c-a14a-bc4e-452a767fffee"],

Cell["\<\
This makes it a plausible canonical geometry for recursive maintenance. \
\>", "Text",ExpressionUUID->"4659e702-be97-3b44-a0c6-45977c298ebc"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"7cd4d336-07be-6641-ac06-19b669b2c3bf"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Golden, silver, and irrational spacing principles", "Section",ExpressionUUID->"8357f93e-7007-b44e-a9de-dd6c44faadb0"],

Cell[CellGroupData[{

Cell["8.1. Why irrational spacing matters", "Subsection",ExpressionUUID->"eea51489-919b-324a-8568-f5784fe8b4f2"],

Cell["\<\
Irrational angular increments minimize repetitive overlap and can produce \
highly uniform recursive distributions. \
\>", "Text",ExpressionUUID->"36a12588-6fba-a347-8771-1b39557c7e43"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.2. Golden ratio and angle", "Subsection",ExpressionUUID->"f35d626a-b44b-6c4a-8168-8fc727a257c6"],

Cell[TextData[{
 "The golden ratio is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Phi]", "\[LongEqual]", 
         FractionBox[
          RowBox[{"1", "+", 
            SqrtBox["5"]}], "2"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi = \\frac{1 + \\sqrt{5}}{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9bfe482c-e316-f44e-8339-6c0ab85074aa"],
 "The golden angle is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Theta]", 
          StyleBox["g", "TI"]], "\[LongEqual]", "2", "\[Pi]", 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             FractionBox["1", "\[Phi]"]}], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"2", "\[Pi]"}], 
          SuperscriptBox["\[Phi]", "2"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\theta_g = 2\\pi\\left(1 - \\frac{1}{\\phi}\\right) = \
\\frac{2\\pi}{\\phi^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b2a9705c-544b-7743-bc27-cb0910318f17"]
}], "Text",ExpressionUUID->"365a7d3c-bb64-a340-a735-1bb5b8614ba6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.3. Silver ratio", "Subsection",ExpressionUUID->"9f7c385a-3954-0040-9ea5-50afc7bb922d"],

Cell[TextData[{
 "The silver ratio is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]", 
          StyleBox["S", "TI"]], "\[LongEqual]", "1", "+", 
         SqrtBox["2"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta_S = 1 + \\sqrt{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f56e5891-b359-b240-a28e-83362aff3bdf"]
}], "Text",ExpressionUUID->"129c47fa-8520-da40-aa8d-7acbff176550"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.4. Interpretive role", "Subsection",ExpressionUUID->"7d5b8f88-f22d-454f-98bc-348c84e06c81"],

Cell["\<\
These constants should not be imposed dogmatically on all physics. Their \
strongest role is as candidate principles for: \
\>", "Text",ExpressionUUID->"1587e0fa-4e52-d44e-8814-7d7c72ae5a90"],

Cell["balanced recursive packing,", "Item",ExpressionUUID->"09a1389a-9ad6-0540-9d1f-44eb459acb97"],

Cell["quasiperiodic order,", "Item",ExpressionUUID->"414ffb26-37eb-ad44-8d7b-d2afb1470802"],

Cell["spherical node distribution,", "Item",ExpressionUUID->"5f821c7b-3b21-9c41-83fe-aef23c38e499"],

Cell["multiscale spacing that avoids simple resonance collapse.", "Item",ExpressionUUID->"4100632e-2dea-db43-9fec-df9b8ea1a335"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.5. Wolfram Language constants", "Subsection",ExpressionUUID->"dbed830e-9282-a84f-bbc4-969971f713fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"goldenRatio", "=", "GoldenRatio"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"silverRatio", "=", 
   RowBox[{"1", "+", 
    RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"goldenAngle", "=", 
   RowBox[{"2", " ", "Pi", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"1", "/", "goldenRatio"}]}], ")"}]}]}], ";"}]}], "Input",Express\
ionUUID->"8d2c0950-8fc9-314c-bb99-71cdbffe2930"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.6. Spherical balanced spacing", "Subsection",ExpressionUUID->"9e87a12e-4da6-9349-96f3-ce2dd43c552e"],

Cell["\<\
A phyllotactic sphere construction gives nearly uniform node placement: \
\>", "CodeText",ExpressionUUID->"9d66f1af-c0f1-d341-8162-db17ab609173"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "sphericalGoldenNodes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sphericalGoldenNodes", "[", 
    RowBox[{"nodeCount_Integer", "?", "Positive"}], "]"}], ":=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"With", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"z", "=", 
          RowBox[{"1", "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "n"}], "-", "1"}], ")"}], "/", 
            "nodeCount"}]}]}], ",", "\[IndentingNewLine]", "      ", 
         RowBox[{"azimuth", "=", 
          RowBox[{"n", " ", "goldenAngle"}]}]}], "\[IndentingNewLine]", 
        "    ", "}"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rad", "=", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", "-", 
             RowBox[{"z", "^", "2"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"rad", " ", 
            RowBox[{"Cos", "[", "azimuth", "]"}]}], ",", 
           RowBox[{"rad", " ", 
            RowBox[{"Sin", "[", "azimuth", "]"}]}], ",", "z"}], "}"}]}], 
        "]"}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "nodeCount"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"2a33bb4d-1002-994f-8547-a36f7867912b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.7. Interpretation warning", "Subsection",ExpressionUUID->"c29d93cf-ec24-d34b-b261-bb50a8452534"],

Cell[TextData[{
 "The usefulness of golden-angle spacing in geometry does ",
 StyleBox["not",
  FontWeight->Bold],
 " by itself prove that all fundamental physics is golden-ratio governed. \
Mathematical convenience and physical law must be distinguished. "
}], "Text",ExpressionUUID->"f62c1856-229d-c94e-864c-2a2da79eee13"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"f3b28cb1-cdc2-1341-813b-deefa1a56b62"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Toroidal recursion and circulation", "Section",ExpressionUUID->"2a76b75d-4e9d-6041-b7ec-63e216e27eb5"],

Cell[CellGroupData[{

Cell["9.1. Recurrence as self-maintenance", "Subsection",ExpressionUUID->"0b08ab1a-8e92-1b4d-b7bd-6bd106801c42"],

Cell["\<\
Any persistent system must in some sense feed forward and feed back into \
itself. \
\>", "Text",ExpressionUUID->"8c4739ea-aa99-3841-b232-de46b99540e8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.2. Why toroidal models recur", "Subsection",ExpressionUUID->"28e56b2d-da44-7343-999c-14abe48cf09b"],

Cell["Toroidal forms naturally encode: ", "Text",ExpressionUUID->"bcbe7499-c184-6745-80e6-5a9afd149220"],

Cell["closed-loop flow,", "Item",ExpressionUUID->"9a7b82b5-639a-114b-bcf9-f742e4289483"],

Cell["central exclusion region,", "Item",ExpressionUUID->"4550ee4f-7c4a-ed43-8625-ac8f5341ec88"],

Cell["circulation without trivial collapse,", "Item",ExpressionUUID->"256e5926-04df-f545-9d25-e6a0dc99f85f"],

Cell["periodic return.", "Item",ExpressionUUID->"2c8d2968-fe4c-b649-847b-60c87d2e15f8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.3. Ontological relevance", "Subsection",ExpressionUUID->"2bfbe96d-8a4a-1e4c-8192-0c79731a7a67"],

Cell["\<\
If the field sustains itself through recursive self-measurement, toroidal \
circulation may function as a geometric image of closure-maintenance. \
\>", "Text",ExpressionUUID->"3d143dce-7407-514d-ae98-dd85bcc0611f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.4. Mathematical caution", "Subsection",ExpressionUUID->"76707d26-cf19-284f-a87b-7c5a3d4429cd"],

Cell["\<\
Torus-like structure is suggestive and useful, but cannot be declared \
universal without derivation from equations or data. \
\>", "Text",ExpressionUUID->"f96b2561-40f5-ff4d-b4fe-458449059be3"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"1a0e6b02-99e6-cf42-ae11-e07f8debd55f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Constants as closure invariants", "Section",ExpressionUUID->"aececcdc-c6dd-5a48-b32e-844afb2831a1"],

Cell[CellGroupData[{

Cell["10.1. Guiding idea", "Subsection",ExpressionUUID->"7c71b0d1-f1ba-2b4f-99a5-a9af6fc59ff6"],

Cell["\<\
Rather than treating constants as arbitrary insertions, the framework \
proposes that some constants may encode stable closure ratios or recurrence \
constraints. \
\>", "Text",ExpressionUUID->"33e8b302-b99c-984e-80ba-d5a8591edf82"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.2. Examples of interpretive candidates", "Subsection",ExpressionUUID->"1570b900-ce4d-564e-b145-9a17916f1655"],

Cell["geometric ratios such as the golden ratio,", "Item",ExpressionUUID->"80a4b08a-56da-f848-b449-0de1c2b34cdc"],

Cell["dimensionless constants such as the fine-structure constant,", "Item",ExpressionUUID->"db77946a-0420-c647-a541-1cace61254c1"],

Cell["\<\
scaling thresholds separating stable from unstable recursion.\
\>", "Item",ExpressionUUID->"cf1b3ec5-9abc-b041-b59f-0c95acc68cac"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.3. Warning on overreach", "Subsection",ExpressionUUID->"7415bf7a-6927-5d4a-a5a5-57959b252f17"],

Cell["\<\
One must not simply identify a numerically interesting constant with a \
preferred ontology. Any such identification requires derivation. \
\>", "Text",ExpressionUUID->"436cd3cf-7a9d-8d4f-812c-fe0b4da1ec46"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.4. Productive research program", "Subsection",ExpressionUUID->"0651f0f1-0b96-1642-a6d2-a60f6049fc07"],

Cell["A defensible goal is: ", "Text",ExpressionUUID->"d3ff90a8-aecd-ff4b-8479-1057933994d5"],

Cell["derive candidate invariants from closure equations,", "Item",ExpressionUUID->"1b8536fb-7142-0042-9038-483d995cde8c"],

Cell["compare against measured constants,", "Item",ExpressionUUID->"5c98d253-6d2d-ea48-9696-600b1fb91d6d"],

Cell["evaluate fit quality,", "Item",ExpressionUUID->"36c6dcf6-ce50-5146-9ec8-ecf7d5515895"],

Cell["reject unsupported numerical mythology.", "Item",ExpressionUUID->"60bf47b2-4d05-5b42-a02d-71302240e958"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
