Cell[CellGroupData[{

Cell["17. Initial formal pipeline", "Section",ExpressionUUID->"849bb77c-0303-8343-9ebb-7965f97735b7"],

Cell["\<\
A minimal computational scaffold for further development is: \
\>", "CodeText",ExpressionUUID->"35ae7b24-215e-d546-b636-b5ca9e05c113"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "opfPipeline", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"opfPipeline", "[", 
    RowBox[{
    "state_", ",", "scale_", ",", "closureThreshold_", ",", "driftThreshold_",
      ",", "coherenceThreshold_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"measurementOp", "[", 
     RowBox[{"state", ",", "scale"}], "]"}], " ", "//", " ", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{"Function", "[", 
     RowBox[{"s", ",", 
      RowBox[{"Append", "[", 
       RowBox[{"s", ",", 
        RowBox[{"\"\<RealizedQ\>\"", "->", "\[IndentingNewLine]", "      ", 
         RowBox[{"realizedAtScaleQ", "[", 
          RowBox[{
          "s", ",", "closureThreshold", ",", "driftThreshold", ",", 
           "coherenceThreshold"}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  ";"}]}], "Input",ExpressionUUID->"41b87f29-dd44-ae47-ad72-109cabc227fb"],

Cell["\<\
This is only a skeleton, but it shows how the framework can be evolved into \
an executable model. \
\>", "Text",ExpressionUUID->"3528afa1-6608-a248-9dbe-e56a90b38092"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
