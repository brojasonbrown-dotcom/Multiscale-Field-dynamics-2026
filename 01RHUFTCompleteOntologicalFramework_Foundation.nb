Cell[CellGroupData[{

Cell["19. Provisional conclusion", "Section",ExpressionUUID->"51fe1137-97c1-c242-9eed-899bb6e7cbf5"],

Cell["\<\
This notebook establishes the first rigorous foundation of the RHUFT \
ontological program in numbered form.\
\>", "Text",ExpressionUUID->"afadb7f0-76d0-e243-897e-1a2634bee6b7"],

Cell["\<\
Its main achievement is not to prove the whole framework, but to make it \
discussable with precision by separating: \
\>", "Text",ExpressionUUID->"a66840cf-8afc-f448-bf3f-78776f55e6ec"],

