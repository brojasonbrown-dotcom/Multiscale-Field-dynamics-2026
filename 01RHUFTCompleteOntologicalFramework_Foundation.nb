Cell[CellGroupData[{

Cell["12. Emergence of senses as scale-locked measurement", "Section",ExpressionUUID->"3d06cc99-d948-3e46-8ac8-79337e21a8b4"],

Cell[CellGroupData[{

Cell["12.1. Central proposal", "Subsection",ExpressionUUID->"d8a18a89-6983-fe45-8a66-e54dc2d49eee"],

Cell["\<\
Biological senses are not arbitrary. They are specialized measurement \
interfaces tuned to ranges where the organism can maintain useful stability. \
\>", "Text",ExpressionUUID->"26303099-54cc-e14e-8cdb-d00ccd390603"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.2. Examples", "Subsection",ExpressionUUID->"edcd26ba-cf59-d141-a535-ec67b7d4fdae"],

Cell["eyes: tuned to a narrow electromagnetic band,", "Item",ExpressionUUID->"f5be0c34-9151-a44f-8819-546a0966e69c"],

Cell["ears: tuned to a pressure-wave frequency range,", "Item",ExpressionUUID->"159581a0-af54-0542-8938-cfd1fb92c148"],

Cell["touch: tuned to macro contact and deformation,", "Item",ExpressionUUID->"06d03833-e468-3148-893b-455ec2c4dd26"],

Cell["smell and taste: tuned to molecular interaction classes,", "Item",ExpressionUUID->"546b7d39-9645-794a-9fb8-803b17d8babd"],

Cell["proprioception: tuned to body-state geometry.", "Item",ExpressionUUID->"d7956ab3-cf1d-744d-a890-349269261a8e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.3. Formal statement", "Subsection",ExpressionUUID->"425c0b54-2b23-1144-9ffe-f00a64cfc270"],

Cell[TextData[{
 "A sense channel may be written as a scale-selective measurement map: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalSigma]", 
          StyleBox["i", "TI"]], ":", 
         SubscriptBox[
          StyleBox["L", "TI"], "2"], "\[Rule]", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Sigma_i : \\mathcal{L}_2 \\to \\mathcal{I}_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "062a1f24-afb0-4144-b91f-48efc500716a"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["I", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{I}_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b7eae75e-cef2-e044-9af6-25918547aa22"],
 " is the internal information space of the sensing modality. "
}], "Text",ExpressionUUID->"87331a4c-84bf-1641-aeb4-552c636feb15"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.4. Consequence", "Subsection",ExpressionUUID->"31523c0b-6085-f749-b871-12aed586cea9"],

Cell["\<\
Reality as lived is filtered reality, not exhaustive reality. Organisms \
inherit ontological access through scale-locked stabilizing interfaces. \
\>", "Text",ExpressionUUID->"8d219323-7ae4-004b-9dab-0d4d7c445756"],

