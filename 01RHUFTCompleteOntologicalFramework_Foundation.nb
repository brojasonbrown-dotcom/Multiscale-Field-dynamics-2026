}, Open  ]],

Cell[CellGroupData[{

Cell["15. Predictions and falsifiability conditions", "Section",ExpressionUUID->"9487bfb0-ff98-734b-85cb-c9e9adea244d"],

Cell["A framework becomes science only where it risks failure. ", "Text",ExpressionUUID->"4b7b0d38-2ae6-e947-ba40-f62d0efc07a2"],

Cell[CellGroupData[{

Cell["15.1. Candidate prediction classes", "Subsection",ExpressionUUID->"c0f5a3be-e425-5940-a0b0-c969ed58dd0f"],

Cell["\<\
1. preferred node-spacing statistics in naturally stable field configurations,\
\>", "Text",ExpressionUUID->"a74dfaa0-8e1b-2d48-bf14-ca2c4ab31c1e"],

Cell["2. closure-derived scaling laws absent from standard theory,", "Text",ExpressionUUID->"50c9a3c5-2455-b547-b6e6-97c1cffa87e0"],

Cell["\<\
3. measurable anisotropies or resonance bands from structured recursive \
geometry,\
\>", "Text",ExpressionUUID->"deaa4df8-73d6-e54b-a4f5-92ff74b9c75d"],

Cell["\<\
4. cross-scale relations among constants derivable from a common closure \
equation,\
\>", "Text",ExpressionUUID->"724aa5de-ee9b-5e48-a7aa-8a13aaf35eb6"],

Cell["\<\
5. new sensor designs exploiting scale-locked coherence regimes. \
\>", "Text",ExpressionUUID->"24a0617b-fb6c-8641-b7f6-60b2175916fe"]
}, Open  ]],

Cell[CellGroupData[{

Cell["15.2. Falsifiability conditions", "Subsection",ExpressionUUID->"bec8ff84-58f9-444f-9076-caa95ec48643"],

Cell["The framework is weakened or falsified if: ", "Text",ExpressionUUID->"71b2d124-3930-af4d-b658-f99e1d774cfc"],

Cell["it cannot derive any nontrivial quantitative prediction,", "Item",ExpressionUUID->"4c6cf6c7-7db5-644a-b90d-b799b515a7f1"],

Cell["closure variables have no operational definitions,", "Item",ExpressionUUID->"5a6ebc51-ae52-644a-96ea-1c145da9881c"],

Cell["all constants are introduced by fit rather than derivation,", "Item",ExpressionUUID->"edb90338-78bb-5942-8586-081e87f7a505"],

Cell["it explains every possible result equally well,", "Item",ExpressionUUID->"81bce905-2405-ce41-a5f8-23a46be75503"],

Cell["its reinterpretations never outperform existing theory.", "Item",ExpressionUUID->"fe7de9b0-356d-1242-965b-cd34a16e446c"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
