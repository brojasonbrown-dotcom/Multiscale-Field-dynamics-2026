Cell[CellGroupData[{

Cell[TextData[{
 "01",
 StyleBox["RHUFT",
  FontSlant->Italic],
 "Complete",
 StyleBox["Ontological",
  FontSlant->Italic],
 "Framework_Foundation"
}], "Title",ExpressionUUID->"29840340-b4fa-6241-9d8e-11ce0ccd9062"],

Cell[CellGroupData[{

Cell["Purpose", "Section",ExpressionUUID->"a064a17f-2c30-c94e-b3f9-c9a30c88731d"],

Cell[TextData[{
 "This notebook is ",
 StyleBox["Notebook 1",
  FontWeight->Bold],
 " in a numbered RHUFT series. It is written as a deep, rigorous foundation \
document for a proposed ontological framework centered on recursive \
self-measurement, layered emergence, structured spacetime, closure dynamics, \
and scale-dependent stabilization."
}], "Text",ExpressionUUID->"e3ea180f-9725-c348-a007-c238897f5dd0"],

Cell[TextData[{
 "This notebook does ",
 StyleBox["not",
  FontWeight->Bold],
 " assume that speculative claims are established physical facts. Instead, it \
separates: "
}], "Text",ExpressionUUID->"7bae69f1-0388-3f4a-a1c2-373d795c7088"],

Cell["formal ontology", "Item",ExpressionUUID->"ff8b8195-8794-4c4e-ba2a-f58e984fae98"],

Cell["mathematical proposals", "Item",ExpressionUUID->"cc9ab978-f5c9-5f4a-97fa-8c764fc2767c"],

Cell["physical interpretations", "Item",ExpressionUUID->"2621df7c-ecea-4f4f-bd79-8a2bd559d0e7"],

Cell["phenomenological extensions", "Item",ExpressionUUID->"a0e66cde-53bb-0b4a-abfd-061af0f49e46"],

Cell["empirical status and falsifiability", "Item",ExpressionUUID->"1b880ccf-1703-8a43-a8bb-cb96903578e1"],

Cell["\<\
The goal is to construct the strongest possible version of the framework \
while keeping clear boundaries between:\
\>", "Text",ExpressionUUID->"9fc33022-3680-c841-b5e2-4033e2618494"],

Cell["1. what is axiomatic,", "Text",ExpressionUUID->"8b1ca011-f6d0-124a-b42e-79fdd74bf6fc"],

Cell["2. what is mathematically definable,", "Text",ExpressionUUID->"3c60ff02-3ba2-674f-90d9-0e1601a58751"],

Cell["3. what is physically testable,", "Text",ExpressionUUID->"6ddab1aa-eddb-1743-91fb-4aac99f9e56a"],

Cell["4. what is metaphorical or phenomenological. ", "Text",ExpressionUUID->"9b8ed33f-594a-2645-84e9-9ba191d5ccf7"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"35d4e7fe-228f-ef48-8186-945694a4acb5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Epistemological status", "Section",ExpressionUUID->"da801f94-9b2f-be48-8809-e36b8d186a4a"],

Cell[CellGroupData[{

Cell["1.1. Why begin with epistemology?", "Subsection",ExpressionUUID->"5b16fd23-86b4-064c-8c92-e58b6075d1ae"],

Cell["\<\
Any framework claiming to reinterpret reality through measurement must first \
clarify what kind of claim it is making. Otherwise, ontology, physics, and \
phenomenology become conflated.\
\>", "Text",ExpressionUUID->"d0e8e5b1-5ff5-344f-b882-c98f3b49c694"],

Cell["The present framework proposes that: ", "Text",ExpressionUUID->"3ee98ed9-c395-fa40-812d-28757b80094c"],

Cell["reality is not merely passively observed,", "Item",ExpressionUUID->"bafdc636-2d57-cc48-a437-e279fac5052c"],

Cell["measurement is not only an external laboratory operation,", "Item",ExpressionUUID->"0ebdfb06-330c-9942-8cf6-62634a8f9cc6"],

Cell["\<\
persistent structures may be understood as stabilized outcomes of recursive \
self-discrimination within a lawful field.\
\>", "Item",ExpressionUUID->"04c2243e-330b-9b4f-a30e-30eeb50364d4"],

Cell["\<\
This is a strong claim. To make it rigorous, we distinguish four levels of \
status. \
\>", "Text",ExpressionUUID->"65688d26-ecfd-9c49-934d-93bb2b135d76"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.2. Four levels of status", "Subsection",ExpressionUUID->"414410dd-afa3-5649-8be5-f7a4b862dcbf"],

Cell[CellGroupData[{

Cell["Level A: Formal axioms", "Subsubsection",ExpressionUUID->"c29502eb-c739-974c-8867-357b127bbc82"],

Cell["\<\
These are assumed starting principles. They are not empirical conclusions.\
\>", "Text",ExpressionUUID->"2495ae2f-7856-8d46-bfca-4138a74c69b7"],

Cell["Examples: ", "Text",ExpressionUUID->"bca60c36-c0b9-1e45-95ff-d6fe1eae0378"],

Cell["\<\
unrestricted ontological potential prior to realized distinction,\
\>", "Item",ExpressionUUID->"f43b47be-e63c-754e-b82c-4317f84ef09f"],

Cell["recursive self-measurement as a primitive process,", "Item",ExpressionUUID->"5d906060-4b12-5548-b62a-50cb3ea042ad"],

Cell["persistence through closure and coherence,", "Item",ExpressionUUID->"930859b5-daae-6243-9652-30a2a4aaf024"],

Cell["\<\
scale-locked observation as a constraint on what can appear real.\
\>", "Item",ExpressionUUID->"9b3a4130-7781-ec43-8ea8-de9275a6324e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Level B: Mathematical constructions", "Subsubsection",ExpressionUUID->"7344b60e-68fc-5c4b-b121-7284e3ada9ed"],

Cell["\<\
These are symbolic or geometric models built from the axioms.\
\>", "Text",ExpressionUUID->"b7450016-cda9-2b4c-81b1-3b265046fd2d"],

Cell["Examples: ", "Text",ExpressionUUID->"12cb7a0e-a54b-5846-89c4-a52a5ac7c973"],

Cell["field states represented by tuples,", "Item",ExpressionUUID->"23dc81d3-8ed5-5a42-bb24-5d5f1ebcfaeb"],

Cell["operator compositions,", "Item",ExpressionUUID->"c5f43485-1c4c-aa43-bae0-629d0c7abfcd"],

Cell["closure functionals,", "Item",ExpressionUUID->"1d705ddb-85a2-2444-a279-44fcde47c562"],

Cell["spherical node distributions,", "Item",ExpressionUUID->"825424a4-16ba-f744-8784-f0305f1104ff"],

Cell["toroidal recurrence maps,", "Item",ExpressionUUID->"8ecc962d-7449-764d-8740-670489ca2dce"],

Cell["variational principles.", "Item",ExpressionUUID->"a870d875-a322-3d45-b374-cec1274dc622"],

Cell["\<\
These may be internally valid even if not physically realized. \
\>", "Text",ExpressionUUID->"0345849a-f033-0b4a-8da1-42d64ea835fc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Level C: Physical hypotheses", "Subsubsection",ExpressionUUID->"38e2d45c-ea2d-9d41-9074-e0b6db4365f9"],

Cell["\<\
These are claims that the mathematical structure corresponds to nature.\
\>", "Text",ExpressionUUID->"3fc4a291-f778-df4c-8fa3-63b3ab5d56fb"],

Cell["Examples: ", "Text",ExpressionUUID->"c84dffaa-bbd8-314c-88e7-2163f1b7ff49"],

Cell["spacetime has structured node-density organization,", "Item",ExpressionUUID->"d86e18b0-f5fa-b74c-b183-305078302f15"],

Cell["constants encode closure invariants,", "Item",ExpressionUUID->"ca43d3c2-bad1-ca43-8513-a36c20532349"],

Cell["matter arises as stabilized recursive geometry,", "Item",ExpressionUUID->"306525fa-94b0-7842-a79b-44ccb5974aa5"],

Cell["biological senses are scale-locked measurement channels.", "Item",ExpressionUUID->"9085aa6f-1bfb-e241-a0f4-099e2223a0f7"],

Cell["These require testability. ", "Text",ExpressionUUID->"4929aa69-c769-2c47-87cd-b91c1a5bd8f3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Level D: Phenomenological or metaphysical extensions", "Subsubsection",ExpressionUUID->"f471b3f6-d9f1-e04f-905a-8e6760fd7fd0"],

Cell["These include broad interpretive claims such as: ", "Text",ExpressionUUID->"b753bae4-a88a-e54b-844f-fd3ea83820e5"],

Cell["consciousness as recursive interiority,", "Item",ExpressionUUID->"333a1618-a17f-db4d-93b8-300702ad1652"],

Cell["intuition as weak-signal field integration,", "Item",ExpressionUUID->"34379e28-646c-af42-8313-1320ea96b152"],

Cell["\<\
symbolic or spiritual systems as coarse descriptions of field organization.\
\>", "Item",ExpressionUUID->"9d64df59-8fa1-0c4e-a503-c6ac83e70a8d"],

Cell["\<\
These may be meaningful, but they are not automatically physical theory. \
\>", "Text",ExpressionUUID->"2b802469-8207-9247-ac08-fa46c631ba70"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.3. Core epistemic rule", "Subsection",ExpressionUUID->"45a759b4-0a85-114c-ab79-973bc37f1007"],

Cell["A central rule for this notebook is: ", "Text",ExpressionUUID->"df9edf83-fef5-3245-842d-6ba228be3f71"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"Never present metaphysical possibility as established \
physical fact.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"dbd8a02f-eb9e-d14e-a32a-d44e687b6617"],

Cell["\<\
This rule does not weaken the framework. It improves its precision. \
\>", "Text",ExpressionUUID->"b3c56fca-ae76-244b-af87-5273c7c20fce"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.4. Measurement and reality", "Subsection",ExpressionUUID->"f2a0635e-de80-6443-b69c-b40e6e4543a3"],

Cell["\<\
The phrase \"measured into existence\" must be handled carefully.\
\>", "Text",ExpressionUUID->"0f20b658-6ecd-1d4d-9e7a-2e5ab6c6b0fd"],

Cell["A rigorous interpretation is: ", "Text",ExpressionUUID->"e6b4fd59-b751-ed49-884d-473c306acd57"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"a structure becomes physically real when it achieves \
persistent, recursively stable distinguishability within an interacting \
field.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"0e695989-b5c0-4b45-b48c-8ea00b85b61b"],

Cell["\<\
This avoids the weaker and misleading claim that human observation creates \
the universe. \
\>", "Text",ExpressionUUID->"154cb050-a15a-9241-86bb-cfc9d951c3a8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.5. Scientific posture", "Subsection",ExpressionUUID->"b21a74e6-77eb-674f-85b3-34b7d6c1ef2e"],

Cell["This notebook therefore adopts the following posture: ", "Text",ExpressionUUID->"795ba8f4-d9c6-be44-94c1-d955f0db7036"],

Cell["constructive in ontology,", "Item",ExpressionUUID->"ea432de4-25a9-8a4d-8abe-295a83985f46"],

Cell["explicit in mathematics,", "Item",ExpressionUUID->"20dc2516-8765-0d47-8981-29b15913d2ca"],

Cell["conservative in empirical claims,", "Item",ExpressionUUID->"a0e7f430-847e-0849-995a-8def9984d202"],

Cell["open in phenomenology,", "Item",ExpressionUUID->"f34066ca-5ddb-4e4d-844d-1dfba0f2f87a"],

Cell["strict in separating categories.", "Item",ExpressionUUID->"1381670f-aa0f-d045-b5cd-217111510db0"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"8e24c95d-d4bb-914f-b88c-de52fff67b5f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Primitive ontology", "Section",ExpressionUUID->"23748e24-7b8e-5842-b44b-bd8509f2bf5c"],

Cell[CellGroupData[{

Cell["2.1. Primitive question", "Subsection",ExpressionUUID->"64d97d6b-2889-9d42-8260-e2e90ab7c73a"],

Cell["\<\
What must exist before physics, particles, and observers can exist?\
\>", "Text",ExpressionUUID->"201619cf-a1ec-fd4c-bb0f-72fe398c4e61"],

Cell["\<\
The framework answers with a primitive ontological distinction between: \
\>", "Text",ExpressionUUID->"3470fa74-23f2-e245-8de7-fc9de8f45e9b"],

Cell["unrealized potential,", "Item",ExpressionUUID->"90f16cba-383a-5f49-a92a-33e4c0b51474"],

Cell["self-differentiating field structure,", "Item",ExpressionUUID->"c62286df-314d-1048-81c4-d02b53132704"],

Cell["stabilized measured reality.", "Item",ExpressionUUID->"9bc8bc1c-884c-b242-bb5b-b4db17706caf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2. Ontological primitives", "Subsection",ExpressionUUID->"93502e07-8c8d-fb42-87f1-7d15a1fbccd0"],

Cell["We introduce the following primitive notions: ", "Text",ExpressionUUID->"8b86df6b-4c4f-8742-918e-b96a1a780eac"],

Cell[TextData[{
 StyleBox["potential",
  FontWeight->Bold],
 ": admissibility of distinction before realized form,"
}], "Item",ExpressionUUID->"f0983df7-2f47-4a46-a01b-628bf23a6291"],

Cell[TextData[{
 StyleBox["distinction",
  FontWeight->Bold],
 ": the minimal event of difference,"
}], "Item",ExpressionUUID->"fb4035d5-de41-f343-86c0-2a1e4aa7ba01"],

Cell[TextData[{
 StyleBox["relation",
  FontWeight->Bold],
 ": structured connection between distinctions,"
}], "Item",ExpressionUUID->"f2a771aa-bb7e-1e45-a51a-fff1e132bac7"],

Cell[TextData[{
 StyleBox["measurement",
  FontWeight->Bold],
 ": recursive discrimination of state by state,"
}], "Item",ExpressionUUID->"b245233e-0491-d24d-81c6-6b8d90f656fc"],

Cell[TextData[{
 StyleBox["closure",
  FontWeight->Bold],
 ": self-returning relational persistence,"
}], "Item",ExpressionUUID->"cd865aba-6ab1-8749-855b-d33cefc50db6"],

Cell[TextData[{
 StyleBox["stability",
  FontWeight->Bold],
 ": persistence under recursive updating,"
}], "Item",ExpressionUUID->"ae386099-972a-d44d-a44e-01162d7e16cd"],

Cell[TextData[{
 StyleBox["scale",
  FontWeight->Bold],
 ": resolution-dependent accessibility of distinctions."
}], "Item",ExpressionUUID->"fbd27cae-8042-304c-bbad-9d1a75cdbb6e"],

Cell["\<\
These primitives are not yet particles or forces. They are ontological \
preconditions for those concepts. \
\>", "Text",ExpressionUUID->"e16d78b5-24ba-4048-bd62-ce4e115ba730"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.3. Minimal primitive law", "Subsection",ExpressionUUID->"81e63297-a610-5e40-9180-62fc56c701f7"],

Cell["A minimal law candidate is: ", "Text",ExpressionUUID->"04272a31-777d-1245-b441-e91b13c241b4"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"whatever persists must be recursively distinguishable from \
its alternatives across repeated self-updating.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"acebcb48-0b9d-9543-8f18-565d06694ecf"],

Cell["\<\
This transforms ontology into a problem of persistence under recursive \
comparison. \
\>", "Text",ExpressionUUID->"09c7cef1-c302-a04b-ba1a-e685fe0b30bf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.4. Why closure matters", "Subsection",ExpressionUUID->"60dc53b7-58c9-4246-8820-a81a184db8fe"],

Cell["\<\
Without closure, distinctions dissipate. With closure, differences can recur, \
reinforce, and sustain an identity-like pattern.\
\>", "Text",ExpressionUUID->"905d929c-02ed-e64c-8c50-e137920d37c0"],

Cell["\<\
This motivates closure as a primitive ontological operator rather than a \
secondary emergent property. \
\>", "Text",ExpressionUUID->"a80c1757-5681-2445-834d-4a4f18bb4aed"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"e25a2591-9875-fa49-b1f5-c2b693441474"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Three-layer and five-layer architecture", "Section",ExpressionUUID->"fc5c70b4-1092-a244-b428-a0d467f261aa"],

Cell[CellGroupData[{

Cell["3.1. Three-layer architecture", "Subsection",ExpressionUUID->"5b14cc10-ae06-a145-84f7-76d43516bf60"],

Cell["The basic version of the framework contains three layers. ", "Text",ExpressionUUID->"27866a0a-59ab-1c41-9ccd-06043791a23c"],

Cell[CellGroupData[{

Cell["Layer 0: ontological potential", "Subsubsection",ExpressionUUID->"1693471e-b221-8448-92db-a268597af321"],

Cell["\<\
This is not ordinary physical vacuum. It is pre-physical admissibility.\
\>", "Text",ExpressionUUID->"b1adee2f-9a7c-1843-ae81-d4648b4153d8"],

Cell["Properties: ", "Text",ExpressionUUID->"b797fb2e-2091-fb4f-b8d5-477fc52a123a"],

Cell["timeless,", "Item",ExpressionUUID->"30a7dda5-9b8a-a640-a25d-ca569aa29b44"],

Cell["pre-metric or proto-metric,", "Item",ExpressionUUID->"fce14589-1757-e942-94a8-97afc2c83c74"],

Cell["unconstrained by realized law,", "Item",ExpressionUUID->"c79bcc60-07bd-fa4e-98f8-b032e771a174"],

Cell["not yet partitioned into observer and observed.", "Item",ExpressionUUID->"b254424e-c3b1-b247-bdca-b0d938d09b2c"],

Cell["A symbolic placeholder is: ", "CodeText",ExpressionUUID->"f66934c5-5e82-6241-9810-c5465dfd6cef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"layer0", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Name\>\"", "->", "\"\<OntologicalPotential\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Timeless\>\"", "->", "True"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<MetricRealized\>\"", "->", "False"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<DistinctionsRealized\>\"", "->", "False"}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",ExpressionUUID->\
"4b0248e1-b127-5f45-b96a-7d8c376c6683"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer 1: recursive self-measuring field", "Subsubsection",ExpressionUUID->"4b86bd3f-beff-ab4b-b438-e5e8fee41cef"],

Cell["\<\
This is the domain in which distinctions, relations, coherence, geometry, and \
closure become dynamically expressible.\
\>", "Text",ExpressionUUID->"50fed70b-dbca-ed46-a3e9-db62fca4c25a"],

Cell["Placeholder: ", "CodeText",ExpressionUUID->"b5ee3140-967b-7d4f-91ca-622eed5fa96a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"layer1", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Name\>\"", "->", "\"\<RecursiveField\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<State\>\"", 
      "->", "\"\<Psi[rho, chi, resolution, phase, closure, memory]\>\""}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<SelfMeasurement\>\"", "->", "True"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<ScaleInvariantGoal\>\"", "->", "True"}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",ExpressionUUID->\
"d85d8ca7-b54d-9c4e-8f5c-29cdb9515a6e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer 2: stabilized physical reality", "Subsubsection",ExpressionUUID->"5306d79f-d9fb-7e4f-94dd-16e016e37b23"],

Cell["\<\
This layer contains persistent observables: matter, fields, clocks, \
organisms, instruments, and laboratories. \
\>", "Text",ExpressionUUID->"1bf72f91-022f-bd44-97dd-9fad56df6eee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"layer2", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Name\>\"", "->", "\"\<MeasuredReality\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<PersistentObservables\>\"", "->", "True"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<DecoheredStructures\>\"", "->", "True"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<OperationalPhysics\>\"", "->", "True"}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",ExpressionUUID->\
"d9937171-9efa-e249-a839-55d6d8f6ebad"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.2. Five-layer refinement", "Subsection",ExpressionUUID->"658ff0e9-1a8a-d640-93d6-8a1b5d9aa3f1"],

Cell["A deeper version distinguishes two additional layers. ", "Text",ExpressionUUID->"8716eddf-08a7-ee4f-82e8-f85fcde4ba3c"],

Cell[CellGroupData[{

Cell["Layer 3: biological sensing and cognition", "Subsubsection",ExpressionUUID->"824eda46-2280-114b-ad4e-7035067e72d4"],

Cell["Organisms are specialized measurement structures. ", "Text",ExpressionUUID->"9f26daba-c629-7a42-8e3f-fce4a37c3f4c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer 4: symbolic reflective intelligence", "Subsubsection",ExpressionUUID->"ddc918df-d51f-a144-8825-64dc3a20525f"],

Cell["\<\
Language, mathematics, science, and philosophy are reality recursively \
modeling its own measurement logic. \
\>", "Text",ExpressionUUID->"d61f9ecb-1025-a34c-b24f-239c22c72786"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.3. Morphism chain", "Subsection",ExpressionUUID->"54b10160-bc24-364e-a7f8-729cc0f4c558"],

Cell[TextData[{
 "A strong formal scaffold is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], "0"], 
         OverscriptBox["\[LongRightArrow]", "F_{01}"], 
         SubscriptBox[
          StyleBox["L", "TI"], "1"], 
         OverscriptBox["\[LongRightArrow]", "F_{12}"], 
         SubscriptBox[
          StyleBox["L", "TI"], "2"], 
         OverscriptBox["\[LongRightArrow]", "F_{23}"], 
         SubscriptBox[
          StyleBox["L", "TI"], "3"], 
         OverscriptBox["\[LongRightArrow]", "F_{34}"], 
         SubscriptBox[
          StyleBox["L", "TI"], "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{L}_0 \\xrightarrow{F_{01}} \\mathcal{L}_1 \
\\xrightarrow{F_{12}} \\mathcal{L}_2 \\xrightarrow{F_{23}} \\mathcal{L}_3 \
\\xrightarrow{F_{34}} \\mathcal{L}_4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "84174e0b-5bf9-6c4d-ad70-f7221f0c83db"],
 "Where: "
}], "Text",ExpressionUUID->"75123b3d-2cc9-8947-aad2-8c8a3824b7e8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["F", "TI"], "01"], TraditionalForm], "errors" -> {}, "input" -> 
     "F_{01}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8b2d4fa-657b-6b41-85f8-db3c8ac78eda"],
 " maps admissible potential into differentiable field structure,"
}], "Item",ExpressionUUID->"8af266ce-92b1-904e-9a6c-400bd188dfd8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["F", "TI"], "12"], TraditionalForm], "errors" -> {}, "input" -> 
     "F_{12}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5dc67243-10c0-2b46-987a-cf66947e5423"],
 " maps field recursions into stable observables,"
}], "Item",ExpressionUUID->"7fc4dc35-290f-4a41-ad1f-37230e745d31"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["F", "TI"], "23"], TraditionalForm], "errors" -> {}, "input" -> 
     "F_{23}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ad1e766f-3b1c-0243-bc58-3f83298f97ee"],
 " maps observables into adaptive sensory systems,"
}], "Item",ExpressionUUID->"a4c072ca-46cf-1d46-adcd-3fe8133e5267"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["F", "TI"], "34"], TraditionalForm], "errors" -> {}, "input" -> 
     "F_{34}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bed715c9-9a29-174c-8844-fc5b84c1a9a6"],
 " maps sensing into symbolic self-modeling."
}], "Item",ExpressionUUID->"80c2d87e-3b93-d94c-b1ad-db730244d06c"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
