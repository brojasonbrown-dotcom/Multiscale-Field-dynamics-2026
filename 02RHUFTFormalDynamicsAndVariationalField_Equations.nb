}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Formal state variables", "Section",ExpressionUUID->"6bd6f147-3504-084d-a9a0-74b2586e1b7b"],

Cell["We now define a candidate field state.", "Text",ExpressionUUID->"03813f2d-1286-1e42-8b25-fdae58cb65bc"],

Cell[TextData[{
 "At spacetime point ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["x", "TI"], TraditionalForm], "errors" -> {}, "input" -> "x", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b20a13a-98ad-3c45-be16-31e71937cca6"],
 ", scale parameter ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Sigma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3181b6aa-9171-b345-854c-83c382042929"],
 ", and update parameter ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Tau]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\tau", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f713dac6-97dc-bf46-8f5f-f3412cc6fa72"],
 ", let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPsi]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", "\[Sigma]", ",", "\[Tau]"}], ")"}], 
         "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"\[Rho]", 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["x", "TI"], ",", "\[Sigma]", ",", "\[Tau]"}], ")"}],
              ",", "\[Chi]", 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["x", "TI"], ",", "\[Sigma]", ",", "\[Tau]"}], ")"}],
              ",", 
             StyleBox["R", "TI"], 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["x", "TI"], ",", "\[Sigma]", ",", "\[Tau]"}], ")"}],
              ",", "\[Phi]", 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["x", "TI"], ",", "\[Sigma]", ",", "\[Tau]"}], ")"}],
              ",", "\[Kappa]", 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["x", "TI"], ",", "\[Sigma]", ",", "\[Tau]"}], ")"}],
              ",", 
             StyleBox["m", "TI"], 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["x", "TI"], ",", "\[Sigma]", ",", "\[Tau]"}], 
               ")"}]}], ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Psi(x,\\sigma,\\tau)=\\big(\\rho(x,\\sigma,\\tau),\\chi(x,\\sigma,\\\
tau),R(x,\\sigma,\\tau),\\phi(x,\\sigma,\\tau),\\kappa(x,\\sigma,\\tau),m(x,\\\
sigma,\\tau)\\big)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4213f241-922f-d04a-ad9b-cd878966d35d"],
 "where: "
}], "Text",ExpressionUUID->"5e48273f-eec7-364a-a13c-bf3d28488784"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Rho]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7a54ce43-080e-6e4b-bc0e-bb2a912e3d7d"],
 " = information density,"
}], "Item",ExpressionUUID->"d8b5bacc-293f-104e-a1df-aa23dd689c13"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Chi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\chi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e7f6d23c-2004-2840-9cc8-521e05e21493"],
 " = field complexity,"
}], "Item",ExpressionUUID->"41927d0c-3c33-1240-b6d0-fc399033f51d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "db14909f-c79e-d541-ac7d-da0c96d26ac3"],
 " = effective observational resolution,"
}], "Item",ExpressionUUID->"bf12d2b7-5fa8-ec4c-8557-a7281bb3f4c1"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "edb5a8e0-814a-ef41-ac53-0f388c1c31ca"],
 " = alignment or phase field,"
}], "Item",ExpressionUUID->"009674bf-f63e-5e41-adb5-8530f0d82437"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Kappa]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\kappa", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7a6e9581-90bf-2f4f-bd6d-a21fddeb447e"],
 " = closure density,"
}], "Item",ExpressionUUID->"b4652696-9942-1b46-a59c-f90fce0050e2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["m", "TI"], TraditionalForm], "errors" -> {}, "input" -> "m", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d9c63bab-f86f-c241-acc3-ffb1a4d779c2"],
 " = memory trace."
}], "Item",ExpressionUUID->"8fb175af-8ea9-644f-8d18-46c5e96f120f"],

Cell[CellGroupData[{

Cell["2.1. Interpretation of variables", "Subsection",ExpressionUUID->"48ea5adc-b855-b64c-bd39-1ae767495043"],

Cell[CellGroupData[{

Cell[TextData[{
 "Information density ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Rho]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d9383450-a625-4145-a701-8fdaa28fd98c"]
}], "Subsubsection",ExpressionUUID->"19be90e2-5e08-e546-84c4-41f1768184dd"],

Cell["\<\
A candidate interpretation is the locally realizable density of \
distinguishable relational states. \
\>", "Text",ExpressionUUID->"3cb011d8-5f41-9442-a0d8-65ae7b3ea8d7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Complexity ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Chi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\chi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "703998fd-4a8b-574b-8ec3-a8e7a2866cdf"]
}], "Subsubsection",ExpressionUUID->"3bde22dd-c29c-b743-935d-6d540a1380a7"],

Cell["\<\
This measures structural depth, algorithmic richness, or nontriviality of the \
local field organization. \
\>", "Text",ExpressionUUID->"77100b80-cbc0-6845-a9fb-816c06a41d2f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Resolution ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "950fda19-c897-3c4e-b884-020d1e31c4ae"]
}], "Subsubsection",ExpressionUUID->"cdaa8273-8a49-2945-8178-15aa10099c21"],

Cell["\<\
This is not merely an instrument setting. It is the effective grain at which \
distinctions are stably available. \
\>", "Text",ExpressionUUID->"9484c267-813a-2841-9f01-61fb1750c233"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Phase/alignment ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "295d92b0-ce56-3f48-94ca-843030343913"]
}], "Subsubsection",ExpressionUUID->"a5004d99-e3fd-404a-8a4b-d06726b0d21b"],

Cell["\<\
This represents angular or phase coordination across neighboring field \
regions. \
\>", "Text",ExpressionUUID->"b69d8fbb-fe5b-214c-9dda-fed8fa830bf3"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Closure density ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Kappa]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\kappa", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "54022e9b-48cc-374b-9f9e-e9969d582142"]
}], "Subsubsection",ExpressionUUID->"11662bb4-f918-d24c-87ab-ba758c68a91d"],

Cell["\<\
This is the extent to which local state evolution returns into persistent \
self-consistent cycles. \
\>", "Text",ExpressionUUID->"6ba2cc45-2d8c-434a-82a0-3e4962d54891"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Memory trace ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["m", "TI"], TraditionalForm], "errors" -> {}, "input" -> "m", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f819fadf-62a5-d247-91e9-2cdf48f029ef"]
}], "Subsubsection",ExpressionUUID->"4cfd8743-e9b3-8048-ba5c-ffc8930eb509"],

Cell["\<\
This carries persistence of prior measurement history into current \
stabilization. \
\>", "Text",ExpressionUUID->"291463e4-8f77-b043-9449-196b7f97c7fe"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2. Wolfram Language representation", "Subsection",ExpressionUUID->"0b8d2523-c2db-7741-a6e6-84b9a7039588"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "psiState", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"psiState", "[", 
    RowBox[{
    "rho_", ",", "chi_", ",", "resolution_", ",", "phase_", ",", "closure_", ",",
      "memory_"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<InformationDensity\>\"", "->", "rho"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<FieldComplexity\>\"", "->", "chi"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Resolution\>\"", "->", "resolution"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Phase\>\"", "->", "phase"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<ClosureDensity\>\"", "->", "closure"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<MemoryTrace\>\"", "->", "memory"}]}], "\[IndentingNewLine]",
     "|>"}]}], ";"}]}], "Input",ExpressionUUID->"88f75ee1-d918-f141-9cdb-\
8927055f48f0"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"17c74e3d-7277-1147-ad17-a01ce5aec738"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Variational principle", "Section",ExpressionUUID->"bcb7bb0f-41f6-b94a-9b8e-795e5aa815bb"],

Cell[CellGroupData[{

Cell["3.1. Starting point", "Subsection",ExpressionUUID->"fbf9c721-3f69-224b-9fcf-d24dc7f722b1"],

Cell[TextData[{
 "The user-supplied core action was: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], "\[LongEqual]", "\[Integral]", 
         RowBox[{"(", 
           RowBox[{"\[Rho]", "log", "\[Chi]", "+", "\[Chi]", 
             SuperscriptBox[
              StyleBox["R", "TI"], "2"]}], ")"}], "\[DifferentialD]", 
         "\[CapitalOmega]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "S = \\int \\left(\\rho\\log\\chi + \\chi R^2\\right)\\,d\\Omega", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "087332e8-02ce-5540-b94d-ff195813ea53"],
 "This is a useful seed but by itself is too degenerate to sustain rich \
stable solutions. A deeper field theory requires derivative terms and \
stabilizing potentials. "
}], "Text",ExpressionUUID->"899a7238-1259-5641-bec3-e383dfb783ee"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.2. Extended action functional", "Subsection",ExpressionUUID->"89d06b8c-4b2f-0e46-bc4f-99e5121cfaed"],

Cell[TextData[{
 "We define the action: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], 
         RowBox[{"[", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"], ",", "\[Phi]", ",", "\[Kappa]", ",", 
             StyleBox["m", "TI"]}], "]"}], "\[LongEqual]", 
         SubscriptBox["\[Integral]", "\[CapitalOmega]"], 
         StyleBox["L", "TI"], "\[DifferentialD]", "\[CapitalOmega]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "S[\\rho,\\chi,R,\\phi,\\kappa,m]\n=\n\\int_{\\Omega}\n\
\\mathcal{L}\\,d\\Omega", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3e9a2ca4-d252-a34d-9763-f71f09cec52a"],
 "with Lagrangian density ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", "\[Rho]", "log", "\[Chi]", "+", 
         "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "+", 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], "\[Rho]"], "2"], "\[DoubleVerticalBar]", 
         "\[Del]", 
         SuperscriptBox["\[Rho]\[DoubleVerticalBar]", "2"], "+", 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], "\[Chi]"], "2"], "\[DoubleVerticalBar]", 
         "\[Del]", 
         SuperscriptBox["\[Chi]\[DoubleVerticalBar]", "2"], "+", 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], 
           StyleBox["R", "TI"]], "2"], "\[DoubleVerticalBar]", "\[Del]", 
         StyleBox["R", "TI"], 
         SuperscriptBox["\[DoubleVerticalBar]", "2"], "+", 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], "\[Phi]"], "2"], "\[DoubleVerticalBar]", 
         "\[Del]", 
         SuperscriptBox["\[Phi]\[DoubleVerticalBar]", "2"], "+", 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], "\[Kappa]"], "2"], "\[DoubleVerticalBar]", 
         "\[Del]", 
         SuperscriptBox["\[Kappa]\[DoubleVerticalBar]", "2"], "+", 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], 
           StyleBox["m", "TI"]], "2"], "\[DoubleVerticalBar]", "\[Del]", 
         StyleBox["m", "TI"], 
         SuperscriptBox["\[DoubleVerticalBar]", "2"], "-", 
         StyleBox["V", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"], ",", "\[Phi]", ",", "\[Kappa]", ",", 
             StyleBox["m", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\mathcal{L} =\n\\rho\\log\\chi\n+ \\chi R^2\n+ \
\\frac{a_\\rho}{2}\\|\\nabla \\rho\\|^2\n+ \\frac{a_\\chi}{2}\\|\\nabla \\chi\
\\|^2\n+ \\frac{a_R}{2}\\|\\nabla R\\|^2\n+ \\frac{a_\\phi}{2}\\|\\nabla \
\\phi\\|^2\n+ \\frac{a_\\kappa}{2}\\|\\nabla \\kappa\\|^2\n+ \
\\frac{a_m}{2}\\|\\nabla m\\|^2\n- V(\\rho,\\chi,R,\\phi,\\kappa,m)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8117b9b6-4551-0a45-a0fa-a50f0ae69b76"],
 "The gradient terms permit spatial structure, localization, and nontrivial \
equilibrium. "
}], "Text",ExpressionUUID->"a4da8b6b-0d77-6741-9d86-317b473aea76"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.3. Why a potential is required", "Subsection",ExpressionUUID->"f37e8be8-ddcc-7045-a68e-55aeae3e8971"],

Cell["\<\
Without a stabilizing potential, the action produces underconstrained \
stationary conditions.\
\>", "Text",ExpressionUUID->"247ee48c-03f3-5e46-b272-b10056e8bfe7"],

Cell["\<\
A realistic recursive field model needs attractor structure. \
\>", "Text",ExpressionUUID->"a0a70046-ac98-8d43-a1b0-7ade1c0fe794"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"773d07b5-3534-3744-97cf-c1be6b6ea426"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Closure and ratio-locking potentials", "Section",ExpressionUUID->"4facbabe-98ac-0741-840b-1e03b83c1291"],

Cell[CellGroupData[{

Cell["4.1. Geometric stabilization idea", "Subsection",ExpressionUUID->"e7f2a0f6-c8bb-1b4e-b0d3-26fa84e79b0e"],

Cell["The framework emphasizes: ", "Text",ExpressionUUID->"2a0ede19-b358-0a46-be8e-2f3ca282c131"],

Cell["golden-ratio spacing,", "Item",ExpressionUUID->"f12c92a8-92be-4944-8a67-6fc83be36f20"],

Cell["silver-ratio balancing,", "Item",ExpressionUUID->"612acbef-8601-f945-9d80-7be269b5dd40"],

Cell["golden-angle angular recursion,", "Item",ExpressionUUID->"f965b9a5-41ff-d14d-9bae-856199cc7a98"],

Cell["toroidal recurrence,", "Item",ExpressionUUID->"bbd7b559-a117-794a-8e0e-48ea0384dae8"],

Cell["closure persistence.", "Item",ExpressionUUID->"726f6a6d-341c-1142-8f6e-52ffbd6689fb"],

Cell["These should enter through potentials, not slogans. ", "Text",ExpressionUUID->"3ccd6858-ac92-5044-9c88-45ca793c04dd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2. Golden and silver ratio terms", "Subsection",ExpressionUUID->"3d679074-9bb7-234b-88c3-9fee4e3b4bc8"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CurlyPhi]", 
          StyleBox["G", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"1", "+", 
            SqrtBox["5"]}], "2"], ",    ", 
         SubscriptBox["\[Delta]", 
          StyleBox["S", "TI"]], "\[LongEqual]", "1", "+", 
         SqrtBox["2"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\varphi_G = \\frac{1+\\sqrt{5}}{2}, \\qquad \\delta_S = 1+\\sqrt{2}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bdc089d6-6108-d540-be86-d72a2740ea81"],
 "A candidate ratio-locking contribution is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["V", "TI"], "ratio"], "\[LongEqual]", 
         SubscriptBox["\[Lambda]", 
          StyleBox["G", "TI"]], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              FractionBox["\[Chi]", "\[Rho]"], "-", 
              SubscriptBox["\[CurlyPhi]", 
               StyleBox["G", "TI"]]}], ")"}], "2"], "+", 
         SubscriptBox["\[Lambda]", 
          StyleBox["S", "TI"]], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              FractionBox[
               StyleBox["R", "TI"], "\[Rho]"], "-", 
              SubscriptBox["\[Delta]", 
               StyleBox["S", "TI"]]}], ")"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "V_{\\text{ratio}} =\n\
\\lambda_G\\left(\\frac{\\chi}{\\rho}-\\varphi_G\\right)^2\n+ \
\\lambda_S\\left(\\frac{R}{\\rho}-\\delta_S\\right)^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41f2cd3e-e4f2-4e41-bb98-76ee51986867"],
 "This encodes preferred organizational balance conditions. "
}], "Text",ExpressionUUID->"22cfc266-425d-8d43-a86d-8d3ce164ad73"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.3. Golden-angle locking", "Subsection",ExpressionUUID->"3e26c8e8-68f7-6841-a551-c8fe7d5ef092"],

Cell[TextData[{
 "The golden angle is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Theta]", 
          StyleBox["G", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"2", "\[Pi]"}], 
          SubsuperscriptBox["\[CurlyPhi]", 
           StyleBox["G", "TI"], "2"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\theta_G = \\frac{2\\pi}{\\varphi_G^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e88fd528-918f-8b47-ae6b-6b56271d3f72"],
 "A local angular stabilization term may be modeled as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["V", "TI"], "\[Theta]"], "\[LongEqual]", 
         SubscriptBox["\[Lambda]", "\[Theta]"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"cos", "\[Phi]", "-", "cos", 
              SubscriptBox["\[Theta]", 
               StyleBox["G", "TI"]]}], ")"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "V_{\\theta} = \\lambda_\\theta\\left(\\cos \\phi - \\cos \
\\theta_G\\right)^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2e7d3772-4c1a-434b-a29d-5bf2a6895e50"],
 "This is not a claim that all physics literally uses the golden angle. It is \
a preferred recursive spacing ansatz. "
}], "Text",ExpressionUUID->"19f4522b-f8e4-6347-a76a-c3ee9082174f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.4. Closure potential", "Subsection",ExpressionUUID->"adc8f821-4974-d346-870b-79ca3b73b56a"],

Cell[TextData[{
 "A closure density field should neither diverge nor collapse trivially. A \
quartic stabilization term is natural: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["V", "TI"], "\[Kappa]"], "\[LongEqual]", "-", 
         SubscriptBox["\[Mu]", "\[Kappa]"], 
         SuperscriptBox["\[Kappa]", "2"], "+", 
         SubscriptBox["\[Nu]", "\[Kappa]"], 
         SuperscriptBox["\[Kappa]", "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "V_{\\kappa} = -\\mu_\\kappa \\kappa^2 + \\nu_\\kappa \\kappa^4", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3ce0a03d-c672-714e-b777-ffaf1dc33718"],
 "with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", "\[Kappa]"], ",", 
         SubscriptBox["\[Nu]", "\[Kappa]"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mu_\\kappa,\\nu_\\kappa>0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "19a8fb21-b27e-a44d-8530-d8f0de8d0c48"],
 ". "
}], "Text",ExpressionUUID->"5b34ed2d-e28c-fc45-b8ee-b3beadd29cdd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.5. Memory coupling", "Subsection",ExpressionUUID->"11b273c6-a910-484e-85bd-43d906279ca6"],

Cell[TextData[{
 "Memory should reinforce persistent closure without freezing the field \
completely. One simple form is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["m", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Lambda]", 
          StyleBox["m", "TI"]], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["m", "TI"], "-", "\[Alpha]\[Kappa]"}], ")"}], "2"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "V_m = \\lambda_m (m-\\alpha \\kappa)^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50e3b849-9024-8245-9573-8acd85876a20"],
 "so memory tracks closure with finite lag. "
}], "Text",ExpressionUUID->"c2dfbcba-3e47-9441-bb3c-83eeeebb17df"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.6. Full potential", "Subsection",ExpressionUUID->"be527355-8c42-be41-bf8d-6dbf77b09e31"],

Cell[TextData[{
 "A combined candidate is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["V", "TI"], "ratio"], "+", 
         SubscriptBox[
          StyleBox["V", "TI"], "\[Theta]"], "+", 
         SubscriptBox[
          StyleBox["V", "TI"], "\[Kappa]"], "+", 
         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["m", "TI"]], "+", 
         SubscriptBox[
          StyleBox["V", "TI"], "cross"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "V = V_{\\text{ratio}} + V_{\\theta} + V_{\\kappa} + V_m + \
V_{\\text{cross}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "12399f3a-4114-8a43-b8b8-80947bc2523e"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["V", "TI"], "cross"], TraditionalForm], "errors" -> {}, 
     "input" -> "V_{\\text{cross}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "869c947f-3388-504e-9992-05ed8184589d"],
 " may contain couplings like ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["V", "TI"], "cross"], "\[LongEqual]", 
         SubscriptBox["\[Eta]", "\[Rho]\[Kappa]"], "\[Rho]\[Kappa]", "+", 
         SubscriptBox["\[Eta]", "\[Chi]\[Phi]"], "\[Chi]", "cos", "\[Phi]", 
         "+", 
         SubscriptBox["\[Eta]", 
          RowBox[{
            StyleBox["R", "TI"], "\[Kappa]"}]], 
         StyleBox["R", "TI"], "\[Kappa]"}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "V_{\\text{cross}} = \\eta_{\\rho\\kappa}\\rho\\kappa + \
\\eta_{\\chi\\phi}\\chi\\cos\\phi + \\eta_{R\\kappa}R\\kappa", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "303730d1-c677-3a45-b383-cc98e1015171"],
 "These must later be constrained by symmetry and data. "
}], "Text",ExpressionUUID->"383ff1e6-5286-6647-b82f-6621cf37cc7c"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"4653aac9-929e-bc42-95f3-fceaca96d6a2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Euler-Lagrange field equations", "Section",ExpressionUUID->"80105ca3-de75-d148-a461-ef56533928ab"],

Cell[CellGroupData[{

Cell["5.1. General form", "Subsection",ExpressionUUID->"8df9d59e-8ee2-8049-9bc9-908e9e292594"],

Cell[TextData[{
 "For each field variable ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], "\[Element]", 
         RowBox[{"{", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"], ",", "\[Phi]", ",", "\[Kappa]", ",", 
             StyleBox["m", "TI"]}], "}"}]}], TraditionalForm], "errors" -> {},
      "input" -> "q \\in \\{\\rho,\\chi,R,\\phi,\\kappa,m\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0280392b-7413-264f-96b0-0833c7d69b0b"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["L", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["q", "TI"]}]], "-", "\[Del]", "\[CenterDot]", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["L", "TI"]}], 
          RowBox[{"\[PartialD]", "(", 
            RowBox[{"\[Del]", 
              StyleBox["q", "TI"]}], ")"}]], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial \\mathcal{L}}{\\partial q} - \
\\nabla\\cdot\\frac{\\partial \\mathcal{L}}{\\partial (\\nabla q)} = 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5a1c1590-d941-ab46-aa9a-a5df616bada0"]
}], "Text",ExpressionUUID->"17f76ebc-f4f7-3449-8475-52b5a45c68ef"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.2. Symbolic derivation in Wolfram Language", "Subsection",ExpressionUUID->"36cc48f5-b5a0-2e48-848c-8189034b6b3d"],

Cell[TextData[{
 "Use ",
 ButtonBox["EulerEquations",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/EulerEquations"],
 " for formal derivation. "
}], "Text",ExpressionUUID->"c208f510-7278-0342-b544-33962e3d3b87"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "x", ",", "y", ",", "z", ",", "rho", ",", "chi", ",", "res", ",", "phase",
      ",", "closure", ",", "memory", ",", "\[IndentingNewLine]", "  ", "aRho",
      ",", "aChi", ",", "aRes", ",", "aPhase", ",", "aClosure", ",", 
     "aMemory", ",", "\[IndentingNewLine]", "  ", "lambdaG", ",", "lambdaS", ",",
      "lambdaTheta", ",", "muClosure", ",", "nuClosure", ",", "lambdaMemory", 
     ",", "\[IndentingNewLine]", "  ", "alphaMemory", ",", "etaRhoClosure", ",",
      "etaChiPhase", ",", "etaResClosure", ",", "goldenRatio", ",", 
     "silverRatio", ",", "\[IndentingNewLine]", "  ", "goldenAngle", ",", 
     "lagrangianDensity", ",", "potential"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"goldenRatio", "=", "GoldenRatio"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"silverRatio", "=", 
   RowBox[{"1", "+", 
    RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"goldenAngle", "=", 
    RowBox[{"2", " ", 
     RowBox[{"Pi", "/", 
      RowBox[{"goldenRatio", "^", "2"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"potential", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"lambdaG", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"chi", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}], "/", 
          RowBox[{"rho", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "-", "goldenRatio"}], 
        ")"}], "^", "2"}]}], "+", "\[IndentingNewLine]", "  ", 
     RowBox[{"lambdaS", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"res", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}], "/", 
          RowBox[{"rho", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "-", "silverRatio"}], 
        ")"}], "^", "2"}]}], "+", "\[IndentingNewLine]", "  ", 
     RowBox[{"lambdaTheta", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"phase", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}], "]"}], "-", 
         RowBox[{"Cos", "[", "goldenAngle", "]"}]}], ")"}], "^", "2"}]}], "+",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "muClosure"}], " ", 
        RowBox[{
         RowBox[{"closure", "[", 
          RowBox[{"x", ",", "y", ",", "z"}], "]"}], "^", "2"}]}], "+", 
       RowBox[{"nuClosure", " ", 
        RowBox[{
         RowBox[{"closure", "[", 
          RowBox[{"x", ",", "y", ",", "z"}], "]"}], "^", "4"}]}]}], ")"}], "+",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"lambdaMemory", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"memory", "[", 
          RowBox[{"x", ",", "y", ",", "z"}], "]"}], "-", 
         RowBox[{"alphaMemory", " ", 
          RowBox[{"closure", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}]}]}], ")"}], "^", "2"}]}], 
     "+", "\[IndentingNewLine]", "  ", 
     RowBox[{"etaRhoClosure", " ", 
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], " ", 
      RowBox[{"closure", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "+", "\[IndentingNewLine]",
      "  ", 
     RowBox[{"etaChiPhase", " ", 
      RowBox[{"chi", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"phase", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "]"}]}], "+", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"etaResClosure", " ", 
      RowBox[{"res", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], " ", 
      RowBox[{"closure", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lagrangianDensity", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "]"}]}], "+", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"chi", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], " ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "^", "2"}]}], "+", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"aRho", "/", "2"}], " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"Grad", "[", 
         RowBox[{
          RowBox[{"rho", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "]"}], "^", 
       "2"}]}], "+", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"aChi", "/", "2"}], " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"Grad", "[", 
         RowBox[{
          RowBox[{"chi", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "]"}], "^", 
       "2"}]}], "+", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"aRes", "/", "2"}], " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"Grad", "[", 
         RowBox[{
          RowBox[{"res", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "]"}], "^", 
       "2"}]}], "+", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"aPhase", "/", "2"}], " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"Grad", "[", 
         RowBox[{
          RowBox[{"phase", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "]"}], "^", 
       "2"}]}], "+", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"aClosure", "/", "2"}], " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"Grad", "[", 
         RowBox[{
          RowBox[{"closure", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "]"}], "^", 
       "2"}]}], "+", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"aMemory", "/", "2"}], " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"Grad", "[", 
         RowBox[{
          RowBox[{"memory", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "]"}], "^", 
       "2"}]}], "-", "potential"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eulerSystem", "=", 
   RowBox[{"EulerEquations", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{"lagrangianDensity", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
       RowBox[{"phase", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
       RowBox[{"closure", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
       RowBox[{"memory", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"e2a8349e-aff2-b24a-a67b-\
889d952e72cc"]
}, Open  ]],

