        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"10e04ccd-1229-6a4c-bf5f-76c69b3fccc1"],

