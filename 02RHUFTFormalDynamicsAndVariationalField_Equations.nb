 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"a7814846-7401-1a4c-811c-bfe091caa2f0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Missing variables and complement analysis", "Section",ExpressionUUID->"faf7dcb6-1a2e-8f4a-850d-bf74dcf5e01f"],

Cell[CellGroupData[{

Cell["9.1. Why missing variables matter", "Subsection",ExpressionUUID->"a836de0d-19a2-944b-b9ad-821657e92506"],

Cell["\<\
If the theory introduces only known constants and no new operational \
variables, it risks becoming a reinterpretation rather than an explanatory \
framework.\
\>", "Text",ExpressionUUID->"1c5d38ab-6a95-9948-b5eb-eaf9fa655606"],

Cell["A useful formal question is: ", "Text",ExpressionUUID->"efcba287-8103-5647-bf8c-578c3ffb2386"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"what variables are present in the Layer 1 action that are \
absent from standard model parameterization?\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"cb054d1b-71f1-464f-a465-616b1d298418"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.2. Symbolic complement idea", "Subsection",ExpressionUUID->"48988b00-d4dd-4f4b-9757-96db26159623"],

Cell["A formal sketch in Wolfram Language is: ", "CodeText",ExpressionUUID->"87f1ccfe-1648-b840-9d8b-279cdc40ef0c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "layer1Variables", ",", "standardModelLikeConstants", ",", 
     "missingVariables"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"layer1Variables", "=", 
   RowBox[{"{", 
    RowBox[{
    "rho", ",", "chi", ",", "R", ",", "phase", ",", "closure", ",", 
     "memory"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"standardModelLikeConstants", "=", 
   RowBox[{"{", 
    RowBox[{"c", ",", "h", ",", "e", ",", "G", ",", "kB"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"missingVariables", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{"layer1Variables", ",", "standardModelLikeConstants"}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"fa3418ff-7b2d-a14b-a6c4-7d6cbcfe1c3c"],

Cell["\<\
This is only schematic, but it encodes the principle that the ontology should \
reveal variables not native to textbook physics. \
\>", "Text",ExpressionUUID->"60dceebf-7d37-c846-a4fa-5f281c0ed43c"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"c4dbafa0-fb20-0648-b379-ca5ead6c38a7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Spherical geometry and balanced node spacing", "Section",ExpressionUUID->"df545762-7821-654d-b3b8-80cff93d7dd0"],

Cell[CellGroupData[{

Cell["10.1. Why the sphere appears naturally", "Subsection",ExpressionUUID->"6c37f7a9-c203-7d4a-ba4a-d490dc25970c"],

Cell["\<\
A sphere is the canonical isotropic finite boundary for distributing nodes \
with minimal edge bias in many recursive packing constructions. \
\>", "Text",ExpressionUUID->"b546719d-8380-9649-9cc5-29178c01f881"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.2. Golden-angle spherical node field", "Subsection",ExpressionUUID->"58f8b2ad-ae0f-5246-814f-1974700c498f"],

Cell[TextData[{
 "For node index ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
         StyleBox["N", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "n=1,\\dots,N", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6b37119f-e5dc-4041-bf84-9e397baa5d33"],
 " define: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["z", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", "1", "-", 
         FractionBox[
          RowBox[{"2", 
            StyleBox["n", "TI"], "-", "1"}], 
          StyleBox["N", "TI"]], ",    ", 
         SubscriptBox[
          StyleBox["r", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SqrtBox[
          RowBox[{"1", "-", 
            SubsuperscriptBox[
             StyleBox["z", "TI"], 
             StyleBox["n", "TI"], "2"]}]], ",    ", 
         SubscriptBox["\[CurlyPhi]", 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         StyleBox["n", "TI"], 
         SubscriptBox["\[Theta]", 
          StyleBox["G", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "z_n = 1 - \\frac{2n-1}{N}, \\qquad r_n = \\sqrt{1-z_n^2}, \\qquad \
\\varphi_n = n\\theta_G", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f98f273a-c302-c140-a78b-255809166c6a"],
 "Then: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["r", "TI"], 
          StyleBox["n", "TI"]], "cos", 
         SubscriptBox["\[CurlyPhi]", 
          StyleBox["n", "TI"]], ",    ", 
         SubscriptBox[
          StyleBox["y", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["r", "TI"], 
          StyleBox["n", "TI"]], "sin", 
         SubscriptBox["\[CurlyPhi]", 
          StyleBox["n", "TI"]], ",    ", 
         SubscriptBox[
          StyleBox["z", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["z", "TI"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "x_n = r_n \\cos \\varphi_n, \\qquad y_n = r_n \\sin \\varphi_n, \\qquad \
z_n = z_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "882c9ea1-ab1a-9c4a-a8ba-cd6f43455a81"],
 "This produces near-uniform balanced spacing. "
}], "Text",ExpressionUUID->"badafd50-70be-694d-9b08-b9cc3899518a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.3. Wolfram Language implementation", "Subsection",ExpressionUUID->"239f20d4-2724-1148-a474-baed0d639f4b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "goldenSphereNodes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"goldenSphereNodes", "[", 
    RowBox[{"nodeCount_Integer", "?", "Positive"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"zVal", "=", 
          RowBox[{"1", "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "n"}], "-", "1"}], ")"}], "/", 
            "nodeCount"}]}]}], ",", 
         RowBox[{"az", "=", 
          RowBox[{"n", " ", "goldenAngle"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", "      ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rad", "=", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", "-", 
             RowBox[{"zVal", "^", "2"}]}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"rad", " ", 
            RowBox[{"Cos", "[", "az", "]"}]}], ",", 
           RowBox[{"rad", " ", 
            RowBox[{"Sin", "[", "az", "]"}]}], ",", "zVal"}], "}"}]}], 
        "\[IndentingNewLine]", "      ", "]"}]}], "\[IndentingNewLine]", 
      "    ", "]"}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "nodeCount"}], "}"}]}], 
    "\[IndentingNewLine]", "  ", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"26ee4c3e-b157-6b40-98c4-9f88ae9dfd79"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.4. Why this matters for measurement", "Subsection",ExpressionUUID->"1c416ddf-d014-5042-bc6d-2add0e18571c"],

Cell["\<\
If observability depends on structured field density, then instrument design \
may need to match or probe preferred geometric node distributions rather than \
assuming uniform linear sampling is always optimal. \
\>", "Text",ExpressionUUID->"a0025ec5-9df7-f144-b1c2-5beac05608eb"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"693a54ae-8ecf-8047-b39b-de02ddc710f2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Toroidal recursion and circulation", "Section",ExpressionUUID->"645a78e2-7a79-6f46-a589-ac9292eba81e"],

Cell[CellGroupData[{

Cell["11.1. Why toroidal closure matters", "Subsection",ExpressionUUID->"d313a211-de68-5a4d-b94e-5d200061890c"],

Cell["\<\
A torus is the simplest topology combining circulation and return. It is a \
natural geometry for systems requiring both flow and closure. \
\>", "Text",ExpressionUUID->"abd69828-92d2-8649-a6af-5425c7941a6a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.2. Toroidal parameterization", "Subsection",ExpressionUUID->"2419ceac-ca90-8f4f-811b-170371da68fb"],

Cell[TextData[{
 "A standard embedding is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["X", FontSlant -> "Bold"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["u", "TI"], ",", 
             StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["R", "TI"], "0"], "+", 
                 SubscriptBox[
                  StyleBox["r", "TI"], "0"], "cos", 
                 StyleBox["v", "TI"]}], ")"}], "cos", 
             StyleBox["u", "TI"], ",", 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["R", "TI"], "0"], "+", 
                 SubscriptBox[
                  StyleBox["r", "TI"], "0"], "cos", 
                 StyleBox["v", "TI"]}], ")"}], "sin", 
             StyleBox["u", "TI"], ",", 
             SubscriptBox[
              StyleBox["r", "TI"], "0"], "sin", 
             StyleBox["v", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\mathbf{X}(u,v)=\\big((R_0+r_0\\cos v)\\cos u,(R_0+r_0\\cos v)\\sin \
u,r_0\\sin v\\big)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0c169c2f-965b-2843-b33a-f99438ee48c1"],
 "with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["u", "TI"], ",", 
         StyleBox["v", "TI"], "\[Element]", 
         RowBox[{"[", 
           RowBox[{"0", ",", "2", "\[Pi]"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "u,v \\in [0,2\\pi)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0d05906d-5fc1-374e-a476-f4c243ab6b1b"],
 ". "
}], "Text",ExpressionUUID->"795a16c4-79ec-354d-9542-1aa174f6d239"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.3. Closure interpretation", "Subsection",ExpressionUUID->"e75cf194-ffd8-9746-b657-5c3e74b66c61"],

Cell["Toroidal circulation can model: ", "Text",ExpressionUUID->"e75b6301-c463-604b-bf1d-bf31a26c9207"],

Cell["memory retention through recurrence,", "Item",ExpressionUUID->"709b80b5-6971-714e-8b34-b02a695bc292"],

Cell["flux preservation,", "Item",ExpressionUUID->"41bf4671-61e1-8d4b-a1e7-11f0afeb7ecd"],

Cell["bidirectional flow with self-return,", "Item",ExpressionUUID->"05fe757b-33b8-d64f-aa9d-4b8f9be66790"],

Cell["nested scale loops.", "Item",ExpressionUUID->"5ce40f09-5f2b-ab4c-aa0a-6dfd5bd0bdb4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.4. Wolfram Language representation", "Subsection",ExpressionUUID->"55b4a37b-dbce-f64f-a437-c5170e31f081"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "toroidalPoint", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toroidalPoint", "[", 
    RowBox[{"majorRadius_", ",", "minorRadius_", ",", "u_", ",", "v_"}], 
    "]"}], ":=", 
   RowBox[{"{", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"majorRadius", "+", 
        RowBox[{"minorRadius", " ", 
         RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
      RowBox[{"Cos", "[", "u", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"majorRadius", "+", 
        RowBox[{"minorRadius", " ", 
         RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
      RowBox[{"Sin", "[", "u", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"minorRadius", " ", 
      RowBox[{"Sin", "[", "v", "]"}]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]}], "Input",ExpressionUUID->"b3e1bb85-9c99-f64f-8306-cad8b11de7c1"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"220ccec2-a6f5-f748-848e-ffaad67fbd6e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
12. Measurement redesign: what should a true instrument measure?\
\>", "Section",ExpressionUUID->"a9a4f88e-e86a-3042-9d6f-6149049f2b92"],

Cell[CellGroupData[{

Cell["12.1. Standard instruments mostly measure projections", "Subsection",ExpressionUUID->"2844b08f-7ba4-3749-9bbe-ca6cbf497587"],

Cell["Most instruments measure one or a few reduced observables: ", "Text",ExpressionUUID->"def69a6b-218f-794c-b99a-5ca000d9bd01"],

Cell["voltage,", "Item",ExpressionUUID->"d5f9c563-a85a-3140-bb90-6ca39e041c14"],

Cell["count rate,", "Item",ExpressionUUID->"f1e4c70e-8cbb-1e42-b15c-e3a3b9b55006"],

Cell["frequency,", "Item",ExpressionUUID->"4fc1adad-b958-6a44-9040-8f4381953589"],

Cell["displacement,", "Item",ExpressionUUID->"6d5f0b6a-6431-7142-bd55-7d9aa27042e5"],

Cell["spectrum,", "Item",ExpressionUUID->"3984c261-d485-3841-97d6-77d356ed8bf7"],

Cell["time interval.", "Item",ExpressionUUID->"134e879a-035c-b440-b43f-6e1d33240170"],

Cell["These are projections from a far richer interaction state. ", "Text",ExpressionUUID->"a1c862a7-fcb6-2243-a18a-254ed1485296"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.2. RHUFT-informed instrument design principles", "Subsection",ExpressionUUID->"a4f7b2a9-f26a-7640-9713-01c3d324c9f9"],

Cell["\<\
A deeper instrument should attempt to measure not only output value but also:\
\>", "Text",ExpressionUUID->"cea4db6e-7d60-3b4c-bc7a-728a0df09d4b"],

Cell["1. effective resolution band,", "Text",ExpressionUUID->"5cd476fa-1c9a-9a4f-90e7-b50e1d45b5f0"],

Cell["2. induced closure score,", "Text",ExpressionUUID->"088e6ab9-8b8f-3741-be60-d2f50e070ad7"],

Cell["3. coherence retention,", "Text",ExpressionUUID->"23f1bdbd-a888-ec4f-8e90-9d6b09f17518"],

Cell["4. phase-locking sensitivity,", "Text",ExpressionUUID->"6467371c-1cc3-434d-87ee-4a539e0c6639"],

Cell["5. geometry dependence,", "Text",ExpressionUUID->"40478c84-b738-f14a-9fab-38c272aaddf1"],

Cell["6. memory or hysteresis,", "Text",ExpressionUUID->"faefa8bd-3cec-644c-9dc4-4976e3458c4c"],

Cell["7. cross-scale leakage. ", "Text",ExpressionUUID->"17dff9f4-4e01-8847-ad5b-844d820316af"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.3. Proposed meta-measurement vector", "Subsection",ExpressionUUID->"c85ae114-61f0-ee4c-9ce6-41c15ab3c236"],

Cell[TextData[{
 "A measurement event should ideally return: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], ",", "\[CapitalDelta]", 
             StyleBox["v", "TI"], ",", 
             SubscriptBox[
              StyleBox["R", "TI"], "eff"], ",", 
             SubscriptBox[
              StyleBox["c", "TI"], "eff"], ",", 
             SubscriptBox["\[Kappa]", "eff"], ",", 
             SubscriptBox["\[Phi]", "eff"], ",", 
             SubscriptBox[
              StyleBox["h", "TI"], "eff"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathfrak{m} = (v, \\Delta v, R_{\\text{eff}}, c_{\\text{eff}}, \
\\kappa_{\\text{eff}}, \\phi_{\\text{eff}}, h_{\\text{eff}})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "30d9880d-5510-534c-bff5-715d36133d5c"],
 "where: "
}], "Text",ExpressionUUID->"23684446-9598-4b42-9640-5a81d1260d14"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["v", "TI"], TraditionalForm], "errors" -> {}, "input" -> "v", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d0a86a08-ca12-d443-ad27-d2f7d2f74064"],
 " = measured value,"
}], "Item",ExpressionUUID->"6aceddd6-8b2b-824b-b695-1357f8ad78e0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["v", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta v", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "80587288-647e-b248-93a6-e2ce90f1b898"],
 " = uncertainty,"
}], "Item",ExpressionUUID->"b3f7dccb-6635-2c42-aaeb-526fe34f18e7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], "eff"], TraditionalForm], "errors" -> {}, 
     "input" -> "R_{\\text{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e6b9f1f-9711-b743-9dc3-641a7a21dae5"],
 " = effective scale,"
}], "Item",ExpressionUUID->"58ac1fde-e1ff-a749-a259-58bfaf4ff6da"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["c", "TI"], "eff"], TraditionalForm], "errors" -> {}, 
     "input" -> "c_{\\text{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "83a16b0b-dbcc-6b42-8d5b-60d1d41fab39"],
 " = coherence retention,"
}], "Item",ExpressionUUID->"fc5b2cbb-17b2-bd41-b9fd-f73ecc2a2279"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Kappa]", "eff"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\kappa_{\\text{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4941de5b-07fc-f84e-a6b2-77fdfcaebd4e"],
 " = closure induction,"
}], "Item",ExpressionUUID->"608783de-50b0-ef4d-8bb8-6ec68ec80854"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Phi]", "eff"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\phi_{\\text{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ae704c64-1b5e-114b-86c5-b6aae944e56a"],
 " = alignment/phase response,"
}], "Item",ExpressionUUID->"26d507b8-6f95-d44f-8963-34f077532724"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["h", "TI"], "eff"], TraditionalForm], "errors" -> {}, 
     "input" -> "h_{\\text{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dfc92a6b-922a-124a-8569-63a79f09a0a8"],
 " = history dependence."
}], "Item",ExpressionUUID->"e42d62d8-76d2-5640-b73a-e21360371a02"],

Cell["This would be a radically richer science of measurement. ", "Text",ExpressionUUID->"be161a8f-4a12-8a4f-952d-dc229e1d294b"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"975a8ccc-32a2-3840-9bab-4fab4298d23d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["13. Candidate invariant relations to constants", "Section",ExpressionUUID->"f6a78920-89ee-664b-bca2-7c07d1af74c8"],

Cell[CellGroupData[{

Cell["13.1. What an invariant must do", "Subsection",ExpressionUUID->"b1447de4-6bf7-c64d-b1c5-a93831ce894f"],

Cell["A genuine invariant relation should: ", "Text",ExpressionUUID->"c6a47781-1674-e24d-aa27-78ddbd7c3c6b"],

Cell["emerge from the action or closure equations,", "Item",ExpressionUUID->"e568128e-0d7e-2645-b93b-7edf774fcb9f"],

Cell["remain stable under admissible rescaling,", "Item",ExpressionUUID->"9df120f8-cfc6-d44d-b82d-b77cfa68f5b7"],

Cell["correspond to measurable quantities,", "Item",ExpressionUUID->"56049b9b-8728-9843-b0b3-7000277b1cce"],

Cell["avoid arbitrary curve fitting.", "Item",ExpressionUUID->"fa661ade-a56e-8542-892a-4bcc318d0b6b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["13.2. Candidate structural form", "Subsection",ExpressionUUID->"ccfa0037-3ea3-8940-b0c9-0270ee5275d3"],

Cell[TextData[{
 "One exploratory class is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["I", "TI"], "\[LongEqual]", 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           RowBox[{
             FractionBox["\[Chi]", "\[Rho]"], ",", 
             FractionBox[
              StyleBox["R", "TI"], "\[Rho]"], ",", "\[Kappa]", ",", 
             "\[Phi]"}], ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "I = f\\left(\\frac{\\chi}{\\rho},\\frac{R}{\\rho},\\kappa,\\phi\\right)\
", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "828bbe90-8bb3-5241-838e-0a5e0eecaabc"],
 "where stable configurations satisfy: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["I", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], "\[Tau]"}]], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\frac{dI}{d\\tau}=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "938b15bd-bab8-544c-b1b1-429d3199ab54"]
}], "Text",ExpressionUUID->"340dd017-f7dd-2d4e-aca4-4feb5b5c074e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["13.3. 137-type caution", "Subsection",ExpressionUUID->"e8fa11b9-0426-f049-8702-4e2a67e395cc"],

Cell["\<\
The appearance of values near 137 may be mathematically intriguing, but must \
not be overinterpreted unless directly derived from the field equations and \
connected to known observables. \
\>", "Text",ExpressionUUID->"178f99e0-1816-8844-bf8a-85e332cfa343"]
}, Open  ]],

Cell[CellGroupData[{

Cell["13.4. Good scientific discipline", "Subsection",ExpressionUUID->"00aa096a-2763-5141-8a38-fa1af7f9b48e"],

Cell["The correct order is:", "Text",ExpressionUUID->"b396edbd-4bf5-204b-9ace-66ca2b4d41fc"],

Cell["1. derive invariant,", "Text",ExpressionUUID->"76b02b2d-5757-934d-bf86-dd4655725511"],

Cell["2. compute dimensionless value,", "Text",ExpressionUUID->"b6dda22a-a925-2349-94b2-bac61558471f"],

Cell["3. compare with known constants,", "Text",ExpressionUUID->"dc16996c-7d30-fa43-ba33-03db283b766f"],

Cell["4. reject if not robust.", "Text",ExpressionUUID->"c8ffda66-a730-4247-8606-4c610c5b3cec"],

Cell["Not the reverse. ", "Text",ExpressionUUID->"9e141634-703e-df49-bee3-198932b86fb3"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"33e9c05f-5400-d243-a92b-5e222d40ccdd"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["14. Operational derivation logic", "Section",ExpressionUUID->"8cc7be7c-e52b-a244-a7e2-70398b45eb88"],

Cell[CellGroupData[{

Cell["14.1. Deep logic of derivation", "Subsection",ExpressionUUID->"1a5b983d-0c37-6645-b32b-253222fc9233"],

Cell["\<\
A derivation in this framework should proceed from persistence requirements, \
not from arbitrary fitting.\
\>", "Text",ExpressionUUID->"c94547e5-20f7-bb4c-911d-1c37ff6fd625"],

Cell["A proper chain is:", "Text",ExpressionUUID->"6a62ac80-3bbb-5c48-9595-6a89160267a5"],

Cell["1. define the admissible state space,", "Text",ExpressionUUID->"7a9bcaae-39fb-0947-b9a6-1071e6741023"],

Cell["2. define the update/measurement law,", "Text",ExpressionUUID->"a7d45944-9dfd-9845-84ce-0251053d2dea"],

Cell["3. define closure and stability conditions,", "Text",ExpressionUUID->"81ab350b-d937-e044-90d2-eb8dbdd96c65"],

Cell["4. derive stationary and dynamical equations,", "Text",ExpressionUUID->"f47294d7-da2b-6047-af19-6fc3a132a40b"],

Cell["5. identify invariants,", "Text",ExpressionUUID->"22e0d150-ca95-b34f-a594-091ac6d01959"],

Cell["6. compare to experiment. ", "Text",ExpressionUUID->"722ca90d-dc82-4c42-aaec-9ab74943156e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["14.2. Why this matters", "Subsection",ExpressionUUID->"574fe3ab-2bd8-e44b-bac6-cb216f470139"],

Cell["\<\
This prevents the framework from degenerating into symbolic analogy. \
\>", "Text",ExpressionUUID->"259d2489-3952-db46-8333-305707b46fd0"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"de5c10e4-2fc2-7745-bdf5-60d58ecadd67"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["15. A stronger mathematical pipeline", "Section",ExpressionUUID->"0aacea9a-c36b-f848-a6ef-2a6e120a49c6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "realizedAtScaleQ", ",", "closureScore", ",", "driftScore", ",", 
     "coherenceScore", ",", "opfPipeline"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"closureScore", "[", "state_", "]"}], ":=", 
   RowBox[{"Lookup", "[", 
    RowBox[{"state", ",", "\"\<ClosureDensity\>\"", ",", 
     RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coherenceScore", "[", "state_", "]"}], ":=", 
   RowBox[{"Lookup", "[", 
    RowBox[{"state", ",", "\"\<FieldComplexity\>\"", ",", 
     RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"driftScore", "[", "state_", "]"}], ":=", 
    RowBox[{"Lookup", "[", 
     RowBox[{"state", ",", "\"\<Resolution\>\"", ",", 
      RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], "]"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"realizedAtScaleQ", "[", 
     RowBox[{
     "state_", ",", "closureThreshold_", ",", "driftThreshold_", ",", 
      "coherenceThreshold_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
    RowBox[{"TrueQ", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"closureScore", "[", "state", "]"}], ">=", 
       "closureThreshold"}], "&&", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"driftScore", "[", "state", "]"}], "<=", "driftThreshold"}], "&&",
       "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"coherenceScore", "[", "state", "]"}], ">=", 
       "coherenceThreshold"}]}], "\[IndentingNewLine]", "  ", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"opfPipeline", "[", 
    RowBox[{
    "state_", ",", "scale_", ",", "closureThreshold_", ",", "driftThreshold_",
      ",", "coherenceThreshold_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"measurementOp", "[", 
     RowBox[{"state", ",", "scale"}], "]"}], " ", "//", "\[IndentingNewLine]",
     "   ", 
    RowBox[{"Function", "[", 
     RowBox[{"s", ",", "\[IndentingNewLine]", "     ", 
      RowBox[{"Append", "[", 
       RowBox[{"s", ",", 
        RowBox[{"\"\<RealizedQ\>\"", "->", 
         RowBox[{"realizedAtScaleQ", "[", 
          RowBox[{
          "s", ",", "closureThreshold", ",", "driftThreshold", ",", 
           "coherenceThreshold"}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
     "   ", "]"}]}]}], ";"}]}], "Input",ExpressionUUID->"f128c7e2-36f7-6148-\
8ee6-e3514e9b54dd"],

Cell["\<\
This is still schematic, but it defines the architecture for executable \
refinement. \
\>", "Text",ExpressionUUID->"7084741e-0c73-034e-8a6a-fa5021ddf262"],

Cell[BoxData[
 TagBox[GridBox[{
    {
