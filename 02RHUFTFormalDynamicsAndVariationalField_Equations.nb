Cell[CellGroupData[{

Cell["\<\
6. Why current measurement theory is insufficient for this framework\
\>", "Section",ExpressionUUID->"65dd906c-4c62-cf40-be83-142c27c87037"],

Cell[CellGroupData[{

Cell["6.1. Standard limitations", "Subsection",ExpressionUUID->"a82f84da-3e91-ce4e-b757-a4323bad729e"],

Cell["Standard measurement practice often treats: ", "Text",ExpressionUUID->"dabe8feb-512a-8b42-92dd-088dbf183828"],

Cell["apparatus as external,", "Item",ExpressionUUID->"50768263-8867-dc44-bc40-f42aaa40334c"],

Cell["scale as a nuisance parameter,", "Item",ExpressionUUID->"4ac1563c-a9d8-f044-bc46-40728076548a"],

Cell["backreaction as secondary,", "Item",ExpressionUUID->"51c43c69-5d30-3d40-b515-9fdc21241a07"],

Cell["geometry as merely instrumental,", "Item",ExpressionUUID->"f9689da9-f61d-7447-b912-323953dbe174"],

Cell["observables as pre-defined.", "Item",ExpressionUUID->"8ed5a9cb-0d52-c14a-be6c-ef7d3ad189a4"],

Cell["\<\
RHUFT instead suggests that what can be observed depends on whether the \
system-apparatus interaction creates a persistent closure channel. \
\>", "Text",ExpressionUUID->"646c289c-6679-704f-857f-ea237744876c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.2. Reformulated measurement law", "Subsection",ExpressionUUID->"4c373b22-92cd-254a-8d2e-6b3f4f0993c3"],

Cell["A more complete law is: ", "Text",ExpressionUUID->"a83b5193-c289-a442-84b8-6aeec1025381"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"a measurement is successful when the interaction between \
field, interface, and readout generates a low-drift, high-coherence, \
closure-sustaining informational state at a chosen scale.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"0c66fa34-cee0-e541-a323-be5cd77dee44"],

Cell[TextData[{
 "This means a measurement is not simply \[OpenCurlyDoubleQuote]read value \
from world,\[CloseCurlyDoubleQuote] but: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "measurement", "\[LongEqual]", 
         "stabilized relational transformation"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\text{measurement} = \\text{stabilized relational transformation}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "93a0a73d-cc5c-c349-8154-b6fc01cae393"]
}], "Text",ExpressionUUID->"d2f02d7f-c0b9-b844-a77e-b1d23e07d3a3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.3. Deep operational consequence", "Subsection",ExpressionUUID->"7b84c6a8-7b76-c44f-959a-692eff98b815"],

Cell["\<\
An instrument should be characterized not only by precision and accuracy, but \
also by: \
\>", "Text",ExpressionUUID->"49330cee-e56d-e441-a7d2-28f3742b0fc9"],

Cell["closure induction capacity,", "Item",ExpressionUUID->"3fe30ec7-0ee3-b14a-86ad-f96be6a4c936"],

Cell["cross-scale contamination,", "Item",ExpressionUUID->"37d82ffe-dc3b-f640-82b8-4d2e73fc6644"],

Cell["geometry of coupling,", "Item",ExpressionUUID->"752094f1-94ac-b84f-9536-06d2626c6266"],

Cell["phase selectivity,", "Item",ExpressionUUID->"1ea2bd3d-daae-a444-abc2-17f729dea373"],

Cell["memory persistence,", "Item",ExpressionUUID->"dbdaf71b-8408-7746-8276-7ba430a30d85"],

Cell["attractor bias.", "Item",ExpressionUUID->"d70c3871-a482-ce4a-9f09-9564a1e1729a"],

Cell["This is a major reinterpretation of metrology. ", "Text",ExpressionUUID->"10cd8c77-1ddc-bb4f-b65e-8781290213b6"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
