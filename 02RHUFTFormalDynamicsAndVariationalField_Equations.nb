      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"308a000f-0ee9-0540-9d3f-0f28cfd2eff1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["16. Boundary conditions and PDE modeling remarks", "Section",ExpressionUUID->"46d66e26-b519-a54c-8c35-f06c08393198"],

Cell["\<\
If the field is promoted to a PDE model, boundary conditions become \
essential. Candidate conditions include: \
\>", "Text",ExpressionUUID->"66a9f8cc-4654-214f-b708-ab8260f27679"],

Cell[TextData[{
 ButtonBox["DirichletCondition",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/DirichletCondition"],
 " for fixed boundary values,"
}], "Item",ExpressionUUID->"c60ad937-7456-fa47-84c2-fb4e2eca8def"],

Cell[TextData[{
 ButtonBox["NeumannValue",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NeumannValue"],
 " for flux-like conditions,"
}], "Item",ExpressionUUID->"1b2838af-cdcb-d449-9be1-d903dc99be3e"],

Cell[TextData[{
 ButtonBox["PeriodicBoundaryCondition",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PeriodicBoundaryCondition"],
 " for cyclic geometries."
}], "Item",ExpressionUUID->"fa47e6b4-b31e-fb47-ba44-4ab95b26a199"],

Cell[TextData[{
 "For geometric PDE work, see ",
 ButtonBox["PDE Models Overview",
  BaseStyle->"Link",
  ButtonData->"paclet:PDEModels/tutorial/PDEModelsOverview"],
 " and ",
 ButtonBox["Partial Differential Equations",
  BaseStyle->"Link",
  ButtonData->"paclet:guide/PDEModelingAndAnalysis"],
 ". "
}], "Text",ExpressionUUID->"be5c0137-a9a9-e845-a8e8-63020a20f809"],

