    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"6ef03f95-b030-834e-ba79-6ccdb557d33b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Linearization and stability analysis", "Section",ExpressionUUID->"190b7706-20e2-474b-8cc9-a4ad275a5d94"],

Cell[CellGroupData[{

Cell["8.1. Why linearization matters", "Subsection",ExpressionUUID->"a8702421-243b-9145-8d74-2058ad914970"],

Cell["\<\
To identify persistent modes, we expand around an equilibrium solution.\
\>", "Text",ExpressionUUID->"34f3965c-3699-1041-bdcc-75bf5f5fc52e"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["q", "TI"], "0"], "+", "\[Delta]", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "q = q_0 + \\delta q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be22318b-b5c4-ff47-91fb-c87a81db3e38"],
 "for each field variable ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["q", "TI"], TraditionalForm], "errors" -> {}, "input" -> "q", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0ef41f2-2a2c-cd40-8406-3d46e0bfc94b"],
 ". "
}], "Text",ExpressionUUID->"95fade6d-6b15-0a42-ac02-67577619bda5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.2. Quadratic expansion", "Subsection",ExpressionUUID->"b9fbe19b-aa78-f841-ae4d-d65cca2fd10e"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", FontSlant -> "Bold"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"], ",", "\[Phi]", ",", "\[Kappa]", ",", 
             StyleBox["m", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\mathbf{q}=(\\rho,\\chi,R,\\phi,\\kappa,m)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8a8bc060-5e0d-9143-b571-9655801b5d76"],
 ", then near equilibrium: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           StyleBox["q", FontSlant -> "Bold"], ")"}], "\[TildeTilde]", 
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["q", FontSlant -> "Bold"], "0"], ")"}], "+", 
         FractionBox["1", "2"], "\[Delta]", 
         SuperscriptBox[
          StyleBox["q", FontSlant -> "Bold"], 
          StyleBox["T", "TI"]], 
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["q", FontSlant -> "Bold"], "0"], ")"}], "\[Delta]", 
         StyleBox["q", FontSlant -> "Bold"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathcal{L}(\\mathbf{q}) \\approx \\mathcal{L}(\\mathbf{q}_0) + \
\\frac{1}{2}\\delta\\mathbf{q}^T H(\\mathbf{q}_0)\\delta\\mathbf{q}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e468e0fa-8a33-cd46-92df-c19b7f1511bc"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e7189f0b-7a61-c149-893d-ffb7cf929443"],
 " is the Hessian of the potential or effective energy. "
}], "Text",ExpressionUUID->"36bf5b06-cca6-9043-acf2-c078a68f19fb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.3. Stable modes", "Subsection",ExpressionUUID->"3aeded98-a4dd-ed4e-8859-53b3e62c6322"],

Cell[TextData[{
 "Oscillatory or persistent modes arise from the eigenstructure of the \
linearized operator. In your OPF directives, stable frequencies were \
associated with eigenvalues satisfying: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[GothicCapitalR]", 
         RowBox[{"(", "\[Lambda]", ")"}], "\[LongEqual]", "0", ",    ", 
         "\[GothicCapitalI]", 
         RowBox[{"(", "\[Lambda]", ")"}], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Re(\\lambda)=0, \\qquad \\Im(\\lambda)>0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "057cd94f-3700-474e-bc60-b6536cb62d06"],
 "This may be adapted depending on whether the evolution law is conservative, \
dissipative, or mixed. "
}], "Text",ExpressionUUID->"db191b0a-aab8-eb41-b31a-735a09b23895"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.4. Symbolic Hessian example", "Subsection",ExpressionUUID->"d65e7914-2d63-0f46-b742-100b2018da43"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "rho0", ",", "chi0", ",", "res0", ",", "phase0", ",", "closure0", ",", 
     "memory0", ",", "vars", ",", "effectivePotential", ",", 
     "stiffnessMatrix"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vars", "=", 
    RowBox[{"{", 
     RowBox[{
     "rho0", ",", "chi0", ",", "res0", ",", "phase0", ",", "closure0", ",", 
      "memory0"}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"effectivePotential", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"lambdaG", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"chi0", "/", "rho0"}], "-", "goldenRatio"}], ")"}], "^", 
       "2"}]}], "+", "\[IndentingNewLine]", "  ", 
     RowBox[{"lambdaS", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"res0", "/", "rho0"}], "-", "silverRatio"}], ")"}], "^", 
       "2"}]}], "+", "\[IndentingNewLine]", "  ", 
     RowBox[{"lambdaTheta", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cos", "[", "phase0", "]"}], "-", 
         RowBox[{"Cos", "[", "goldenAngle", "]"}]}], ")"}], "^", "2"}]}], "+",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "muClosure"}], " ", 
        RowBox[{"closure0", "^", "2"}]}], "+", 
       RowBox[{"nuClosure", " ", 
        RowBox[{"closure0", "^", "4"}]}]}], ")"}], "+", "\[IndentingNewLine]",
      "  ", 
     RowBox[{"lambdaMemory", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"memory0", "-", 
         RowBox[{"alphaMemory", " ", "closure0"}]}], ")"}], "^", "2"}]}], "+",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"etaRhoClosure", " ", "rho0", " ", "closure0"}], "+", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"etaChiPhase", " ", "chi0", " ", 
      RowBox[{"Cos", "[", "phase0", "]"}]}], "+", "\[IndentingNewLine]", "  ", 
     RowBox[{"etaResClosure", " ", "res0", " ", "closure0"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stiffnessMatrix", "=", 
   RowBox[{"D", "[", 
    RowBox[{"effectivePotential", ",", 
     RowBox[{"{", 
      RowBox[{"vars", ",", "2"}], "}"}]}], "]"}]}], ";"}]}], "Input",Expressio\
nUUID->"fa636fbd-4b7e-dd49-ab66-ce8aa325f41a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.5. Eigenmode extraction", "Subsection",ExpressionUUID->"48787f12-3913-d243-b412-a645b5128879"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"eigenvalues", ",", "eigenvectors"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"eigenvalues", ",", "eigenvectors"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", "stiffnessMatrix", "]"}]}], ";"}]}], "Input",Ex\
pressionUUID->"be928b84-dfd7-d847-a546-d02ef91f419f"],

Cell["\<\
This yields candidate local mode structure pending substitution of \
equilibrium conditions. \
\>", "Text",ExpressionUUID->"45edea9d-4334-7544-94b3-bef2c78db650"],

