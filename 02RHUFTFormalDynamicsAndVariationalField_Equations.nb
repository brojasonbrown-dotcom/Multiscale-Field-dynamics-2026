Cell[CellGroupData[{

Cell["7. A measurement operator algebra", "Section",ExpressionUUID->"db766715-c8cb-b449-9868-8a30afe39484"],

Cell[CellGroupData[{

Cell["7.1. Operator decomposition", "Subsection",ExpressionUUID->"f06fd6ad-f08a-5d40-85f9-a55f8834ae75"],

Cell[TextData[{
 "A measurement process can be written as a composition: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], "\[Sigma]"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["R", "TI"], "\[Sigma]"], "\[EmptySmallCircle]", 
         SubscriptBox[
          StyleBox["C", "TI"], "\[Sigma]"], "\[EmptySmallCircle]", 
         SubscriptBox[
          StyleBox["A", "TI"], "\[Sigma]"], "\[EmptySmallCircle]", 
         SubscriptBox[
          StyleBox["I", "TI"], "\[Sigma]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathcal{M}_\\sigma = \\mathcal{R}_\\sigma \\circ \\mathcal{C}_\\sigma \
\\circ \\mathcal{A}_\\sigma \\circ \\mathcal{I}_\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a789ee0f-76b4-0645-9eaa-7352179c305a"],
 "where: "
}], "Text",ExpressionUUID->"8058e7f5-6ecf-e940-aa7f-549bcda59b88"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["I", "TI"], "\[Sigma]"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{I}_\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4dce7250-5a19-b747-90c3-cfe8a890a713"],
 " = interaction operator,"
}], "Item",ExpressionUUID->"8a411e0f-5689-904a-bf05-f8e73fde7f43"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["A", "TI"], "\[Sigma]"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{A}_\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d580f20f-5f8a-104b-b094-baf63cb7ae10"],
 " = alignment or phase-selection operator,"
}], "Item",ExpressionUUID->"f5e39960-9ac2-0749-b214-aa59c6c3be05"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["C", "TI"], "\[Sigma]"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{C}_\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "28950d36-f7dc-e849-ab61-2ff2a3a649a0"],
 " = closure stabilization operator,"
}], "Item",ExpressionUUID->"bb3d9a21-b418-b745-8290-01b3d301867d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], "\[Sigma]"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{R}_\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4fde085-ed60-e140-8775-238053db5137"],
 " = readout projection."
}], "Item",ExpressionUUID->"4e9287e0-8f95-3544-a2f7-f71398e3fe7d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2. Wolfram Language skeleton", "Subsection",ExpressionUUID->"69814b19-ffde-2c41-8b10-2a6bccdae128"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "interactionOp", ",", "alignmentOp", ",", "closureOp", ",", "readoutOp", ",",
      "measurementOp"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"interactionOp", "[", 
    RowBox[{"state_", ",", "scale_"}], "]"}], ":=", 
   RowBox[{"Append", "[", 
    RowBox[{"state", ",", 
     RowBox[{"\"\<InteractionScale\>\"", "->", "scale"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"alignmentOp", "[", "state_", "]"}], ":=", 
   RowBox[{"Append", "[", 
    RowBox[{"state", ",", 
     RowBox[{"\"\<Aligned\>\"", "->", "True"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"closureOp", "[", "state_", "]"}], ":=", 
   RowBox[{"Append", "[", 
    RowBox[{"state", ",", 
     RowBox[{"\"\<ClosureUpdated\>\"", "->", "True"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"readoutOp", "[", "state_", "]"}], ":=", 
    RowBox[{"KeyTake", "[", 
     RowBox[{"state", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<InformationDensity\>\"", ",", "\"\<FieldComplexity\>\"", 
        ",", "\"\<Resolution\>\"", ",", "\"\<ClosureDensity\>\""}], "}"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementOp", "[", 
    RowBox[{"state_", ",", "scale_"}], "]"}], ":=", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"state", " ", "//", "\[IndentingNewLine]", "   ", 
       RowBox[{
        RowBox[{"interactionOp", "[", 
         RowBox[{"#", ",", "scale"}], "]"}], " ", "&"}]}], " ", "//", 
      "\[IndentingNewLine]", "   ", "alignmentOp"}], " ", "//", 
     "\[IndentingNewLine]", "   ", "closureOp"}], " ", "//", 
    "\[IndentingNewLine]", "   ", "readoutOp"}]}], ";"}]}], "Input",Expression\
UUID->"5503a29f-90bc-ae4e-a355-8dd899afcdd7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.3. Proper interpretation", "Subsection",ExpressionUUID->"11c3cca7-988d-9148-9deb-05710d29df1b"],

Cell["\<\
This is a conceptual algebraic decomposition, not yet a calibrated physical \
model. \
\>", "Text",ExpressionUUID->"e2d2572c-a6d9-e14a-ba2b-1d927fb53ccb"],

