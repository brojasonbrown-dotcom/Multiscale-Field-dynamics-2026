Cell[CellGroupData[{

Cell["1. Measurement before physics", "Section",ExpressionUUID->"b9c4b452-0861-d345-9f36-be1c99838256"],

Cell[CellGroupData[{

Cell["1.1. Why measurement must be formalized first", "Subsection",ExpressionUUID->"4459aa83-6540-604c-a708-7df1f97bbc6d"],

Cell["\<\
In ordinary physics, one often starts with equations of motion and then \
defines measurement afterward through observables, apparatus, and probability \
rules.\
\>", "Text",ExpressionUUID->"ee8c5093-4857-964a-8678-33289f52f29c"],

Cell["\<\
In RHUFT-style ontology, that order is reversed or at least made symmetric: \
\>", "Text",ExpressionUUID->"81100368-eb34-4548-a91e-152f0ba269b6"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"dynamics and measurement must be co-defined, because what \
persists as a physical state is inseparable from how the field recursively \
distinguishes and stabilizes itself.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"b625bc25-c865-7b41-9c03-77868f87f1dc"],

Cell[TextData[{
 "This does ",
 StyleBox["not",
  FontWeight->Bold],
 " mean that human observers create the universe."
}], "Text",ExpressionUUID->"713d1eb9-8430-2f4c-8a11-6e1319c29dcd"],

Cell[TextData[{
 "It means that ",
 StyleBox["distinguishability, persistence, and observability are \
structurally linked",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"829279fd-fd8c-104f-a82b-119622948d63"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.2. Deep measurement principle", "Subsection",ExpressionUUID->"73fe5d70-2b07-6a49-97ec-b6726c90955e"],

Cell["We define a strong measurement principle: ", "Text",ExpressionUUID->"8a9438ca-643b-de4e-b4a8-ed0a14b4cd97"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"A state is physically meaningful only insofar as it can \
enter a recursively stable distinction process.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"6b72ba4d-ae70-b642-808e-54716075bac9"],

Cell["\<\
This turns measurement from a laboratory afterthought into an ontological \
filter. \
\>", "Text",ExpressionUUID->"d72bb88b-07b3-e749-8d88-5b66166cab73"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.3. Three notions of measurement", "Subsection",ExpressionUUID->"74c7caea-7c20-5d48-8621-5754275acd6e"],

Cell["We must distinguish at least three layers: ", "Text",ExpressionUUID->"d590db2c-4b2d-8a41-8c4c-ae091feba039"],

Cell[CellGroupData[{

Cell["Ontological measurement", "Subsubsection",ExpressionUUID->"d8084d3e-a547-284b-80e0-6a516c35e951"],

Cell["The field differentiates itself from alternative states. ", "Text",ExpressionUUID->"5e2207be-3da4-ee42-bdb4-0e92d6cd94fa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Physical measurement", "Subsubsection",ExpressionUUID->"351e80c6-f5ff-9247-840f-121bf3af4802"],

Cell["\<\
An interaction stabilizes a subset of state variables into persistent \
observables. \
\>", "Text",ExpressionUUID->"e4f6f52a-95a6-724e-a937-0bf07e4ddd2b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Instrumental measurement", "Subsubsection",ExpressionUUID->"3f43c871-9457-a842-b5e4-d0e58b5d4e0f"],

Cell["\<\
An engineered apparatus maps physical observables into symbolic outputs.\
\>", "Text",ExpressionUUID->"04b2bbd4-69bc-b244-9c4b-d2b7c7d9e5dc"],

Cell["These are related but not identical. ", "Text",ExpressionUUID->"2dd55aa8-3732-b643-913c-0390a2d7c7c9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.4. How we should be measuring", "Subsection",ExpressionUUID->"363a94ac-2bc4-9c49-a93b-336d6efa9d15"],

Cell["\<\
If RHUFT is correct in any substantive sense, then current measurement \
practice is incomplete whenever it assumes: \
\>", "Text",ExpressionUUID->"61b80b04-3c92-cc41-bcb7-f0034b9d4cb5"],

Cell["scale-independent observability,", "Item",ExpressionUUID->"4f817662-0f54-2a46-98ad-d8b2a53df6be"],

Cell["separability of observer and measured system in all regimes,", "Item",ExpressionUUID->"64f67610-bb04-e540-a349-1c09c056080a"],

Cell["no role for recursive stabilization,", "Item",ExpressionUUID->"ed487ffb-b9fe-ef49-8f81-8cb588c7aeda"],

Cell["no role for geometry of closure,", "Item",ExpressionUUID->"0290ba4a-b094-d142-9cfa-405d5a78bf5c"],

Cell["no structured ontology behind constants.", "Item",ExpressionUUID->"1a78f1fc-82d6-114a-a1b2-b1918e164b0f"],

Cell["A better measurement program should explicitly track:", "Text",ExpressionUUID->"fded4768-6e4d-2e4b-93b5-956944a27263"],

Cell[TextData[{
 "1. ",
 StyleBox["resolution",
  FontWeight->Bold],
 ","
}], "Text",ExpressionUUID->"f7e9b7f2-ffbe-794f-bcf5-ff6eae4cf48d"],

Cell[TextData[{
 "2. ",
 StyleBox["backreaction",
  FontWeight->Bold],
 ","
}], "Text",ExpressionUUID->"321cbc66-74d0-ff42-b085-a98ab5c8fdba"],

Cell[TextData[{
 "3. ",
 StyleBox["closure persistence",
  FontWeight->Bold],
 ","
}], "Text",ExpressionUUID->"9eac7418-bd24-8046-af7f-8096da90562d"],

Cell[TextData[{
 "4. ",
 StyleBox["cross-scale coherence",
  FontWeight->Bold],
 ","
}], "Text",ExpressionUUID->"4c61c786-5a26-dc4a-9c21-903f04a1bc1f"],

Cell[TextData[{
 "5. ",
 StyleBox["geometry of the measurement interface",
  FontWeight->Bold],
 ","
}], "Text",ExpressionUUID->"cdb52284-456e-3642-8894-db661905e76f"],

Cell[TextData[{
 "6. ",
 StyleBox["information loss under coarse-graining",
  FontWeight->Bold],
 ","
}], "Text",ExpressionUUID->"393cb71e-5a92-984b-a609-4a559f263926"],

Cell[TextData[{
 "7. ",
 StyleBox["whether the measured quantity is stable only in a particular \
observational band",
  FontWeight->Bold],
 "."
}], "Text",ExpressionUUID->"ee4b6556-ba34-5447-bbc6-f2ccc17cc9c2"],

Cell[TextData[{
 "This means that measurement should be redesigned as ",
 StyleBox["multiscale structured interrogation",
  FontWeight->Bold],
 ", not just signal extraction. "
}], "Text",ExpressionUUID->"579e806b-50fd-3341-a765-4e7eea249fd2"],

