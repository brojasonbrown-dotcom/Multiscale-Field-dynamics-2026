Cell[CellGroupData[{

Cell["6. Measurement state reporting", "Section",ExpressionUUID->"d0009054-a493-1e47-9a45-a1e1ea47e175"],

Cell[CellGroupData[{

Cell["6.1. Proposed reporting vector", "Subsection",ExpressionUUID->"10b5428b-90ef-0a4c-841b-4aca8d34f682"],

Cell[TextData[{
 "Instead of reporting only a value ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["v", "TI"], TraditionalForm], "errors" -> {}, "input" -> "v", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6828eae1-b560-3748-b748-aff86d6493b7"],
 " and uncertainty ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["v", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta v", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "49c29d54-8141-7e4b-82cf-700b17c0b466"],
 ", a richer report should include: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], ",", "\[CapitalDelta]", 
             StyleBox["v", "TI"], ",", 
             SubscriptBox["\[Sigma]", 
              StyleBox["eff", FontSlant -> "Plain"]], ",", 
             SubscriptBox[
              StyleBox["c", "TI"], 
              StyleBox["eff", FontSlant -> "Plain"]], ",", 
             SubscriptBox["\[Kappa]", 
              StyleBox["eff", FontSlant -> "Plain"]], ",", 
             SubscriptBox["\[Phi]", 
              StyleBox["eff", FontSlant -> "Plain"]], ",", 
             SubscriptBox[
              StyleBox["h", "TI"], 
              StyleBox["eff", FontSlant -> "Plain"]], ",", 
             SubscriptBox[
              StyleBox["g", "TI"], 
              StyleBox["int", FontSlant -> "Plain"]]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathfrak{m} = (v, \\Delta v, \\sigma_{\\mathrm{eff}}, \
c_{\\mathrm{eff}}, \\kappa_{\\mathrm{eff}}, \\phi_{\\mathrm{eff}}, \
h_{\\mathrm{eff}}, g_{\\mathrm{int}})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "47a50ea5-a319-7f4c-944a-80a0bb4995a7"],
 "where: "
}], "Text",ExpressionUUID->"21ccf501-3262-a942-bc1c-30a0f0b55049"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["v", "TI"], TraditionalForm], "errors" -> {}, "input" -> "v", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "91a6880c-81c8-4240-a754-892a648225a0"],
 " = measured value,"
}], "Item",ExpressionUUID->"4c67b871-c82f-174f-9f03-c914fde6a3a5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["v", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta v", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c5603d4-eb2e-a748-bbde-28a8b189ca09"],
 " = uncertainty,"
}], "Item",ExpressionUUID->"d9867557-8d5c-7e47-ad03-405b81d0a347"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Sigma]", 
        StyleBox["eff", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sigma_{\\mathrm{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "261eb051-1f1a-634e-aca7-4d31650dc389"],
 " = effective resolution band,"
}], "Item",ExpressionUUID->"da280ff0-dec6-2a48-82c7-14295ec084b7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["c", "TI"], 
        StyleBox["eff", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "c_{\\mathrm{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1572f9ee-e68c-9949-9f1b-869fb6a2a491"],
 " = effective coherence retention,"
}], "Item",ExpressionUUID->"de0295a5-ab6f-bf45-bef9-c204b277f393"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Kappa]", 
        StyleBox["eff", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "\\kappa_{\\mathrm{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9168d87f-1b78-0643-8b8a-2e4a5a70f853"],
 " = effective closure induction,"
}], "Item",ExpressionUUID->"1940c3eb-d41b-cf40-bd55-d5111e5d48a6"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Phi]", 
        StyleBox["eff", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "\\phi_{\\mathrm{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1213e2d2-733b-504d-92fd-b0366467c400"],
 " = phase-locking response,"
}], "Item",ExpressionUUID->"fe367f9e-0b78-6a48-a567-6481c1c3fce9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["h", "TI"], 
        StyleBox["eff", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "h_{\\mathrm{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "540257c5-695e-ee46-a6fb-5babb59d5d4f"],
 " = history dependence,"
}], "Item",ExpressionUUID->"548d3171-c600-034e-9184-72af990eb2c1"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["g", "TI"], 
        StyleBox["int", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "g_{\\mathrm{int}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6cc6e0b6-b9be-3c46-8431-76d86a6966b1"],
 " = interface geometry descriptor."
}], "Item",ExpressionUUID->"bae65054-cac6-7c49-a886-fe824c1940a2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.2. Why this is transformative", "Subsection",ExpressionUUID->"cd535f09-e13b-4c42-9207-174876748738"],

Cell["\<\
Two instruments can report the same scalar value while having profoundly \
different stabilization pathways. If those pathways matter, then current \
practice is erasing physically relevant structure. \
\>", "Text",ExpressionUUID->"f8135eb1-c79b-bf40-a337-6bcead4a0f8e"],

Cell[BoxData[
 TagBox[GridBox[{
    {
