Cell[CellGroupData[{

Cell["9. Backreaction must be tracked explicitly", "Section",ExpressionUUID->"82898834-f0ce-d34e-98b1-5b0d82f0fb65"],

Cell[CellGroupData[{

Cell["9.1. Conventional treatment", "Subsection",ExpressionUUID->"f2674f30-53ad-eb43-9a15-70b4d3c0df06"],

Cell["\<\
Backreaction is acknowledged in sensitive domains, but often treated as a \
nuisance rather than a constitutive part of measurement. \
\>", "Text",ExpressionUUID->"d108a69c-48b2-fa4d-b4d5-3e5b38f0fa8f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.2. RHUFT treatment", "Subsection",ExpressionUUID->"ac11cb9e-0df6-b549-9502-3a10ebd2ae33"],

Cell["\<\
Backreaction is part of measurement identity. It helps determine which modes \
survive into observability. \
\>", "Text",ExpressionUUID->"5a5bcc39-9a38-5744-8c38-7071c0af364b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.3. Practical consequence", "Subsection",ExpressionUUID->"192faa1a-aca7-a443-84cc-2ff8c4ba1012"],

Cell["\<\
Every serious experiment should report a backreaction profile, not merely a \
system preparation and uncertainty bar.\
\>", "Text",ExpressionUUID->"a2d0271a-966b-c347-b564-5e1efb5bf68b"],

Cell["A backreaction profile should ideally estimate: ", "Text",ExpressionUUID->"0d4ff506-023d-9e48-95fe-1d5076aef40c"],

Cell["injected energy,", "Item",ExpressionUUID->"52fcefe4-aeac-1249-841c-e9478a17a052"],

Cell["phase disturbance,", "Item",ExpressionUUID->"7eb63aaf-01c8-d14e-bcd4-05733046cd11"],

Cell["coherence loss,", "Item",ExpressionUUID->"7ea6c163-5e39-b74b-974d-159e133fd96c"],

Cell["closure disruption or reinforcement,", "Item",ExpressionUUID->"7b4a0d4b-e69e-c74f-8989-b9a04020eeca"],

Cell["recovery time,", "Item",ExpressionUUID->"4430b7aa-686b-1d4f-ad02-3d977a66e2f7"],

Cell["hysteretic drift.", "Item",ExpressionUUID->"1982a766-a21b-1043-9efa-d006d7e7f9ef"],

