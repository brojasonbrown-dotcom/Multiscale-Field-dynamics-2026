}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["12. How this changes the scientific method", "Section",ExpressionUUID->"cad1dd33-439d-c740-800e-21dcd7c23152"],

Cell[CellGroupData[{

Cell["12.1. Current workflow", "Subsection",ExpressionUUID->"c1ce92ac-40e3-4343-9cd0-22186726a000"],

Cell["A rough current workflow is:", "Text",ExpressionUUID->"51c888eb-95e2-4a41-94fd-876c9e5643af"],

Cell["1. define target quantity,", "Text",ExpressionUUID->"729575a9-e46f-1c44-b6da-0bde0f4ae310"],

Cell["2. build instrument,", "Text",ExpressionUUID->"d5036d67-4ae3-c94a-9607-427d8d78d8c3"],

Cell["3. calibrate,", "Text",ExpressionUUID->"ac761fe2-4e4a-044f-9889-10af293163e6"],

Cell["4. acquire values,", "Text",ExpressionUUID->"6662f17b-13a4-7e42-9664-aed11a76dbb9"],

Cell["5. fit theory. ", "Text",ExpressionUUID->"ae724162-2ece-104e-88d5-e541a1e01af9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.2. RHUFT-augmented workflow", "Subsection",ExpressionUUID->"23929637-8f8c-9e43-8fe1-5dcfd6fba053"],

Cell["A deeper workflow becomes:", "Text",ExpressionUUID->"39f46e51-f294-684b-81e6-a165fcae3abe"],

Cell["1. define target interaction class,", "Text",ExpressionUUID->"a2dfd45c-efca-d049-8bd5-d11db6702ac2"],

Cell["2. identify likely stabilization channels,", "Text",ExpressionUUID->"3fd9e591-a59d-fb4f-9fe3-e709a4f826e2"],

Cell["3. design geometry of access,", "Text",ExpressionUUID->"52ced4e9-2ab4-3e4d-9ab3-99adf71effee"],

Cell["4. characterize backreaction profile,", "Text",ExpressionUUID->"60f9fca8-bfdf-6b4e-ac9f-6f03785516e8"],

Cell["5. characterize effective resolution band,", "Text",ExpressionUUID->"d404b8a1-7723-b040-b830-9acf2f21f67e"],

Cell["6. record measurement-state vector,", "Text",ExpressionUUID->"fbe1dc8f-c9f7-5641-8dd7-03a4765e4829"],

Cell["7. compare across alternate interface topologies,", "Text",ExpressionUUID->"feaf0532-17c8-9749-aed3-10ad5886ace1"],

Cell["\<\
8. infer invariant structure only after multichannel agreement. \
\>", "Text",ExpressionUUID->"8e646fd3-034c-b74a-b1b8-81a8b438a3b9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.3. Meaning", "Subsection",ExpressionUUID->"aaf10697-2a33-024e-8edd-506bcf168499"],

Cell[TextData[{
 "Science shifts from ",
 StyleBox["scalar measurement",
  FontWeight->Bold],
 " to ",
 StyleBox["structured measurement ecology",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"0106d528-eaf0-c34a-9141-45181a812590"],

