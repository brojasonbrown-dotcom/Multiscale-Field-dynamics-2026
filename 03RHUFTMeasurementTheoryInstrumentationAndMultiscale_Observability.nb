    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"30e8c762-0052-db4f-86b3-794985cb0478"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. What current science often leaves implicit", "Section",ExpressionUUID->"e9428db8-162a-4f40-b84d-d3bfbabe0867"],

Cell[CellGroupData[{

Cell["5.1. Hidden assumption 1: scale transparency", "Subsection",ExpressionUUID->"135422ac-27c7-8a47-b286-c43647b6f9e6"],

Cell["\<\
Many experiments assume that the measured quantity is invariant under the \
details of the access scale, or that scale can be treated as merely technical.\
\>", "Text",ExpressionUUID->"7fc82297-e195-f540-83fd-5c1a52183341"],

Cell["RHUFT replaces this with: ", "Text",ExpressionUUID->"08dd0496-88da-3349-bcaf-f27eba1773e6"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"the observable is often partly constituted by the scale band \
under which it stabilizes.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
