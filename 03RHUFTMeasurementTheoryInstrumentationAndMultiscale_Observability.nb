 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"8d417579-e314-f447-bb81-b28212a9dd24"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. A rigorous definition of measurement", "Section",ExpressionUUID->"bcbc3f45-44ac-b548-80ab-b965464abb60"],

Cell["We define a measurement event as follows.", "Text",ExpressionUUID->"998422f6-ac1d-b24e-b10d-1c8e3416375d"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalPsi]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Psi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "64879f6b-4302-9449-b34d-c70b698ee40d"],
 " be the local field state, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalXi]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Xi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dfa16e42-c41c-9542-9226-ee46232bd902"],
 " the interface state, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Sigma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7198bf10-efe1-624f-96e3-eda7e1b2e4ac"],
 " the accessible scale band, and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["h", "TI"], TraditionalForm], "errors" -> {}, "input" -> "h", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1541c2c0-333b-5241-b4c3-ed68988dece1"],
 " the interaction history."
}], "Text",ExpressionUUID->"ffa05cb5-bcff-8147-bbff-028d8f51b578"],

Cell[TextData[{
 "Then a measurement event is the production of a reportable observable ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["o", "TI"], TraditionalForm], "errors" -> {}, "input" -> "o", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3dc96aad-7549-fc40-b120-141b29878dc9"],
 " through a map: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["o", "TI"], "\[LongEqual]", 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[CapitalPsi]", ",", "\[CapitalXi]", ",", "\[Sigma]", ",", 
             StyleBox["h", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "o = \\mathcal{M}(\\Psi, \\Xi, \\sigma, h)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9926f4ab-d458-174f-bbad-0d90ea2a1f3b"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["o", "TI"], TraditionalForm], "errors" -> {}, "input" -> "o", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d42e6d7-8c78-dd40-81dc-39bf4db5fd83"],
 " is required to satisfy:"
}], "Text",ExpressionUUID->"3ff19dfb-a8a5-2246-b9c5-6536419af7c2"],

Cell["1. repeatability under admissible preparation,", "Text",ExpressionUUID->"e0690d57-d3f6-7e4e-8c48-073bab150013"],

Cell["2. distinguishability from alternatives,", "Text",ExpressionUUID->"59091f6f-1f34-074a-8333-d4d87157cffc"],

Cell["3. stability over the readout interval,", "Text",ExpressionUUID->"f3ff5da3-b8ad-4041-bb18-eb86ed1efdc5"],

Cell["4. transducibility into a persistent record.", "Text",ExpressionUUID->"eba83b74-1b79-814e-b0f1-8cc6420c1bbf"],

Cell["\<\
This definition explicitly includes interface, scale, and history. \
\>", "Text",ExpressionUUID->"9aafd572-783f-d04d-9b33-c02421e24d4d"],

