Cell[CellGroupData[{

Cell["11. Biological senses as scale-locked measurement systems", "Section",ExpressionUUID->"7fe8ec0b-6a82-c140-a97e-04ed112ab930"],

Cell[CellGroupData[{

Cell["11.1. Main idea", "Subsection",ExpressionUUID->"fed9731b-3038-fc47-800c-c4cd6a793a5e"],

Cell["\<\
Organisms do not measure all of reality. They stabilize a narrow subset of it.\
\>", "Text",ExpressionUUID->"ccd7e347-10cf-5d44-abdc-6e510011c905"],

Cell["Each sense is a scale-locked transduction channel. ", "Text",ExpressionUUID->"c224e730-b855-ac42-9c50-3b9759addf57"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.2. Formal map", "Subsection",ExpressionUUID->"6514c58a-a6d7-ea41-8fff-4c1aa8d3f448"],

Cell[TextData[{
 "A sensory channel ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Sigma_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4a7a09a1-9fdb-a741-b6b9-aaf3c0f2b5ec"],
 " is a map: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalSigma]", 
          StyleBox["i", "TI"]], ":", 
         SubscriptBox[
          StyleBox["L", "TI"], "2"], "\[Rule]", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Sigma_i : \\mathcal{L}_2 \\to \\mathcal{I}_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d9821c5-5eeb-6e47-bf19-195158c6934f"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["I", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{I}_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8aee55e3-dc43-1248-b373-8649dc8c37e0"],
 " is the internal representational space of the organism. "
}], "Text",ExpressionUUID->"3dcb6491-9e43-b147-9121-98cfffa713b1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.3. Examples", "Subsection",ExpressionUUID->"148d9237-b586-f64c-acac-92d86edfdd62"],

Cell["vision: EM-band, high directional resolution,", "Item",ExpressionUUID->"3fa04280-0afb-2e4c-b57c-2ce8ec0a5f4d"],

Cell["audition: pressure-wave temporal resolution,", "Item",ExpressionUUID->"06d794fa-177d-ed4e-b97f-37396dc3f6d5"],

Cell["touch: contact and deformation gradients,", "Item",ExpressionUUID->"04162825-1093-2644-88d2-af1815196c0e"],

Cell["olfaction: molecular pattern classification,", "Item",ExpressionUUID->"b27efa5e-cd0e-4a4f-a37b-07bee6007fe0"],

Cell["vestibular sense: acceleration and orientation,", "Item",ExpressionUUID->"2df75ec8-2e73-d44f-8604-554c81e2dfa0"],

Cell["proprioception: internal geometry sensing.", "Item",ExpressionUUID->"8f086641-cf35-7940-8571-1dc55b313a78"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.4. Scientific implication", "Subsection",ExpressionUUID->"01a5e66e-3783-8b42-95da-b3d5e8c1e204"],

Cell["\<\
Perception is a measurement strategy evolved for survival, not exhaustive \
ontology. Therefore human intuition about reality is deeply band-limited.\
\>", "Text",ExpressionUUID->"760e3901-900c-c04d-a072-04188aea7fe8"],

Cell["\<\
This changes how science should think about instrument design: instruments \
extend sensory bands, but they often inherit sensory metaphors that may limit \
conceptual frameworks. \
\>", "Text",ExpressionUUID->"45d416c5-ec8b-9d4a-b64e-5e369c19336e"],

