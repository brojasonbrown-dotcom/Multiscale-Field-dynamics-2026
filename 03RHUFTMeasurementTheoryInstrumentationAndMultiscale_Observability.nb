 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"d5403a54-92b0-bb47-b694-445180231a0a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["13. Measurement falsification standards", "Section",ExpressionUUID->"b473da67-1ee1-484c-be23-858cf0caf426"],

Cell["A rigorous framework must risk failure. ", "Text",ExpressionUUID->"832b3833-387b-7148-8213-c483d5c4c315"],

Cell[CellGroupData[{

Cell["13.1. RHUFT-specific falsification demand", "Subsection",ExpressionUUID->"a0f7d430-3850-b043-bb3e-74bd7e583b05"],

Cell["\<\
The framework gains credibility only if it predicts measurable differences in \
outcomes when standard scalar observables are held fixed but: \
\>", "Text",ExpressionUUID->"82745dad-eb99-644e-a91b-f7f09681072a"],

Cell["interface geometry is changed,", "Item",ExpressionUUID->"64ee6d79-ca02-804b-93ed-9c90baa34af3"],

Cell["scale hierarchy is altered,", "Item",ExpressionUUID->"99d29a49-317b-d54d-b3f1-fbf49e08db06"],

Cell["backreaction is differently managed,", "Item",ExpressionUUID->"66b15033-7aa1-b443-95d8-3470a889e177"],

Cell["closure-supporting recurrence is introduced or suppressed.", "Item",ExpressionUUID->"3ccc6380-e45a-3d4b-87b9-54a03b092102"]
}, Open  ]],

Cell[CellGroupData[{

Cell["13.2. If no effect is found", "Subsection",ExpressionUUID->"cdfb9f67-62bd-2245-aac3-c132ccf78e6d"],

Cell["\<\
If repeated experiments show that these enriched variables contribute no \
predictive value beyond standard calibration and known systematics, then \
RHUFT-style measurement enrichment is weakened.\
\>", "Text",ExpressionUUID->"8d9b13eb-0c95-974f-a549-b8cdc7e57208"],

Cell["This is healthy and necessary. ", "Text",ExpressionUUID->"873cbc0e-2ecf-3347-b835-a2a3cef16779"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
