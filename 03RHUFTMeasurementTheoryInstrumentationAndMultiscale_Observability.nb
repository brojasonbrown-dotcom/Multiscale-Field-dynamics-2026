   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"c847d938-50ec-9942-acc4-d8af0f1cbdd7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Measurement operators", "Section",ExpressionUUID->"74328663-b8cf-2949-8557-f98df7689f01"],

Cell[CellGroupData[{

Cell["7.1. Decomposition", "Subsection",ExpressionUUID->"4aad2ef4-e737-334b-88a2-3137803a5728"],

Cell[TextData[{
 "We define the following operator sequence: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[LongEqual]", 
         StyleBox["Q", "TI"], "\[EmptySmallCircle]", 
         StyleBox["R", "TI"], "\[EmptySmallCircle]", 
         StyleBox["P", "TI"], "\[EmptySmallCircle]", 
         StyleBox["A", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{M} = \\mathcal{Q} \\circ \\mathcal{R} \\circ \\mathcal{P} \
\\circ \\mathcal{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "57e6e6f6-e9b9-4949-bb7c-307ead7f5cb1"],
 "where: "
}], "Text",ExpressionUUID->"31c1458d-50f0-8749-a9e9-bcb54813308b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4f78aa83-818b-bf49-a16f-53cf512f4f7f"],
 " = access operator,"
}], "Item",ExpressionUUID->"87dcd9a8-fb3a-ff47-a9f9-94d694ba3ecb"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["P", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{P}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1d873b35-d932-eb4b-aba8-e6c5a3a391aa"],
 " = perturbation/backreaction operator,"
}], "Item",ExpressionUUID->"5497cc3a-5b12-fc45-8059-cb313d7ed495"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{R}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0838925b-1d56-1c4e-84a3-2d90067ece6d"],
 " = resolution operator,"
}], "Item",ExpressionUUID->"81959f34-8a61-d245-b50e-0fea5d15cfaa"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["Q", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{Q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "09d38aae-2214-9545-af6e-33ad65841fca"],
 " = quantization/compression operator."
}], "Item",ExpressionUUID->"9297c4b1-122d-8047-8cca-357937793427"],

Cell[TextData[{
 "A more complete version adds stabilization and memory operators: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["full", FontSlant -> "Plain"]], "\[LongEqual]", 
         StyleBox["C", "TI"], "\[EmptySmallCircle]", 
         StyleBox["T", "TI"], "\[EmptySmallCircle]", 
         StyleBox["S", "TI"], "\[EmptySmallCircle]", 
         StyleBox["Q", "TI"], "\[EmptySmallCircle]", 
         StyleBox["R", "TI"], "\[EmptySmallCircle]", 
         StyleBox["P", "TI"], "\[EmptySmallCircle]", 
         StyleBox["A", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{M}_{\\mathrm{full}} = \\mathcal{C} \\circ \\mathcal{T} \\circ \
\\mathcal{S} \\circ \\mathcal{Q} \\circ \\mathcal{R} \\circ \\mathcal{P} \
\\circ \\mathcal{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c65422b4-572d-574e-a822-951f96547be8"]
}], "Text",ExpressionUUID->"9096953a-e779-9d4f-9b01-916e16d1784c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2. Interpretation", "Subsection",ExpressionUUID->"1ceb3c2f-c44f-7f4e-973f-a5f8939ff046"],

Cell["Every real measurement: ", "Text",ExpressionUUID->"f6fec540-08b5-5744-9b26-4fba1ac9212a"],

Cell["gains access,", "Item",ExpressionUUID->"623742c0-03db-ef47-92d5-d219d3c46afe"],

Cell["perturbs,", "Item",ExpressionUUID->"4420a135-3dd0-d34b-b2a3-a9cb7e4132ee"],

Cell["filters,", "Item",ExpressionUUID->"d49fe879-f88e-ba4f-9fee-9ff308fd2ed4"],

Cell["discretizes or thresholds,", "Item",ExpressionUUID->"c9c4ba1b-cd77-5341-8641-653e2c1b2452"],

Cell["stabilizes,", "Item",ExpressionUUID->"e1b55781-400f-0b41-bb5e-a700c29cdeeb"],

Cell["transduces,", "Item",ExpressionUUID->"75023ea1-416a-ef4e-8289-4148fd4a24cb"],

Cell["compresses.", "Item",ExpressionUUID->"cb5e3b51-fb91-af47-8e6a-d3cb7a1fd680"],

Cell["This should be treated as standard, not exceptional. ", "Text",ExpressionUUID->"4c8528f9-3d5d-a84f-80c8-f3b705c9fd03"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.3. Wolfram Language scaffolding", "Subsection",ExpressionUUID->"74c2fca0-ae7e-f649-a9a1-341b73d967d1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "accessOp", ",", "perturbOp", ",", "resolutionOp", ",", "stabilizationOp",
      ",", "transductionOp", ",", "compressionOp", ",", "measurementEvent"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"accessOp", "[", 
     RowBox[{"state_", ",", "interface_"}], "]"}], ":=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<State\>\"", "->", "state"}], ",", 
      RowBox[{"\"\<Interface\>\"", "->", "interface"}]}], "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"perturbOp", "[", 
     RowBox[{"data_", ",", "perturbationModel_"}], "]"}], ":=", 
    RowBox[{"Append", "[", 
     RowBox[{"data", ",", 
      RowBox[{"\"\<PerturbationModel\>\"", "->", "perturbationModel"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"resolutionOp", "[", 
     RowBox[{"data_", ",", "scaleBand_"}], "]"}], ":=", 
    RowBox[{"Append", "[", 
     RowBox[{"data", ",", 
      RowBox[{"\"\<ScaleBand\>\"", "->", "scaleBand"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stabilizationOp", "[", 
     RowBox[{"data_", ",", "stabilizationModel_"}], "]"}], ":=", 
    RowBox[{"Append", "[", 
     RowBox[{"data", ",", 
      RowBox[{"\"\<StabilizationModel\>\"", "->", "stabilizationModel"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"transductionOp", "[", 
     RowBox[{"data_", ",", "transducer_"}], "]"}], ":=", 
    RowBox[{"Append", "[", 
     RowBox[{"data", ",", 
      RowBox[{"\"\<Transducer\>\"", "->", "transducer"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"compressionOp", "[", 
     RowBox[{"data_", ",", "reportModel_"}], "]"}], ":=", 
    RowBox[{"Append", "[", 
     RowBox[{"data", ",", 
      RowBox[{"\"\<ReportModel\>\"", "->", "reportModel"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementEvent", "[", 
    RowBox[{
    "state_", ",", "interface_", ",", "perturbationModel_", ",", "scaleBand_",
      ",", "stabilizationModel_", ",", "transducer_", ",", "reportModel_"}], 
    "]"}], ":=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"accessOp", "[", 
         RowBox[{"state", ",", "interface"}], "]"}], " ", "//", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"Function", "[", 
         RowBox[{"d", ",", 
          RowBox[{"perturbOp", "[", 
           RowBox[{"d", ",", "perturbationModel"}], "]"}]}], "]"}]}], " ", "//",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"Function", "[", 
        RowBox[{"d", ",", 
         RowBox[{"resolutionOp", "[", 
          RowBox[{"d", ",", "scaleBand"}], "]"}]}], "]"}]}], " ", "//", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"Function", "[", 
       RowBox[{"d", ",", 
        RowBox[{"stabilizationOp", "[", 
         RowBox[{"d", ",", "stabilizationModel"}], "]"}]}], "]"}]}], " ", "//",
      "\[IndentingNewLine]", "   ", 
     RowBox[{"Function", "[", 
      RowBox[{"d", ",", 
       RowBox[{"transductionOp", "[", 
        RowBox[{"d", ",", "transducer"}], "]"}]}], "]"}]}], " ", "//", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{"Function", "[", 
     RowBox[{"d", ",", 
      RowBox[{"compressionOp", "[", 
       RowBox[{"d", ",", "reportModel"}], "]"}]}], "]"}]}]}], ";"}]}], "Input",\
ExpressionUUID->"659a99bd-e3ac-b94f-93df-921afc690129"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"d3a46152-bcc6-4746-ac11-c0a82e2904fa"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Resolution is ontological, not merely technical", "Section",ExpressionUUID->"b2527abf-ece5-4f48-8c60-5a6510c2ae17"],

Cell[CellGroupData[{

Cell["8.1. Standard view", "Subsection",ExpressionUUID->"5d42e150-5d05-e640-a295-707529926805"],

Cell["Resolution is often treated as an engineering limitation. ", "Text",ExpressionUUID->"e0201d66-ce64-5e46-90fa-e77beb8d70dc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.2. RHUFT view", "Subsection",ExpressionUUID->"96a79941-d1b0-0c48-a63a-8cc15c2cec43"],

Cell["\<\
Resolution partly determines what distinction classes can exist operationally \
for a given interaction.\
\>", "Text",ExpressionUUID->"ae2ea845-0a09-f645-a21e-550a4e3f35d1"],

Cell[TextData[{
 "This does not mean low resolution creates reality from nothing. It means \
that ",
 StyleBox["what counts as a stable observable depends on the interaction \
scale at which the field is probed and stabilized",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"a6b4decc-78a7-4546-99ff-3c9f9e5b48e3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.3. Effective-resolution functional", "Subsection",ExpressionUUID->"15e5a8e3-71a7-6d41-bec3-6210bc428cd7"],

Cell[TextData[{
 "A candidate effective-resolution quantity is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Sigma]", 
          StyleBox["eff", FontSlant -> "Plain"]], "\[LongEqual]", 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Sigma]", 
              StyleBox["instr", FontSlant -> "Plain"]], ",", 
             SubscriptBox["\[Sigma]", 
              StyleBox["int", FontSlant -> "Plain"]], ",", 
             SubscriptBox["\[Sigma]", 
              StyleBox["field", FontSlant -> "Plain"]], ",", 
             StyleBox["h", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\sigma_{\\mathrm{eff}} = f(\\sigma_{\\mathrm{instr}}, \
\\sigma_{\\mathrm{int}}, \\sigma_{\\mathrm{field}}, h)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4f952438-75aa-cb41-99be-9144f7d98227"],
 "where: "
}], "Text",ExpressionUUID->"49e72219-1fef-0348-a025-78b36d00e9ee"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Sigma]", 
        StyleBox["instr", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sigma_{\\mathrm{instr}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b2a9a253-56c6-c048-8572-df0b1c8ecf13"],
 " is instrument resolution,"
}], "Item",ExpressionUUID->"e2f57443-71f3-4549-872a-415c9d891b4a"],

Cell[TextData[{
 Cell[BoxData[
