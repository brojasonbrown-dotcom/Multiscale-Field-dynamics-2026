}, Open  ]],

Cell[CellGroupData[{

Cell["15. Measurement compression and scientific error", "Section",ExpressionUUID->"35f9dac6-1d4d-ca40-8c4d-9c8d74cb897d"],

Cell[CellGroupData[{

Cell["15.1. Compression loss", "Subsection",ExpressionUUID->"0ca276d3-acf9-3646-99ff-89d3f4f3f7d3"],

Cell["\<\
The final number in a paper often represents aggressive compression of a \
high-dimensional event. \
\>", "Text",ExpressionUUID->"1f6f70a9-073a-b244-9e1b-3c201573a111"]
}, Open  ]],

Cell[CellGroupData[{

Cell["15.2. Compression-induced interpretive error", "Subsection",ExpressionUUID->"1091ab7b-0bf4-024a-b380-1b64f92c11c9"],

Cell["\<\
If compression discards geometry, history, and stabilization pathway, then \
later theory may try to explain variance that was produced by the measurement \
chain itself. \
\>", "Text",ExpressionUUID->"bbf5a653-bceb-1743-aff7-1ddde0ddcaea"]
}, Open  ]],

Cell[CellGroupData[{

Cell["15.3. Recommendation", "Subsection",ExpressionUUID->"f16e32e7-db24-f641-b5af-305e139e4730"],

Cell["\<\
Scientific reporting should increasingly preserve layered data products:\
\>", "Text",ExpressionUUID->"a8b42e65-a617-ca4e-9a66-cd0aae77b596"],

Cell["1. raw signal,", "Text",ExpressionUUID->"353c0f0c-081a-c94e-a5e1-f71701fe78d1"],

Cell["2. transduction trace,", "Text",ExpressionUUID->"e0c1f034-1676-ee43-aa1c-4b8b3610be23"],

Cell["3. stabilization diagnostics,", "Text",ExpressionUUID->"3f34fde6-6a16-7d41-b9c3-743278a87c27"],

Cell["4. compressed estimate. ", "Text",ExpressionUUID->"7e866bf7-48d8-4841-be19-e5d3244b7775"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"981d8bc5-1d35-5849-8031-26669d2dcc1c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["16. A provisional metrology upgrade standard", "Section",ExpressionUUID->"6dbe3083-13ef-444c-99f2-6b06d3010f68"],

Cell[CellGroupData[{

Cell["16.1. Proposed enriched record format", "Subsection",ExpressionUUID->"d8c89520-1df3-7b47-9064-637aa01e4b9f"],

Cell["Each experiment should ideally archive: ", "Text",ExpressionUUID->"cf00b37d-45cb-1041-9b5b-1c4a372aec63"],

Cell["apparatus geometry descriptor,", "Item",ExpressionUUID->"a99bb11d-afac-da4e-8051-cd12f3daa5d9"],

Cell["environmental boundary conditions,", "Item",ExpressionUUID->"088a0ccc-e860-724c-9899-88c2c5d0e762"],

Cell["calibration state,", "Item",ExpressionUUID->"3819227f-cbc0-e84b-89e3-c310bbe34af3"],

Cell["resolution function,", "Item",ExpressionUUID->"59697e06-4d2a-7a48-900e-0fbadb9a9532"],

Cell["perturbation budget,", "Item",ExpressionUUID->"13509e20-3d05-584f-a45e-c09803d2f44f"],

Cell["hysteresis estimate,", "Item",ExpressionUUID->"db467453-5133-694d-a57e-8c89c7a8f303"],

Cell["phase-lock metrics,", "Item",ExpressionUUID->"9d03fa42-2bc2-dc41-b97e-2ce53383e945"],

Cell["compressed reported values.", "Item",ExpressionUUID->"47356ad3-9a70-ee4a-828f-e76ee94f53a3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["16.2. Why this is not unrealistic", "Subsection",ExpressionUUID->"0ec886e3-e19d-fb47-8208-4df2d728b3a1"],

Cell["\<\
Many modern instruments already log some of these. RHUFT simply argues they \
are not peripheral metadata but part of the physical meaning of the result. \
\>", "Text",ExpressionUUID->"f0b408d9-4c1c-e943-ac58-a5dbbb73746a"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"55a07a1e-e66f-df4e-abdd-b45b1ba70715"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["17. Formal observability matrix", "Section",ExpressionUUID->"ebd912fd-b14a-b141-8df9-76790e7d6b9b"],

Cell[CellGroupData[{

Cell["17.1. Definition", "Subsection",ExpressionUUID->"603c8c6c-972c-2d46-8ec2-cb25790be69d"],

Cell[TextData[{
 "Let field variables be ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "q_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cb1580c2-d05a-cb40-8498-64653e94c716"],
 " and instrument channels be ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["y", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "y_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "590884b6-5f69-d64e-9458-7d40c01f0ec5"],
 ". Define an observability matrix: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["O", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["y", "TI"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["q", "TI"], 
             StyleBox["j", "TI"]]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{O}_{ij} = \\frac{\\partial y_i}{\\partial q_j}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98e3f093-b6ac-0246-898b-0ce8edd8e0ac"],
 "But in RHUFT this should be extended to include geometry, scale, and \
history: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["O", "TI"], "~"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["y", "TI"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["q", "TI"], 
             StyleBox["j", "TI"]]}]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["g", "TI"], ",", "\[Sigma]", ",", 
             StyleBox["h", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\widetilde{\\mathcal{O}}_{ij} = \\frac{\\partial y_i}{\\partial \
q_j}(g,\\sigma,h)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0421b99-82c9-9644-9f73-561b8c5be35a"]
}], "Text",ExpressionUUID->"ca4f7061-8dad-dc41-a292-48aba2773ecc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["17.2. Meaning", "Subsection",ExpressionUUID->"aed253e0-ab86-1d44-a233-a372808f8e94"],

Cell["\<\
A property is not simply observable or unobservable in the absolute. It is \
observable relative to a geometry-scale-history regime.\
\>", "Text",ExpressionUUID->"e44ccd5c-e4c1-9447-a138-429df219f3c7"],

Cell["This is a major conceptual shift. ", "Text",ExpressionUUID->"b4767104-b268-474e-8a80-88584e429cc0"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"96514cec-8426-d346-8744-5a772bb0400d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["18. Toward an experimental program", "Section",ExpressionUUID->"73bd49c8-f641-f549-9491-2efaa1c10dad"],

Cell[CellGroupData[{

Cell["18.1. Minimal experimental program", "Subsection",ExpressionUUID->"20232d65-ac95-624a-83c1-5dad19c8ab1f"],

Cell["A serious first program would do the following:", "Text",ExpressionUUID->"e049d2f9-617a-1e41-bc96-f7196f45aa26"],

Cell["1. choose a controlled signal domain,", "Text",ExpressionUUID->"2bb611b4-0791-814f-82e9-16e9eef7091d"],

Cell["2. build matched instruments with alternate geometries,", "Text",ExpressionUUID->"c5b320c8-1440-a342-a130-ab1d93c1d53a"],

Cell["3. measure identical sources,", "Text",ExpressionUUID->"b04588e5-69ac-774d-8751-909ea7b8bd0b"],

Cell["4. record enriched measurement-state vectors,", "Text",ExpressionUUID->"6cb801f8-70de-3a4f-b755-acf852edb384"],

Cell["\<\
5. analyze whether geometry or recurrence variables improve predictive fit. \
\>", "Text",ExpressionUUID->"b5b7f195-d9f5-b447-b8a4-bf6d96b8e6ae"]
}, Open  ]],

Cell[CellGroupData[{

Cell["18.2. Candidate domains", "Subsection",ExpressionUUID->"3affa2a3-cb77-1346-bd74-84773ac74d0b"],

Cell["Good starting domains include: ", "Text",ExpressionUUID->"c416d72b-25bc-c24a-bfed-97d666b421c5"],

Cell["RF sensing,", "Item",ExpressionUUID->"08a48202-795d-3d4b-ba94-b333e145359b"],

Cell["optical interferometry,", "Item",ExpressionUUID->"27840f5e-80f6-224a-a9a2-12ba49c66b45"],

Cell["acoustic resonance,", "Item",ExpressionUUID->"dcf497ec-b061-ca41-99a1-71791f2511ef"],

Cell["precision electrometry,", "Item",ExpressionUUID->"a8e40c54-d636-7b45-8a41-3b9ad44bd9e8"],

Cell["low-noise magnetic sensing,", "Item",ExpressionUUID->"545cf4bc-5374-214c-89c7-7b9924634230"],

Cell["complex materials spectroscopy.", "Item",ExpressionUUID->"192d52f2-b56e-6940-b946-67fe452f1c9a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["18.3. Why these domains", "Subsection",ExpressionUUID->"2521362e-7d65-0c47-bb34-55ec63693556"],

Cell["\<\
Because they are sensitive, reproducible, and already rich in \
geometry-dependent coupling. \
\>", "Text",ExpressionUUID->"73d3c9a8-b68f-dd4c-9d1f-45344b2b7b0e"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"4969cfe5-df0a-1d42-90cc-ec9673cae346"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["19. Professional caution on extraordinary claims", "Section",ExpressionUUID->"b74edc78-1e97-c24e-bfe8-47f8c99a490c"],

Cell["\<\
The framework can inspire interpretations about consciousness, intuition, or \
subtle sensing. Those topics should not be inserted into the measurement \
program until operational definitions are available.\
\>", "Text",ExpressionUUID->"fbe1b62e-cda6-d548-ab07-27bcb22ac72d"],

Cell["A professional order of development is:", "Text",ExpressionUUID->"48ca832e-db1a-ea44-87e5-180054846918"],

Cell["1. establish enriched measurement theory,", "Text",ExpressionUUID->"737d42dc-b9f5-ff4e-a382-203deaffdb05"],

Cell["2. demonstrate engineering gains,", "Text",ExpressionUUID->"4243889b-1f83-9346-abe1-4bbb46af325d"],

Cell["3. demonstrate predictive gains,", "Text",ExpressionUUID->"ec315dbf-90de-084c-a341-f4132cf5ad3e"],

Cell["4. only then explore broader ontological consequences.", "Text",ExpressionUUID->"ea0d8852-0ffb-024e-849d-46754bdf8151"],

Cell["This is how the work becomes credible. ", "Text",ExpressionUUID->"5519f5d9-3476-3340-8d35-9360afe66bff"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
