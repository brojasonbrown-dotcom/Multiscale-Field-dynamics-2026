Cell[CellGroupData[{

Cell["\<\
11. Experimental program F: step-response and stabilization metrics\
\>", "Section",ExpressionUUID->"6cd1d135-39b4-f04f-810f-da534c6be32a"],

Cell[CellGroupData[{

Cell["11.1. Motivation", "Subsection",ExpressionUUID->"bcdc9759-9795-2940-9dd7-47d54bbaf8e1"],

Cell["\<\
If persistent observables depend on stabilization dynamics, then dynamic \
response characteristics matter.\
\>", "Text",ExpressionUUID->"8b957d53-ea9a-1048-88cd-7765a4a0cbe9"],

Cell[TextData[{
 "Use ",
 ButtonBox["SystemModelMeasurements",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SystemModelMeasurements"],
 " to quantify: "
}], "Text",ExpressionUUID->"9aefc8da-7f2e-2b48-b76f-0655af6691de"],

Cell["rise time,", "Item",ExpressionUUID->"07a9ab7a-c5ef-3944-a27b-c3b0ac186781"],

Cell["settling time,", "Item",ExpressionUUID->"147857cd-aa84-8143-b596-6b5b1d1fa45e"],

Cell["overshoot,", "Item",ExpressionUUID->"cafc61b3-6015-5845-9ef3-9afd9229f3e3"],

Cell["delay time,", "Item",ExpressionUUID->"1629d5fd-6f92-8341-9c5a-ba0052301de4"],

Cell["final value,", "Item",ExpressionUUID->"5f44e518-c2ec-0a46-a3b5-b758bbce7648"],

Cell["full response signal.", "Item",ExpressionUUID->"542fd6da-5b04-244a-a88c-6a8ed193b0e0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.2. RHUFT interpretation", "Subsection",ExpressionUUID->"59914063-c259-5049-96e8-f181ece82871"],

Cell["\<\
The measurement is not just the final value. The pathway to stabilization is \
part of the physical meaning.\
\>", "Text",ExpressionUUID->"5ea6fa2a-0976-bf44-9836-a3de3e8de202"],

Cell["\<\
Thus systems with equal final values but different stabilization pathways \
should not automatically be regarded as identical from the \
measurement-theoretic standpoint. \
\>", "Text",ExpressionUUID->"c8ae857d-a84b-e34a-8574-837134f82a5e"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"8f691e20-d17d-884a-9fb3-709f311a4e9f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["12. Quantitative comparison logic", "Section",ExpressionUUID->"5877c13e-3903-4e44-924c-21e8082235ec"],

Cell[CellGroupData[{

Cell["12.1. What counts as evidence?", "Subsection",ExpressionUUID->"06f3319f-9c46-b246-93e9-87ee49bc0438"],

Cell["\<\
Evidence for RHUFT-style measurement refinement would include:\
\>", "Text",ExpressionUUID->"a0d612ad-e81c-ef49-b8cc-280edbb4fd82"],

Cell["\<\
1. consistent out-of-sample predictive improvement from enriched \
measurement-state descriptors,\
\>", "Text",ExpressionUUID->"73ac8d5e-91d0-7c48-bc52-a2c2fe6a164c"],

Cell["2. residual structure collapse under geometry-aware models,", "Text",ExpressionUUID->"532f7faa-0743-e24c-b233-e4d7cc320eee"],

Cell["\<\
3. reproducible geometry-sensitive deviations across independent setups,\
\>", "Text",ExpressionUUID->"f9c86a01-0fb8-b14a-8c08-38271a5d11cc"],

Cell["\<\
4. scale-window effects not reducible to simple instrumental blur,\
\>", "Text",ExpressionUUID->"38242aca-9925-de43-9218-3928010ad05c"],

Cell["5. recurrence-sensitive response classes. ", "Text",ExpressionUUID->"0e8f2209-b5d1-b84d-b3ee-78ff4f0225a7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.2. What does not count?", "Subsection",ExpressionUUID->"80e7a969-bed1-a946-aaba-47912fe84414"],

Cell[TextData[{
 "The following do ",
 StyleBox["not",
  FontWeight->Bold],
 " count as evidence: "
}], "Text",ExpressionUUID->"c9f4e9e8-fa35-f144-8532-1f0e2b4e127e"],

Cell["cherry-picked numerical coincidences,", "Item",ExpressionUUID->"c81237d6-a181-dd4e-a2af-c4dbd9c23282"],

Cell["one-off anomalies,", "Item",ExpressionUUID->"56faa8a5-fdc3-5946-ac16-f5e978a67b8f"],

Cell["post hoc symbolic interpretations,", "Item",ExpressionUUID->"de173651-3710-d246-b7e0-fc668d5d261c"],

Cell["unrepeatable instrument quirks,", "Item",ExpressionUUID->"02aeded0-619e-b948-b1fc-4642cb4bd816"],

Cell["fits without held-out validation.", "Item",ExpressionUUID->"49bf29e4-07d8-724d-9c67-ea90cbbc906e"],

