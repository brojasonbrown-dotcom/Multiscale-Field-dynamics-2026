Cell[CellGroupData[{

Cell["2. What can realistically be tested first?", "Section",ExpressionUUID->"abc39d11-d044-b446-829c-a4f1ab6828eb"],

Cell[TextData[{
 "The highest-value starting point is ",
 StyleBox["not",
  FontWeight->Bold],
 " cosmogenesis. It is ",
 StyleBox["measurement geometry and multiscale observability",
  FontWeight->Bold],
 "."
}], "Text",ExpressionUUID->"50fd25b7-20fd-4b4e-9752-94d413e5f833"],

Cell["\<\
This is because the earlier RHUFT notebooks already imply a plausible and \
testable thesis: \
\>", "Text",ExpressionUUID->"41974330-06de-3a46-91a7-6afd6802a643"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"instrument geometry, scale-band access, recurrence \
structure, and history dependence may affect which observables stabilize, \
even when naive scalar readouts appear equivalent.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic},
     ScrollPosition->{0., 0.}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"c26b7a5e-3852-3c46-a07a-5a5720f2eb6c"],

Cell["This can be probed now using standard lab domains. ", "Text",ExpressionUUID->"5b7cf1c9-8e98-0747-8b40-c78fa4159f37"],

Cell[CellGroupData[{

Cell["2.1. Best initial domains", "Subsection",ExpressionUUID->"363aa2e2-ef23-ff4e-88e0-372d2ecbb914"],

Cell["The most approachable test domains are:", "Text",ExpressionUUID->"c35e32f7-e16e-c54b-b61e-92e93b47eb31"],

Cell["1. radio-frequency sensing,", "Text",ExpressionUUID->"5de53175-a189-c040-96fe-1c44737488f4"],

Cell["2. optical interferometry,", "Text",ExpressionUUID->"d93ef49d-91ac-4a47-a7f9-211682d0af19"],

Cell["3. acoustic resonators,", "Text",ExpressionUUID->"8b3e1020-3a71-2945-b130-364a5d35cc64"],

Cell["4. magnetic sensing,", "Text",ExpressionUUID->"ff6e2f27-e488-cc43-a804-294e925f7cf5"],

Cell["5. precision EM cavity systems,", "Text",ExpressionUUID->"e4ed3208-7fef-9847-a142-dfc8a0f5ef40"],

Cell["6. materials spectroscopy.", "Text",ExpressionUUID->"799c5b65-ae76-7d48-b798-e7612bf450df"],

Cell["These are appropriate because they are: ", "Text",ExpressionUUID->"586b5251-c596-3749-9ee9-6380cc9e1d7a"],

Cell["geometry sensitive,", "Item",ExpressionUUID->"8f0832bd-a2b4-b847-af9e-20bca79e4146"],

Cell["reproducible,", "Item",ExpressionUUID->"a120bdc4-ffba-2942-9e94-4d74f1ec86c3"],

Cell["relatively low cost compared with particle physics,", "Item",ExpressionUUID->"5da56bc8-9be6-e944-ad69-b938e953e101"],

Cell["rich in phase, resonance, and boundary effects.", "Item",ExpressionUUID->"cd90760d-6568-9d49-a002-d31b74ce2f10"],

