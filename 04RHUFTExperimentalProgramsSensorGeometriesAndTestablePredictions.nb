Cell[CellGroupData[{

Cell["6. Experimental program A: geometry-sensitive RF sensing", "Section",ExpressionUUID->"f5415983-72f2-d744-9d67-2313ee7dbcd8"],

Cell[CellGroupData[{

Cell["6.1. Rationale", "Subsection",ExpressionUUID->"f382a48a-be3d-1e4b-94f8-45082426b54f"],

Cell["RF systems are ideal because they naturally display: ", "Text",ExpressionUUID->"a7ac3c69-a3f3-7047-923d-1f40fd965ed1"],

Cell["phase sensitivity,", "Item",ExpressionUUID->"8f997870-60bd-9b40-abee-82be37b45f0c"],

Cell["boundary sensitivity,", "Item",ExpressionUUID->"e21bc738-fb94-be47-9ba7-77be492cbf2b"],

Cell["resonant behavior,", "Item",ExpressionUUID->"04f46ef2-1fdf-8241-81e3-eefe1300fe71"],

Cell["array geometry dependence,", "Item",ExpressionUUID->"ab4709f1-08a0-f041-962b-39cb8476f9c1"],

Cell["measurable transfer functions.", "Item",ExpressionUUID->"7cd6049a-7245-fe41-923a-02a1b3be521b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.2. Proposed comparison", "Subsection",ExpressionUUID->"7efa38c7-16a4-2848-86d9-57250a5c5905"],

Cell["Construct or simulate multiple sensor arrays:", "Text",ExpressionUUID->"87bb63f0-5055-d746-b250-a8cde17e6e70"],

Cell["1. uniform angular array,", "Text",ExpressionUUID->"ad10a9ee-2e16-7a47-9fdd-cf89bb44dc97"],

Cell["2. random array,", "Text",ExpressionUUID->"775e4663-0b60-d74e-8bf6-8c2919b327fd"],

Cell["3. golden-angle array,", "Text",ExpressionUUID->"265cdecd-5f6b-c64d-a228-252d48fecaa1"],

Cell["4. nested toroidal or loop-based array.", "Text",ExpressionUUID->"1e7cfd49-a754-9e47-937f-198afb02df81"],

Cell["Keep as much as possible fixed: ", "Text",ExpressionUUID->"416bb75d-d309-fe49-9e1d-13269bf9b5f7"],

Cell["carrier frequency,", "Item",ExpressionUUID->"980763e2-b6c0-b94d-aa78-dbf44c809b3e"],

Cell["material,", "Item",ExpressionUUID->"cb6bb57b-5b02-af4c-a9c3-c1b0c044956b"],

Cell["amplifier class,", "Item",ExpressionUUID->"8c672375-9ef9-4b44-9cc1-142460c7ab30"],

Cell["total aperture,", "Item",ExpressionUUID->"c441245f-713e-a844-b150-5dcf5f35044c"],

Cell["environment,", "Item",ExpressionUUID->"a5386fd3-5c4f-0843-bfea-75dafa0ba316"],

Cell["calibration source.", "Item",ExpressionUUID->"3e245e52-34bd-994c-b98e-c406d93edfec"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.3. Primary metrics", "Subsection",ExpressionUUID->"a483b686-c6cb-a04d-9d5b-f74a08b9071b"],

Cell["Compare: ", "Text",ExpressionUUID->"97351ba4-9b27-8a4d-8856-1606b47c3e1b"],

Cell["signal-to-noise ratio,", "Item",ExpressionUUID->"53de333d-c512-7b46-b9d2-74544f8bcabf"],

Cell["mode separation,", "Item",ExpressionUUID->"adab8d95-6a3a-db44-920d-917a98b5f2af"],

Cell["residual error under inverse reconstruction,", "Item",ExpressionUUID->"75514b17-4bf9-924b-b22d-2870946d1672"],

Cell["sensitivity to geometry perturbation,", "Item",ExpressionUUID->"5a54cf5b-81d3-7240-850a-b1ff9a91d8af"],

Cell["robustness to multipath conditions,", "Item",ExpressionUUID->"46717ba3-c7bc-0246-a9f9-9b172e9c8c87"],

Cell["predictive fit under enriched vs reduced models.", "Item",ExpressionUUID->"15afb832-9695-9247-98a7-3a4d13053b32"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.4. Why this matters", "Subsection",ExpressionUUID->"03fba399-2a27-5d41-87aa-7f3be9b00d5d"],

Cell["\<\
If irrational spacing layouts yield better residual compression or mode \
disentanglement, this becomes a concrete scientific foothold. \
\>", "Text",ExpressionUUID->"b0216ea4-0d3a-8e4c-81a5-a327d548efee"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.5. Wolfram Language simulation scaffold", "Subsection",ExpressionUUID->"7d14e759-1473-9241-8831-66b94df68ec8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "goldenAngle", ",", "uniformAngles", ",", "goldenAngles", ",", 
     "randomAngles"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"goldenAngle", "=", 
    RowBox[{"2", " ", 
     RowBox[{"Pi", "/", 
      RowBox[{"GoldenRatio", "^", "2"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"uniformAngles", "[", 
     RowBox[{"nodeCount_Integer", "?", "Positive"}], "]"}], ":=", 
    RowBox[{"N", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"k", "/", "nodeCount"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", 
         RowBox[{"nodeCount", "-", "1"}]}], "}"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"goldenAngles", "[", 
     RowBox[{"nodeCount_Integer", "?", "Positive"}], "]"}], ":=", 
    RowBox[{"N", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"k", " ", "goldenAngle"}], ",", 
         RowBox[{"2", " ", "Pi"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", 
         RowBox[{"nodeCount", "-", "1"}]}], "}"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"randomAngles", "[", 
    RowBox[{
     RowBox[{"nodeCount_Integer", "?", "Positive"}], ",", 
     RowBox[{"seed_", ":", " ", "1234"}]}], "]"}], ":=", 
   RowBox[{"BlockRandom", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"Sort", "[", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "nodeCount"}], "]"}], 
      "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID\
->"91a229a7-e72a-404d-b2e2-364a9d02f811"],

