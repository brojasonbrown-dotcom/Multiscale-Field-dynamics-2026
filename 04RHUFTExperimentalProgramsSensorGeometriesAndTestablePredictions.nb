Cell[CellGroupData[{

Cell["1. Professional framing", "Section",ExpressionUUID->"48780d35-8079-5e4c-924f-9dcef295ffd8"],

Cell[CellGroupData[{

Cell["1.1. On the user\[CloseCurlyQuote]s broader cosmological proposal", \
"Subsection",ExpressionUUID->"25634675-2302-e149-99e6-06055e523894"],

Cell["The user proposes a deeper ontological picture in which: ", "Text",ExpressionUUID->"c2706aaf-b96f-a349-a703-7b0f1a0e8030"],

Cell["the universe is not merely governed by law but computes law,", "Item",ExpressionUUID->"d7b0f366-1c7b-934f-bfdc-70145329abbe"],

Cell["\<\
spacetime and scale emerge from pre-lawful or law-generating structure,\
\>", "Item",ExpressionUUID->"38aa4d89-56e8-474e-9481-24051180bb33"],

Cell["\<\
division at that level does not reduce but generates complexity,\
\>", "Item",ExpressionUUID->"92e3de6b-f18c-3040-b201-7de20954ef74"],

Cell["\<\
geometry and recursion are prior to ordinary metric interpretation.\
\>", "Item",ExpressionUUID->"fd06c58b-a8cc-d34e-935b-9d3a542a6910"],

Cell["\<\
These ideas can be philosophically meaningful. However, to become science, \
they must be translated into: \
\>", "Text",ExpressionUUID->"05b4a723-66dd-9142-8cc0-0a3c7cd3e9e1"],

Cell["explicit variables,", "Item",ExpressionUUID->"0a617ce2-e1ff-1e46-bcbb-315eb69d908c"],

Cell["update rules,", "Item",ExpressionUUID->"19ebe2c9-f186-4147-bb87-9812cfa94e96"],

Cell["measurable signatures,", "Item",ExpressionUUID->"eb89e051-af99-8f4f-9cbd-d576c285c34d"],

Cell["clear null hypotheses.", "Item",ExpressionUUID->"e7a2d892-7543-cd47-a5df-5b46a133fe19"],

Cell["That translation is the purpose of this notebook. ", "Text",ExpressionUUID->"693adbd5-29eb-e041-a318-b280ceafb186"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.2. Methodological rule", "Subsection",ExpressionUUID->"0a9ca34d-d4d1-0042-ba89-2a5cae35e8e0"],

Cell["This notebook uses the following rule: ", "Text",ExpressionUUID->"c3bf6ebe-9252-ab4e-97af-a0b3ae06ce85"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"every deep ontological claim must be re-expressed as either \
a measurable quantity, a computable invariant, a controlled geometry effect, \
or a falsifiable prediction.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
