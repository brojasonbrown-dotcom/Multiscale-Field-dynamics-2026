Cell[CellGroupData[{

Cell["\<\
7. Experimental program B: cavity or resonator recurrence studies\
\>", "Section",ExpressionUUID->"eb48471d-7669-de4c-8675-45e68bc24077"],

Cell[CellGroupData[{

Cell["7.1. Rationale", "Subsection",ExpressionUUID->"f09dc596-33a5-2646-8ad3-c7e332e026c7"],

Cell["\<\
If closure and recurrence matter physically, then resonators are natural \
testbeds. \
\>", "Text",ExpressionUUID->"c80e17ef-79c4-4145-8987-129be8be7207"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2. Proposed devices", "Subsection",ExpressionUUID->"cf1d2af0-4b0b-ff40-b111-e4dfae0bc28b"],

Cell["Compare: ", "Text",ExpressionUUID->"6560443a-868a-8e44-93d8-6713a0a8b1af"],

Cell["linear cavity,", "Item",ExpressionUUID->"034d82bf-7b6e-a54c-bdae-9e4192e74903"],

Cell["circular loop cavity,", "Item",ExpressionUUID->"a36dc911-a0f4-3a44-8daa-1037691560e1"],

Cell["toroidal cavity,", "Item",ExpressionUUID->"34c945b0-ad70-0e4a-a497-95473edcf5d9"],

Cell["quasi-irrational segmented cavity.", "Item",ExpressionUUID->"0b5a2841-b888-df49-b35a-852865c85449"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.3. Observables", "Subsection",ExpressionUUID->"03413576-5679-384f-9536-6b9b87c3216a"],

Cell["Measure: ", "Text",ExpressionUUID->"03c8ce7c-e64b-5a47-8569-f08414758905"],

Cell["resonance peaks,", "Item",ExpressionUUID->"c46fc052-79e1-c548-bde2-14df04bb7551"],

Cell["quality factor,", "Item",ExpressionUUID->"a2529cdf-ff59-3e45-89f1-4ec2c3951a44"],

Cell["phase lag,", "Item",ExpressionUUID->"9dfda686-99e3-9547-8a17-1a492d79417d"],

Cell["hysteresis under sweep reversal,", "Item",ExpressionUUID->"68bc9084-e3c0-2c4b-a126-4303d0eba66d"],

Cell["transient decay,", "Item",ExpressionUUID->"3fb75adf-8f4b-9347-bb24-0708c266794f"],

Cell["response to slight geometry perturbations.", "Item",ExpressionUUID->"e37af153-cb9a-2c49-8032-45d2501a5db7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.4. RHUFT-relevant question", "Subsection",ExpressionUUID->"99355b0c-a84d-c94d-b725-b8178fb69c6f"],

Cell["\<\
Does recurrence geometry produce persistent structured deviations from \
standard reduced fits?\
\>", "Text",ExpressionUUID->"cb416df9-3b0b-df4b-bf96-4d4af356f7af"],

Cell["\<\
If yes, we then ask whether the deviations are fully explained by standard \
cavity physics or whether enriched geometry-history descriptors improve \
prediction. \
\>", "Text",ExpressionUUID->"b73a5c74-cf4f-a64a-a24b-aeadba15998f"],

