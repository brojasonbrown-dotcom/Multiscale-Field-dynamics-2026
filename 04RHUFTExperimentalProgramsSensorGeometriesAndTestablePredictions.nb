 Background->None,ExpressionUUID->"6c50670a-63b1-144f-a730-0f24cac438d9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["13. Formal statistical protocol", "Section",ExpressionUUID->"7d3c993b-a6b1-2b48-967e-f859b9e29443"],

Cell["A proper test requires:", "Text",ExpressionUUID->"fd49a600-6256-4440-9647-bc5926ed571c"],

Cell["1. preregistered hypotheses,", "Text",ExpressionUUID->"3779f4d0-0f35-9844-9bb0-ddb74bc3fc81"],

Cell["2. controlled geometry variation,", "Text",ExpressionUUID->"e2ea4b33-acf4-9a42-82f2-965d02fe4282"],

Cell["3. repeat trials,", "Text",ExpressionUUID->"a568c00e-8e4d-ff46-b2cf-27cc4d7695b1"],

Cell["4. blinded analysis where possible,", "Text",ExpressionUUID->"f2ec3d59-21aa-b649-a5d9-ed45ff1ed40e"],

Cell["5. out-of-sample validation,", "Text",ExpressionUUID->"eb129062-55ec-6c4c-b00d-8e4cbe30f28c"],

Cell["6. residual diagnostics,", "Text",ExpressionUUID->"ab6ef511-9d64-334f-ba6e-149ceb960546"],

Cell["7. robustness checks across environments.", "Text",ExpressionUUID->"3448bc9e-39e0-e845-9200-b92955c2e820"],

Cell["\<\
This is non-negotiable if the framework is to be taken seriously. \
\>", "Text",ExpressionUUID->"83d3a6aa-20c7-b444-93e1-d35e6c3c24b8"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
