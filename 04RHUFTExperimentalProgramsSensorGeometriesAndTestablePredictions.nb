Cell[CellGroupData[{

Cell["\<\
10. Experimental program E: system calibration with richer state descriptions\
\>", "Section",ExpressionUUID->"d37efe37-7a74-9945-b2ee-86133a9f34aa"],

Cell[CellGroupData[{

Cell["10.1. Idea", "Subsection",ExpressionUUID->"c735eada-2a79-8141-afa2-66da081d64d3"],

Cell["\<\
Instead of fitting a device model only to input-output values, fit \
geometry-sensitive or history-sensitive parameters too.\
\>", "Text",ExpressionUUID->"d9222fcc-172f-6641-acaa-a4d99fbe8aee"],

Cell[TextData[{
 "This can be done using ",
 ButtonBox["SystemModelCalibrate",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SystemModelCalibrate"],
 ". "
}], "Text",ExpressionUUID->"8addfb4c-7e6f-e648-a39d-6b2a35064de8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.2. What to compare", "Subsection",ExpressionUUID->"587d8ffa-85fd-6547-a50b-beed23f15d26"],

Cell["Compare two models: ", "Text",ExpressionUUID->"141f4985-1b74-4f46-b7fe-c5edcfe846a2"],

Cell["standard reduced calibration,", "Item",ExpressionUUID->"64a0b706-b02c-2040-bebd-0eacc72b5727"],

Cell["\<\
extended calibration including recurrence or geometry proxy parameters.\
\>", "Item",ExpressionUUID->"2a3e3623-4a0d-7545-9181-de4adff93f0d"],

Cell["Use calibration and validation splits. Then compare: ", "Text",ExpressionUUID->"ea54bcf0-c3a1-9140-ab7d-b846df12c702"],

Cell[TextData[Cell[BoxData["\"\<MSE\>\""], "InlineWL", "Input",
 ShowAutoStyles->True,
 ShowSyntaxStyles->True,
 LanguageCategory->"Input",
 ShowStringCharacters->
  True,ExpressionUUID->"93424ca5-b292-7744-8c7f-9a7bf3ce45c8"]], "Item",Expres\
sionUUID->"1a09e91a-6d4e-f548-9415-2f5f5eb5c130"],

Cell[TextData[Cell[BoxData["\"\<RMSE\>\""], "InlineWL", "Input",
 ShowAutoStyles->True,
 ShowSyntaxStyles->True,
 LanguageCategory->"Input",
 ShowStringCharacters->
  True,ExpressionUUID->"2ab18445-7819-9741-80f1-9ec86276ec74"]], "Item",Expres\
sionUUID->"18455250-89b3-0f4f-bc2d-cc839771e837"],

Cell["residual structure", "Item",ExpressionUUID->"6dc93593-5ca1-5244-aac3-e2fe99e0e3f9"],

Cell["standardized residuals", "Item",ExpressionUUID->"229796bf-a83b-3845-9b97-8229d0487f1d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.3. Why this matters", "Subsection",ExpressionUUID->"b467867d-a732-334c-9205-d94ce0732cdf"],

Cell["\<\
If enriched models systematically reduce residual structure, that is a \
serious empirical foothold. \
\>", "Text",ExpressionUUID->"55767542-23e4-c94e-a713-458491f4000c"],

