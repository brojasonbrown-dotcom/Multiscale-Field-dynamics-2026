}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
9. Experimental program D: enriched measurement-state reporting\
\>", "Section",ExpressionUUID->"a89663f8-2487-8f47-a948-aa8a086823b2"],

Cell[CellGroupData[{

Cell["9.1. Immediate implementation", "Subsection",ExpressionUUID->"f416e075-201e-5f4f-b0b5-beb72ee28c55"],

Cell["\<\
Take an existing experiment and augment its data model rather than rebuild \
the whole apparatus.\
\>", "Text",ExpressionUUID->"991faf34-437a-5444-86cd-71d008dc08a7"],

Cell["For example, in repeated sensor measurements, log: ", "Text",ExpressionUUID->"42655577-94a1-8445-88ee-e7ce8e12c304"],

Cell["actual value,", "Item",ExpressionUUID->"cb061a9e-4ff2-ff4f-9cef-923b6a9299b2"],

Cell["environmental state,", "Item",ExpressionUUID->"0a4a33b0-b938-7e47-b2ed-91210042d4b1"],

Cell["local temperature,", "Item",ExpressionUUID->"f975d792-4d56-274f-a902-fad39e5d6749"],

Cell["timing history,", "Item",ExpressionUUID->"05e7777c-536f-9348-82f5-205da6ea0ee5"],

Cell["geometry metadata,", "Item",ExpressionUUID->"15dfda75-094f-4d4d-991c-a834878a5211"],

Cell["settling time,", "Item",ExpressionUUID->"54240660-ac8a-284c-80d7-1e31b6e090c8"],

Cell["phase noise,", "Item",ExpressionUUID->"10109932-8873-7a43-8267-061a49bf9aff"],

Cell["hysteresis,", "Item",ExpressionUUID->"5a94e295-8bf6-f341-97fd-42f289e33622"],

Cell["drift.", "Item",ExpressionUUID->"1fe8a086-ccea-fc45-9ebe-fb5c613b9b3e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.2. Test", "Subsection",ExpressionUUID->"2086a8ef-2d9e-6042-a4ad-cd834f68679f"],

Cell["Train two predictive models:", "Text",ExpressionUUID->"e0da05ad-a43a-214d-a819-c1202958248d"],

Cell["\<\
1. standard reduced model using scalar value and basic covariates,\
\>", "Text",ExpressionUUID->"5db1298d-cc8f-324a-9a7e-3473cd9c22e1"],

Cell["2. enriched model using measurement-state descriptors.", "Text",ExpressionUUID->"e6a41b6d-6fec-0140-a55f-17156fde8609"],

Cell["Then compare predictive performance on held-out trials.", "Text",ExpressionUUID->"473ef815-65d9-ce4c-b9aa-b6123674b4a4"],

Cell["This is one of the easiest and most rigorous first tests. ", "Text",ExpressionUUID->"b89c097f-df24-f549-8f97-3f9786a2016f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.3. Wolfram Language evaluation path", "Subsection",ExpressionUUID->"b81511f0-8f31-fa45-881d-4227d5992d0e"],

Cell[TextData[{
 "Use ",
 ButtonBox["PredictorMeasurements",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PredictorMeasurements"],
 " and ",
 ButtonBox["PredictorMeasurementsObject",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PredictorMeasurementsObject"],
 " to compare models on held-out data."
}], "Text",ExpressionUUID->"bed94306-3364-c645-8c35-74096ebb8862"],

Cell["Possible useful properties include: ", "Text",ExpressionUUID->"f4143c04-55c0-4549-81b6-5643e7546b72"],

