Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 "04",
 StyleBox["RHUFT",
  FontSlant->Italic],
 "Experimental",
 StyleBox["Programs",
  FontSlant->Italic],
 "Sensor",
 StyleBox["Geometries",
  FontSlant->Italic],
 "And",
 StyleBox["Testable",
  FontSlant->Italic],
 "Predictions"
}], "Title",ExpressionUUID->"829a04a0-0f8d-fb43-bd14-79220688898c"],

Cell[CellGroupData[{

Cell["Purpose", "Section",ExpressionUUID->"4251fd20-1e42-1c4f-834d-853c17e977b2"],

Cell[TextData[{
 "This is ",
 StyleBox["Notebook 4",
  FontWeight->Bold],
 " in the RHUFT series."
}], "Text",ExpressionUUID->"ea6307be-7ac2-0d4a-8c0a-2fda2179f4af"],

Cell[TextData[{
 "Its goal is to convert the ontological and measurement-theoretic framework \
of the earlier notebooks into a ",
 StyleBox["rigorous experimental program",
  FontWeight->Bold],
 ". The emphasis here is not on grand claims, but on identifying:"
}], "Text",ExpressionUUID->"d52d1a9f-b2f1-8244-8568-2845b51f93ef"],

Cell["1. what can be operationally defined,", "Text",ExpressionUUID->"7d5d0880-1237-6242-b702-f1352f36ca09"],

Cell["2. what can be measured now,", "Text",ExpressionUUID->"bc803301-c45f-1643-91a4-3a2c8b7ede2d"],

Cell["3. what can be compared against standard models,", "Text",ExpressionUUID->"e9abdcef-06a4-ea47-9ce7-d024d014a4f8"],

Cell["4. what could falsify the framework,", "Text",ExpressionUUID->"fc6b7c49-4794-764d-bbae-bc6f975e15d5"],

Cell["\<\
5. what geometry-sensitive instrumentation strategies are realistically \
buildable.\
\>", "Text",ExpressionUUID->"978da264-7aab-a74b-87df-b436411dd393"],

Cell["\<\
This notebook is therefore deliberately conservative in empirical posture and \
ambitious in methodological design.\
\>", "Text",ExpressionUUID->"7d01561f-7670-624f-9234-4dd0fa20b92f"],

Cell["The central scientific principle is: ", "Text",ExpressionUUID->"cbb0bca7-0f3f-2c4a-b8d4-7a3f804c2ece"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"a framework becomes physically serious only when it \
generates measurement protocols whose outcomes are not already guaranteed by \
ordinary instrument artifacts or standard theory.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"ef4a07df-60c0-4c45-8814-75ca594e82d8"],

