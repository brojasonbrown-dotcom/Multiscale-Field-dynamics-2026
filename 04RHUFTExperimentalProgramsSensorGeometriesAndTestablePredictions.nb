}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Measurement-state vector for experiments", "Section",ExpressionUUID->"4d6badf0-911f-1449-8870-50cf24e87727"],

Cell[TextData[{
 "A standard result is often reported as: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["v", "TI"], ",", "\[CapitalDelta]", 
           StyleBox["v", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(v,\\Delta v)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8914e6d-95a1-5940-a72b-f96a042ccaa9"],
 "RHUFT proposes the enriched vector: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["v", "TI"], ",", "\[CapitalDelta]", 
             StyleBox["v", "TI"], ",", 
             SubscriptBox["\[Sigma]", 
              StyleBox["eff", FontSlant -> "Plain"]], ",", 
             SubscriptBox[
              StyleBox["c", "TI"], 
              StyleBox["eff", FontSlant -> "Plain"]], ",", 
             SubscriptBox["\[Kappa]", 
              StyleBox["eff", FontSlant -> "Plain"]], ",", 
             SubscriptBox["\[Phi]", 
              StyleBox["eff", FontSlant -> "Plain"]], ",", 
             SubscriptBox[
              StyleBox["h", "TI"], 
              StyleBox["eff", FontSlant -> "Plain"]], ",", 
             SubscriptBox[
              StyleBox["g", "TI"], 
              StyleBox["int", FontSlant -> "Plain"]], ",", 
             SubscriptBox[
              StyleBox["b", "TI"], 
              StyleBox["env", FontSlant -> "Plain"]]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathfrak{m} = (v,\\Delta v,\\sigma_{\\mathrm{eff}},c_{\\mathrm{eff}},\
\\kappa_{\\mathrm{eff}},\\phi_{\\mathrm{eff}},h_{\\mathrm{eff}},g_{\\mathrm{\
int}},b_{\\mathrm{env}})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a8449c0a-ecda-f24d-b61e-a0100520ab0a"],
 "where: "
}], "Text",ExpressionUUID->"86c305e0-eb6a-2a46-8100-ab82a446e849"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["v", "TI"], TraditionalForm], "errors" -> {}, "input" -> "v", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "807d9f1f-1ed8-7f46-924a-234d0b3a1d97"],
 " = measured value,"
}], "Item",ExpressionUUID->"ca7f1f07-144f-0442-9b88-af4b40f4bcb9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["v", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta v", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "636282dd-9aab-064c-af96-177056d8b65c"],
 " = uncertainty,"
}], "Item",ExpressionUUID->"0f713b0b-e41a-914c-8e30-ecfacc607771"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Sigma]", 
        StyleBox["eff", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sigma_{\\mathrm{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8651405-4b24-a24b-a6a1-50ef12983eea"],
 " = effective scale/resolution,"
}], "Item",ExpressionUUID->"9a3d5c67-c685-964d-89df-51853b88bf4d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["c", "TI"], 
        StyleBox["eff", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "c_{\\mathrm{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5ac28e3d-5b8a-5b4f-a1f9-41f1c68c08d1"],
 " = coherence proxy,"
}], "Item",ExpressionUUID->"3934ef5b-4e8d-cb43-8153-0ae6285cec39"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Kappa]", 
        StyleBox["eff", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "\\kappa_{\\mathrm{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a602feb1-0700-2040-a449-9122d58046e4"],
 " = closure or recurrence proxy,"
}], "Item",ExpressionUUID->"9936dce4-4941-a249-81ff-053aaa8e7f80"],

