  True,ExpressionUUID->"7b3c1c68-5097-9d49-af48-1370856935dc"]], "Item",Expres\
sionUUID->"bfa272b9-26f2-5d42-9d00-ff211ecfcd13"],

Cell[TextData[Cell[BoxData["\"\<ResidualPlot\>\""], "InlineWL", "Input",
