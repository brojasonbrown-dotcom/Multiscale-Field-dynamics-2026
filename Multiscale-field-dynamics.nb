        "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1.0", ",", "0.8"}], "}"}], ",", "0.8", ",", "0.9"}], "}"}], 
      ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.5", ",", 
          RowBox[{"-", "1.2"}]}], "}"}], ",", "0.6", ",", "1.1"}], "}"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
