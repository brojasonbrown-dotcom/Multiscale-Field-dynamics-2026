Cell[CellGroupData[{

Cell["3. Setup", "Section",ExpressionUUID->"bc7fb73e-9bca-764a-a96b-3ddeff75ba18"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "x", ",", "y", ",", "z", ",", "t", ",", "r", ",", "\[Theta]", ",", 
         "\[Phi]", ",", "u", ",", "v", ",", "s", ",", "k", ",", "q", ",", 
