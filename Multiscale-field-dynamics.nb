Cell["\<\
This is the rigorous meaning of \[OpenCurlyDoubleQuote]resonant cavity \
structure\[CloseCurlyDoubleQuote] for bounded domains: \
\>", "Text",ExpressionUUID->"cb880765-68ec-7343-8440-05fc044aaf07"],

Cell["the geometry determines the operator,", "Item",ExpressionUUID->"7d477dc6-3144-d749-9b3d-118bd7731c48"],

Cell["the operator determines the eigenmodes,", "Item",ExpressionUUID->"2ab2a0bc-1c9d-8042-ac05-2b1c12cc66c2"],

Cell["the eigenmodes determine admissible standing patterns,", "Item",ExpressionUUID->"7c4a4478-3d28-4f4b-bf82-a87d5c557b36"],

Cell["damping and forcing determine persistence.", "Item",ExpressionUUID->"8573a27d-5191-ab4a-bd65-824b027416c7"],

