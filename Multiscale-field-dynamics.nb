Cell[CellGroupData[{

Cell["11. Cross-scale coupled-mode systems", "Section",ExpressionUUID->"e3ed716c-610d-e04a-90dc-f35817d6c25a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"coupledModeMatrix", ",", "coupledModeFlow"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"coupledModeMatrix", "[", 
     RowBox[{
      RowBox[{"n_Integer", "?", "Positive"}], ",", 
      RowBox[{"damping_", "?", "NumericQ"}], ",", 
      RowBox[{"coupling_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"diag", ",", "off"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"diag", "=", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "damping"}], "-", 
            RowBox[{"i", "/", "10"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"off", "=", 
        RowBox[{
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "2"}], "}"}], "]"}], "->", "coupling"}], ",", 
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"2", ",", "1"}], "}"}], "]"}], "->", "coupling"}]}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "n"}], "}"}]}], "]"}], " ", "//", " ", 
         "Normal"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"diag", "+", "off"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coupledModeFlow", "[", 
    RowBox[{
     RowBox[{"matrix_", "?", "MatrixQ"}], ",", "init_List", ",", 
     RowBox[{"tmax_", "?", "NumericQ"}]}], "]"}], ":=", "\[IndentingNewLine]",
    "  ", 
   RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"a", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"matrix", " ", ".", " ", 
         RowBox[{"a", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
       "      ", 
       RowBox[{
        RowBox[{"a", "[", "0", "]"}], "==", "init"}]}], "\[IndentingNewLine]",
       "    ", "}"}], ",", "\[IndentingNewLine]", "    ", "a", ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "\[IndentingNewLine]", 
    "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[161]:=",ExpressionUUID->"160e27a1-9f6f-604a-9e1f-fb37dc3864b7"],

