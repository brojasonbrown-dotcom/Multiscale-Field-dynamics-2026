Cell[CellGroupData[{

Cell["1. Conceptual core", "Section",ExpressionUUID->"bec0558a-9eb2-3246-be3a-a123fae5dbe3"],

Cell["The framework is decomposed into six distinct sectors:", "Text",ExpressionUUID->"e9d2a0f3-b227-a945-b30c-d278f5ddad0f"],

Cell[TextData[{
 "1. ",
 StyleBox["Geometry and substrate",
  FontWeight->Bold],
 "2. ",
 StyleBox["Local dynamics and spectral persistence",
  FontWeight->Bold],
 "3. ",
 StyleBox["Scale transformations and robustness",
  FontWeight->Bold],
 "4. ",
 StyleBox["Selection stability under repeated interaction",
  FontWeight->Bold],
 "5. ",
 StyleBox["Field topology, circulation, and equilibrium pockets",
  FontWeight->Bold],
 "6. ",
 StyleBox["Cross-scale transfer and synthesis diagnostics",
  FontWeight->Bold],
 "This separation prevents multiple different mechanisms from being collapsed \
into one undefined word such as \[OpenCurlyDoubleQuote]vortex,\
\[CloseCurlyDoubleQuote] \[OpenCurlyDoubleQuote]measurement,\
\[CloseCurlyDoubleQuote] or \[OpenCurlyDoubleQuote]stability.\
\[CloseCurlyDoubleQuote] "
}], "Text",ExpressionUUID->"ee3cae62-f615-3d4b-b635-e4cd8a90a0b1"],

