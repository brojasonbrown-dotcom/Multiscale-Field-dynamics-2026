Cell[CellGroupData[{

Cell["8. Selection stability under repeated interaction", "Section",ExpressionUUID->"9bc35c01-6b03-7a4d-80cc-be09b776afdb"],

Cell["\<\
This is the rigorous implementation of a simple decohering or state-selection \
channel. \
\>", "Text",ExpressionUUID->"590f62bf-2772-714e-b309-db1452bdc096"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "dephasingChannel", ",", "\[IndentingNewLine]", "  ", "phaseUnitary", ",",
      "\[IndentingNewLine]", "  ", "selfMeasurementStep", ",", 
     "\[IndentingNewLine]", "  ", "pointerModeData", ",", 
     "\[IndentingNewLine]", "  ", "quasiPeriodicSchedule", ",", 
     "\[IndentingNewLine]", "  ", "densityEntropy"}], "\[IndentingNewLine]", 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dephasingChannel", "[", 
     RowBox[{
      RowBox[{"state_", "?", "MatrixQ"}], ",", 
      RowBox[{"p_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"diag", ",", "offDiag"}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"diag", "=", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Diagonal", "[", "state", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"offDiag", "=", 
        RowBox[{"state", "-", "diag"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"diag", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], " ", "offDiag"}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"phaseUnitary", "[", "phases_List", "]"}], ":=", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"Exp", "[", 
      RowBox[{"I", " ", "phases"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"selfMeasurementStep", "[", 
     RowBox[{
      RowBox[{"state_", "?", "MatrixQ"}], ",", "phases_List", ",", 
      RowBox[{"p_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "u", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"u", "=", 
        RowBox[{"phaseUnitary", "[", "phases", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"dephasingChannel", "[", 
        RowBox[{
         RowBox[{"u", " ", ".", " ", "state", " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ",", "p"}], 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"pointerModeData", "[", 
     RowBox[{
      RowBox[{"initialState_", "?", "MatrixQ"}], ",", "phaseSchedule_List", ",", 
      RowBox[{"p_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "orbit", ",", "finalState", ",", "weights", ",", "coherenceNorms"}], 
       "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"orbit", "=", 
        RowBox[{"FoldList", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"selfMeasurementStep", "[", 
            RowBox[{"#1", ",", "#2", ",", "p"}], "]"}], " ", "&"}], ",", 
          "initialState", ",", "phaseSchedule"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"finalState", "=", 
        RowBox[{"Last", "[", "orbit", "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"weights", "=", 
        RowBox[{"Chop", "[", 
         RowBox[{"Diagonal", "[", "finalState", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"coherenceNorms", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"#", "-", 
              RowBox[{"DiagonalMatrix", "[", 
               RowBox[{"Diagonal", "[", "#", "]"}], "]"}]}], "]"}], ",", 
            "2"}], "]"}], " ", "&"}], " ", "/@", " ", "orbit"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Orbit\>\"", "->", "orbit"}], ",", "\[IndentingNewLine]",
          "    ", 
         RowBox[{"\"\<FinalState\>\"", "->", "finalState"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<PointerWeights\>\"", "->", "weights"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<DominantPointerIndex\>\"", "->", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Ordering", "[", 
            RowBox[{"weights", ",", 
             RowBox[{"-", "1"}]}], "]"}]}]}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<CoherenceNorms\>\"", "->", "coherenceNorms"}]}], 
        "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"quasiPeriodicSchedule", "[", 
     RowBox[{
      RowBox[{"steps_Integer", "?", "Positive"}], ",", 
      RowBox[{"dim_Integer", "?", "Positive"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"n", " ", 
         RowBox[{"Sqrt", "[", "j", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "dim"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "steps"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"densityEntropy", "[", 
    RowBox[{"state_", "?", "MatrixQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "vals", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"vals", "=", 
       RowBox[{"Chop", "[", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"N", " ", "@", " ", "state"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"-", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"vals", ",", 
           RowBox[{
            RowBox[{"#", ">", "0"}], " ", "&"}]}], "]"}], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"Select", "[", 
           RowBox[{"vals", ",", 
            RowBox[{
             RowBox[{"#", ">", "0"}], " ", "&"}]}], "]"}], "]"}]}], 
        "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[136]:=",ExpressionUUID->"2121febd-eb08-994a-91f0-d508976dbfd3"],

Cell[CellGroupData[{

Cell["8.1 Rigorous selection tests", "Subsection",ExpressionUUID->"3e890f55-a196-974d-83b1-612d7989f388"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "selectionTestReport", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"selectionTestReport", "[", 
    RowBox[{
     RowBox[{"initialState_", "?", "MatrixQ"}], ",", "phaseSchedule_List", ",", 
     RowBox[{"p_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", "entropies"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"pointerModeData", "[", 
        RowBox[{"initialState", ",", "phaseSchedule", ",", "p"}], "]"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"entropies", "=", 
       RowBox[{"densityEntropy", " ", "/@", " ", 
        RowBox[{"data", "[", "\"\<Orbit\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<SelectionData\>\"", "->", "data"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<EntropyHistory\>\"", "->", "entropies"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<CoherenceDecayQ\>\"", "->", 
         RowBox[{"OrderedQ", "[", 
          RowBox[{"Reverse", "[", 
           RowBox[{"data", "[", "\"\<CoherenceNorms\>\"", "]"}], "]"}], 
          "]"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<PointerDominanceQ\>\"", "->", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"data", "[", "\"\<PointerWeights\>\"", "]"}], "]"}], ">", 
          RowBox[{"1", "/", "2"}]}]}]}], "\[IndentingNewLine]", "  ", 
       "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[143]:=",ExpressionUUID->"e4367369-9ae9-ab43-b8d9-98411d595a47"],

