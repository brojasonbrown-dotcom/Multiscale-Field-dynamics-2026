  RowBox[{
   RowBox[{"spectralPanel", "[", 
    RowBox[{"matrix_", "?", "MatrixQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", "=", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"N", " ", "@", " ", "matrix"}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"GraphicsGrid", "[", 
