Cell[CellGroupData[{

Cell["5.2 Spectral test suite", "Subsection",ExpressionUUID->"633efcb8-b1b8-5741-94e9-a32c51b6ff85"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "spectralConvergenceReport", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spectralConvergenceReport", "[", 
    RowBox[{"operatorBuilder_", ",", "modeCounts_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"table", ",", "margins"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{
      RowBox[{"table", "=", 
       RowBox[{"truncationStabilityTable", "[", 
        RowBox[{"operatorBuilder", ",", "modeCounts"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"margins", "=", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"table", "[", "#", "]"}], 
           "[", "\"\<StabilityMarginContinuous\>\"", "]"}], " ", "&"}], ",", 
         "modeCounts"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Table\>\"", "->", "table"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Margins\>\"", "->", "margins"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ConvergentMarginQ\>\"", "->", 
         RowBox[{"Quiet", "[", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{"Round", "[", 
              RowBox[{
               RowBox[{"Values", "[", "margins", "]"}], ",", 
               RowBox[{"10", "^", 
                RowBox[{"-", "6"}]}]}], "]"}], "]"}], "]"}], "<=", "3"}], 
          "]"}]}]}], "\[IndentingNewLine]", "  ", "|>"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[120]:=",ExpressionUUID->"de26c23a-1d0f-c043-9a75-1ed9eeeef1cb"],

