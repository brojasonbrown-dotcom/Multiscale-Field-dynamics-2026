Cell[CellGroupData[{

Cell["13. Unified multiscale report", "Section",ExpressionUUID->"e48563e0-f598-b44a-bc95-09b40c3f5639"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"multiscaleResonanceReport", ",", "synthesisEvidenceScore"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"multiscaleResonanceReport", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"matrix_", "?", "MatrixQ"}], ",", "\[IndentingNewLine]", "  ", 
      "state_List", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"initialDensity_", "?", "MatrixQ"}], ",", "\[IndentingNewLine]",
       "  ", "phaseSchedule_List", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"p_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"scaleSteps_Integer", ":", " ", "8"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"tol_", ":", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "8"}]}]}]}], "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"spec", ",", "scale", ",", "selection", ",", "verdict"}], 
       "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"spec", "=", 
        RowBox[{"spectralData", "[", "matrix", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"scale", "=", 
        RowBox[{"scaleFixedPointData", "[", 
         RowBox[{"state", ",", "scaleSteps", ",", "tol"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"selection", "=", 
        RowBox[{"pointerModeData", "[", 
         RowBox[{"initialDensity", ",", "phaseSchedule", ",", "p"}], "]"}]}], 
       ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"verdict", "=", 
        RowBox[{"<|", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"\"\<SpectrallyStableQ\>\"", "->", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"spec", "[", "\"\<ContinuousTimeStableQ\>\"", "]"}], 
            "]"}]}], ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<ScaleRobustQ\>\"", "->", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"scale", "[", "\"\<FixedPointQ\>\"", "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<SelectionStableQ\>\"", "->", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"selection", "[", "\"\<PointerWeights\>\"", "]"}], "]"}],
             ">", 
            RowBox[{"1", "/", "2"}]}]}]}], "\[IndentingNewLine]", "  ", 
         "|>"}]}], ";", " ", "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Spectral\>\"", "->", "spec"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Scale\>\"", "->", "scale"}], ",", "\[IndentingNewLine]",
          "    ", 
         RowBox[{"\"\<Selection\>\"", "->", "selection"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Verdict\>\"", "->", "verdict"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<AllThreeQ\>\"", "->", 
          RowBox[{"And", " ", "@@", " ", 
           RowBox[{"Values", "[", "verdict", "]"}]}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<FixedScaleResidual\>\"", "->", 
          RowBox[{"fixedScaleResidual", "[", "state", "]"}]}]}], 
        "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"synthesisEvidenceScore", "[", "report_Association", "]"}], ":=", 
   RowBox[{"Mean", " ", "@", " ", 
    RowBox[{"Boole", " ", "@", " ", 
     RowBox[{"Values", "[", 
      RowBox[{"report", "[", "\"\<Verdict\>\"", "]"}], "]"}]}]}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[169]:=",ExpressionUUID->"96d77778-1095-4046-a4ba-0840e8cb1883"],

