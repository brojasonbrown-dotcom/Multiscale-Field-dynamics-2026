Cell[CellGroupData[{

Cell["0. Epistemic policy", "Section",ExpressionUUID->"e3eadc99-0f56-d349-a978-579b016d1c08"],

Cell["This notebook uses four labels throughout: ", "Text",ExpressionUUID->"633e0832-51d7-3a43-9879-8a1581800af6"],

Cell[TextData[{
 StyleBox["Established",
  FontWeight->Bold],
 ": standard mathematics or physics already well defined."
}], "Item",ExpressionUUID->"9e5199fa-710e-1d4b-9452-09383c661820"],

Cell[TextData[{
 StyleBox["Model hypothesis",
  FontWeight->Bold],
 ": a proposed structure that can be tested."
}], "Item",ExpressionUUID->"cacc5755-2da2-8b40-ad65-9090c9e53a49"],

Cell[TextData[{
 StyleBox["Analogy",
  FontWeight->Bold],
 ": a structural resemblance between different systems."
}], "Item",ExpressionUUID->"62fcc5a8-efa0-3244-b377-2c8d5eb321e2"],

Cell[TextData[{
 StyleBox["Speculation",
  FontWeight->Bold],
 ": an interpretation not derivable from the current mathematics."
}], "Item",ExpressionUUID->"42a2849f-8eaa-2546-a403-1edd9883bd21"],

Cell["\<\
The purpose of this notebook is to keep the first two computationally \
rigorous. \
\>", "Text",ExpressionUUID->"eae322f7-2ffa-854f-bc6f-77c8b0222b61"],

