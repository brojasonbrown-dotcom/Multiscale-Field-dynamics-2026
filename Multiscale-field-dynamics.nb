Cell[CellGroupData[{

Cell["6. PDE eigenmode layer", "Section",ExpressionUUID->"6ee85985-4b76-e140-84db-f5a5f22b5e9e"],

Cell["This is the more rigorous route for continuous systems. ", "Text",ExpressionUUID->"ce3592d3-8996-7141-8c78-e551e5532dc8"],

Cell[CellGroupData[{

Cell["6.1 One-dimensional Sturm\[Dash]Liouville example", "Subsection",ExpressionUUID->"680b29f9-ddf9-bd43-9abb-c4526b4b9cb1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "oneDPDEEigensystem", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"oneDPDEEigensystem", "[", 
    RowBox[{"n_Integer", "?", "Positive"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"NDEigensystem", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"u", "''"}], "[", "x", "]"}]}], ",", "\[IndentingNewLine]", 
       "      ", 
       RowBox[{"DirichletCondition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"x", "==", "0"}], "||", 
          RowBox[{"x", "==", "1"}]}]}], "]"}]}], "\[IndentingNewLine]", 
      "    ", "}"}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"u", "[", "x", "]"}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
     "    ", "n"}], "\[IndentingNewLine]", "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->
