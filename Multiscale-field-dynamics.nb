      "]"}], "&&", "\[IndentingNewLine]", "   ", 
     RowBox[{"\[Gamma]", ">=", "0"}], "&&", 
     RowBox[{"\[Alpha]", ">=", "0"}], "&&", 
     RowBox[{"\[Beta]", ">=", "0"}], "&&", 
     RowBox[{"\[CurlyEpsilon]", ">", "0"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords1", "=", 
   RowBox[{"{", "x", "}"}]}], ";"}], "\[IndentingNewLine]", 
