Cell[CellGroupData[{

Cell["\<\
9. Source fields, effective potentials, and equilibrium pockets\
\>", "Section",ExpressionUUID->"a55b067d-73fd-334c-b41c-e2b71225def5"],

Cell["\<\
This section models the emergence of local stable regions from source \
distributions. \
\>", "Text",ExpressionUUID->"b0a5e845-18ac-2f47-8055-3e03c76ae1c9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "gaussianSourcePotential", ",", "\[IndentingNewLine]", "  ", 
     "sourceFieldPotential", ",", "\[IndentingNewLine]", "  ", 
     "effectivePotential2D", ",", "\[IndentingNewLine]", "  ", 
     "effectiveForce2D", ",", "\[IndentingNewLine]", "  ", 
     "rotatingFrameEquilibria", ",", "\[IndentingNewLine]", "  ", 
     "jacobian2D", ",", "\[IndentingNewLine]", "  ", "equilibriumStability2D",
      ",", "\[IndentingNewLine]", "  ", "hessian2D", ",", 
     "\[IndentingNewLine]", "  ", "basinType2D"}], "\[IndentingNewLine]", 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gaussianSourcePotential", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x0_", ",", "y0_"}], "}"}], ",", "amp_", ",", "width_"}], 
      "]"}], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"-", "amp"}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "x0"}], ")"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"y", "-", "y0"}], ")"}], "^", "2"}]}], ")"}]}], "/", 
       RowBox[{"width", "^", "2"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sourceFieldPotential", "[", "sources_List", "]"}], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Total", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"gaussianSourcePotential", "[", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "[", 
        RowBox[{"x", ",", "y"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "sources"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"effectivePotential2D", "[", 
      RowBox[{"pot_", ",", 
       RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}]}], "]"}], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"pot", "[", 
      RowBox[{"x", ",", "y"}], "]"}], "-", 
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"\[CapitalOmega]", "^", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "^", "2"}], "+", 
        RowBox[{"y", "^", "2"}]}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"effectiveForce2D", "[", 
      RowBox[{"pot_", ",", 
       RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}]}], "]"}], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"-", 
     RowBox[{"Grad", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"effectivePotential2D", "[", 
         RowBox[{"pot", ",", "\[CapitalOmega]"}], "]"}], "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rotatingFrameEquilibria", "[", 
     RowBox[{"pot_", ",", 
      RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Solve", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"effectiveForce2D", "[", 
          RowBox[{"pot", ",", "\[CapitalOmega]"}], "]"}], "[", 
         RowBox[{"x", ",", "y"}], "]"}], "==", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      "Reals"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"jacobian2D", "[", 
     RowBox[{"field_", ",", "vars_List"}], "]"}], ":=", 
    RowBox[{"D", "[", 
     RowBox[{"field", ",", 
      RowBox[{"{", "vars", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hessian2D", "[", 
     RowBox[{"f_", ",", "vars_List"}], "]"}], ":=", 
    RowBox[{"D", "[", 
     RowBox[{"f", ",", 
      RowBox[{"{", 
       RowBox[{"vars", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"basinType2D", "[", 
     RowBox[{"pot_", ",", 
      RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}], ",", 
      RowBox[{"point", " ", ":", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x0_", "?", "NumericQ"}], ",", 
         RowBox[{"y0_", "?", "NumericQ"}]}], "}"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"hess", ",", "vals"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"hess", "=", 
        RowBox[{"N", " ", "@", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"hessian2D", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"effectivePotential2D", "[", 
               RowBox[{"pot", ",", "\[CapitalOmega]"}], "]"}], "[", 
              RowBox[{"x", ",", "y"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}]}], "]"}], " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x", "->", "x0"}], ",", 
             RowBox[{"y", "->", "y0"}]}], "}"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"vals", "=", 
        RowBox[{"Eigenvalues", "[", "hess", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"Which", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"vals", ">", "0"}], "]"}]}], ",", "\"\<LocalMinimum\>\"", ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"vals", "<", "0"}], "]"}]}], ",", "\"\<LocalMaximum\>\"", ",",
          "\[IndentingNewLine]", "    ", "True", ",", "\"\<Saddle\>\""}], 
        "\[IndentingNewLine]", "  ", "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"equilibriumStability2D", "[", 
    RowBox[{"pot_", ",", 
     RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}], ",", 
     RowBox[{"point", " ", ":", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x0_", "?", "NumericQ"}], ",", 
        RowBox[{"y0_", "?", "NumericQ"}]}], "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "jac", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"jac", "=", 
       RowBox[{"N", " ", "@", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"jacobian2D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"effectiveForce2D", "[", 
              RowBox[{"pot", ",", "\[CapitalOmega]"}], "]"}], "[", 
             RowBox[{"x", ",", "y"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}]}], "]"}], " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x", "->", "x0"}], ",", 
            RowBox[{"y", "->", "y0"}]}], "}"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Point\>\"", "->", "point"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Jacobian\>\"", "->", "jac"}], ",", "\[IndentingNewLine]",
         "    ", 
        RowBox[{"\"\<Eigenvalues\>\"", "->", 
         RowBox[{"Eigenvalues", "[", "jac", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<BasinType\>\"", "->", 
         RowBox[{"basinType2D", "[", 
          RowBox[{"pot", ",", "\[CapitalOmega]", ",", "point"}], "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[145]:=",ExpressionUUID->"6db4c2ba-f5cb-4343-bbf8-b07b072c17d0"],

Cell[CellGroupData[{

Cell["Interpretation", "Subsection",ExpressionUUID->"64a045ab-8321-a944-8128-bda7202d2692"],

