Cell[CellGroupData[{

Cell["12. Hyperuniformity and structured order diagnostics", "Section",ExpressionUUID->"ddc8ce5b-c53c-be41-be13-f8822a121bd2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "primeIndicatorSequence", ",", "\[IndentingNewLine]", "  ", 
     "structureFactor1D", ",", "\[IndentingNewLine]", "  ", 
     "numberVariance1D", ",", "\[IndentingNewLine]", "  ", 
     "hyperuniformityProxy"}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"primeIndicatorSequence", "[", 
     RowBox[{"n_Integer", "?", "Positive"}], "]"}], ":=", 
    RowBox[{"Boole", "[", 
     RowBox[{"PrimeQ", " ", "/@", " ", 
      RowBox[{"Range", "[", "n", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"structureFactor1D", "[", "list_List", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Fourier", "[", 
        RowBox[{"N", " ", "@", " ", "list"}], "]"}], "]"}], "^", "2"}], "/", 
     RowBox[{"Length", "[", "list", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"numberVariance1D", "[", 
     RowBox[{"list_List", ",", 
      RowBox[{"window_Integer", "?", "Positive"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "sums", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"sums", "=", 
        RowBox[{"Total", " ", "/@", " ", 
         RowBox[{"Partition", "[", 
          RowBox[{"list", ",", "window", ",", "1"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"Variance", "[", "sums", "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hyperuniformityProxy", "[", "list_List", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "sf", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"sf", "=", 
       RowBox[{"structureFactor1D", "[", "list", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<LowFrequencyMean\>\"", "->", 
         RowBox[{"Mean", "[", 
          RowBox[{"Take", "[", 
           RowBox[{"sf", ",", 
            RowBox[{"UpTo", "[", "5", "]"}]}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Spectrum\>\"", "->", "sf"}]}], "\[IndentingNewLine]", 
       "  ", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[164]:=",ExpressionUUID->"0a8661a4-7ae3-7645-9ca9-db2c2970ae53"],

