Cell[CellGroupData[{

Cell["10. Field circulation, curl, and phase winding", "Section",ExpressionUUID->"3797b33b-3bdc-1344-9570-5ebf87396362"],

Cell["This section separates distinct meanings of \
\[OpenCurlyDoubleQuote]vortex.\[CloseCurlyDoubleQuote] ", "Text",ExpressionUUI\
D->"3d374bc4-d7b8-e141-9ece-1df7bc8adc8e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "curl2D", ",", "\[IndentingNewLine]", "  ", "circulationIntegral", ",", 
     "\[IndentingNewLine]", "  ", "phaseWindingNumber", ",", 
     "\[IndentingNewLine]", "  ", "helicityDensitySymbolic", ",", 
     "\[IndentingNewLine]", "  ", "streamFunctionField"}], 
    "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"curl2D", "[", "field_", "]"}], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"field", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", "x"}], "]"}], "-", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"field", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", "y"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"circulationIntegral", "[", 
     RowBox[{"field_", ",", "curve_", ",", "s_Symbol", ",", 
      RowBox[{"{", 
       RowBox[{"smin_", ",", "smax_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Integrate", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"field", " ", "@@", " ", 
         RowBox[{"curve", "[", "s", "]"}]}], ")"}], " ", ".", " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"curve", "[", "s", "]"}], ",", "s"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"s", ",", "smin", ",", "smax"}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"phaseWindingNumber", "[", 
     RowBox[{"phase_", ",", "curve_", ",", "s_Symbol", ",", 
      RowBox[{"{", 
       RowBox[{"smin_", ",", "smax_"}], "}"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "Pi"}], ")"}]}], ")"}], " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"phase", " ", "@@", " ", 
          RowBox[{"curve", "[", "s", "]"}]}], ",", "s"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "smin", ",", "smax"}], "}"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"helicityDensitySymbolic", "[", 
     RowBox[{"vecPotential_", ",", "vars_List"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"vecPotential", " ", ".", " ", 
     RowBox[{"Curl", "[", 
      RowBox[{"vecPotential", ",", "vars"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"streamFunctionField", "[", "\[Psi]_", "]"}], "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Psi]", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], ",", 
     RowBox[{"-", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Psi]", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[155]:=",ExpressionUUID->"0217378e-d929-4641-8fee-4b91f7b1d4ac"],

