Cell[CellGroupData[{

Cell["4. Geometry and substrate layer", "Section",ExpressionUUID->"d3a515a7-ad90-bf4c-a519-3eda63e8b55e"],

Cell[CellGroupData[{

Cell["4.1 Parametric geometries", "Subsection",ExpressionUUID->"0dd764e3-ba70-9746-a426-0a0962f4784b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"sphereParam", ",", "torusEmbedding", ",", "radialDistance"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sphereParam", "[", "\[Rho]_", "]"}], "[", 
     RowBox[{"\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\[Rho]", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\[Rho]", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\[Rho]", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"torusEmbedding", "[", 
      RowBox[{
       RowBox[{"majorRadius_", "?", "NumericQ"}], ",", 
       RowBox[{"minorRadius_", "?", "NumericQ"}]}], "]"}], "[", 
     RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"majorRadius", "+", 
         RowBox[{"minorRadius", " ", 
          RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
       RowBox[{"Cos", "[", "u", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"majorRadius", "+", 
         RowBox[{"minorRadius", " ", 
          RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
       RowBox[{"Sin", "[", "u", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"minorRadius", " ", 
       RowBox[{"Sin", "[", "v", "]"}]}]}], "\[IndentingNewLine]", "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"radialDistance", "[", 
     RowBox[{"{", 
      RowBox[{"x0_", ",", "y0_"}], "}"}], "]"}], "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "x0"}], ")"}], "^", "2"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"y", "-", "y0"}], ")"}], "^", "2"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[109]:=",ExpressionUUID->"ae9fdf44-2930-2b4a-8088-749ccdc84a9d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2 Interpretation", "Subsection",ExpressionUUID->"fb762558-9097-5945-8fa4-1e071fab15ab"],

Cell["\<\
Sphere-like geometry is suitable for shell-like or isotropic closed systems.\
\>", "Item",ExpressionUUID->"928d7dc2-8c04-af40-a7eb-6ece5624d0d4"],

Cell["\<\
Torus-like geometry is suitable for recirculating, looped, or doubly periodic \
organization.\
\>", "Item",ExpressionUUID->"290feb55-f1fd-d746-ac7a-2fa698fa7a72"],

Cell["\<\
Lattices and graphs are suitable for discrete coupled systems.\
\>", "Item",ExpressionUUID->"c1684ef7-694e-a142-b941-10e9bd2325b4"],

Cell["These are modeling choices, not universal identities. ", "Text",ExpressionUUID->"e346eb22-afdd-0149-bec9-d8f82562b732"],

