Cell[CellGroupData[{

Cell["7. Scale transformations and robustness", "Section",ExpressionUUID->"ee4c77e4-5cdb-f941-a1cd-67910ea65889"],

Cell[CellGroupData[{

Cell["7.1 Corrected coarse-graining", "Subsection",ExpressionUUID->"968f6671-979f-0040-9d54-d6ee27163ba1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "dyadicCoarseGrain", ",", "\[IndentingNewLine]", "  ", "dyadicLift", ",", 
     "\[IndentingNewLine]", "  ", "rgOrbit", ",", "\[IndentingNewLine]", "  ",
      "scaleResiduals", ",", "\[IndentingNewLine]", "  ", 
     "fixedScaleResidual", ",", "\[IndentingNewLine]", "  ", 
     "scaleFixedPointData"}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"dyadicCoarseGrain", "[", "list_List", "]"}], " ", "/;", " ", 
     RowBox[{"EvenQ", "[", 
      RowBox[{"Length", "[", "list", "]"}], "]"}]}], ":=", 
    RowBox[{"Mean", " ", "/@", " ", 
     RowBox[{"Partition", "[", 
      RowBox[{"list", ",", "2"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dyadicLift", "[", "list_List", "]"}], ":=", 
    RowBox[{"Riffle", "[", 
     RowBox[{"list", ",", "list"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rgOrbit", "[", 
     RowBox[{"transform_", ",", "state_List", ",", 
      RowBox[{"steps_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"NestWhileList", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{"transform", ",", "\[IndentingNewLine]", "    ", 
      RowBox[{"N", " ", "@", " ", "state"}], ",", "\[IndentingNewLine]", 
      "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"EvenQ", "[", 
         RowBox[{"Length", "[", "#", "]"}], "]"}], "&&", 
        RowBox[{
         RowBox[{"Length", "[", "#", "]"}], ">", "1"}]}], " ", "&"}], ",", 
      "\[IndentingNewLine]", "    ", "1", ",", "\[IndentingNewLine]", "    ", 
      "steps"}], "\[IndentingNewLine]", "  ", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleResiduals", "[", 
     RowBox[{"state_List", ",", 
      RowBox[{"steps_Integer", ":", " ", "8"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"orbit", ",", "normalizedOrbit"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"orbit", "=", 
        RowBox[{"rgOrbit", "[", 
         RowBox[{"dyadicCoarseGrain", ",", "state", ",", "steps"}], "]"}]}], ";",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"normalizedOrbit", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Normalize", "[", 
           RowBox[{"#", ",", "Norm"}], "]"}], " ", "&"}], " ", "/@", " ", 
         "orbit"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Norm", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Normalize", "[", 
             RowBox[{
              RowBox[{"dyadicCoarseGrain", "[", 
               RowBox[{"normalizedOrbit", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "Norm"}], "]"}], "-", 
            RowBox[{"normalizedOrbit", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
           "\[IndentingNewLine]", "      ", "2"}], "\[IndentingNewLine]", 
          "    ", "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{
            RowBox[{"Length", "[", "normalizedOrbit", "]"}], "-", "1"}]}], 
          "}"}]}], "\[IndentingNewLine]", "  ", "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"fixedScaleResidual", "[", "state_List", "]"}], " ", "/;", " ", 
     RowBox[{"EvenQ", "[", 
      RowBox[{"Length", "[", "state", "]"}], "]"}]}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"coarse", ",", "lifted"}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"coarse", "=", 
        RowBox[{"dyadicCoarseGrain", "[", "state", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"lifted", "=", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"dyadicLift", "[", "coarse", "]"}], ",", 
          RowBox[{"Length", "[", "state", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Normalize", "[", 
           RowBox[{"lifted", ",", "Norm"}], "]"}], "-", 
          RowBox[{"Normalize", "[", 
           RowBox[{"state", ",", "Norm"}], "]"}]}], ",", "2"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleFixedPointData", "[", 
    RowBox[{"state_List", ",", 
     RowBox[{"steps_Integer", ":", " ", "8"}], ",", 
     RowBox[{"tol_", ":", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"orbit", ",", "residuals"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{
      RowBox[{"orbit", "=", 
       RowBox[{"rgOrbit", "[", 
        RowBox[{"dyadicCoarseGrain", ",", "state", ",", "steps"}], "]"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"residuals", "=", 
       RowBox[{"scaleResiduals", "[", 
        RowBox[{"state", ",", "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Orbit\>\"", "->", "orbit"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Residuals\>\"", "->", "residuals"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<FinalResidual\>\"", "->", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"residuals", "===", 
            RowBox[{"{", "}"}]}], ",", "0", ",", 
           RowBox[{"Last", "[", "residuals", "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<FixedPointQ\>\"", "->", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"residuals", "===", 
            RowBox[{"{", "}"}]}], ",", "True", ",", 
           RowBox[{
            RowBox[{"Last", "[", "residuals", "]"}], "<", "tol"}]}], 
          "]"}]}]}], "\[IndentingNewLine]", "  ", "|>"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[127]:=",ExpressionUUID->"2c8ab5fa-3333-c44d-b518-fc86617b83a3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2 Rigorous scale tests", "Subsection",ExpressionUUID->"73e1edf9-f792-854f-bbec-52021f7e5186"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "scaleTestReport", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleTestReport", "[", 
    RowBox[{"state_List", ",", 
     RowBox[{"steps_Integer", ":", " ", "8"}], ",", 
     RowBox[{"tol_", ":", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "data", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"scaleFixedPointData", "[", 
        RowBox[{"state", ",", "steps", ",", "tol"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
