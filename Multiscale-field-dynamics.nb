Cell[CellGroupData[{

Cell["5. Local dynamics and spectral persistence", "Section",ExpressionUUID->"bae6e4fd-eb0c-8345-b318-da1c9a966420"],

Cell[TextData[{
 "A broad class of systems is modeled by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[PartialD]", 
          StyleBox["t", "TI"], "2"], 
         StyleBox["u", "TI"], "+", "2", "\[Gamma] ", 
         SubscriptBox["\[PartialD]", 
          StyleBox["t", "TI"]], 
         StyleBox["u", "TI"], "+", 
         StyleBox["L", "TI"], 
         StyleBox["u", "TI"], "+", 
         StyleBox["N", "TI"], 
         RowBox[{"(", 
           StyleBox["u", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["f", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\partial_t^2 u + 2\\gamma\\,\\partial_t u + \\mathcal{L}u + \
\\mathcal{N}(u) = f", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d25de367-4a7d-fa42-a359-c612c0536212"],
 "where: "
}], "Text",ExpressionUUID->"e47bf873-ae0d-1541-bca4-2abd1c0b2031"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["u", "TI"], TraditionalForm], "errors" -> {}, "input" -> "u", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec3cb928-5d37-f945-8798-4ea0ee06d834"],
 " is the state field,"
}], "Item",ExpressionUUID->"7a74ba79-d1b6-024d-8ff6-4b89dca67375"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["L", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{L}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "35477d41-500a-5e41-bbcb-348c81f7c4d7"],
 " is the linear operator,"
}], "Item",ExpressionUUID->"809a2cd6-68e4-a847-a4fa-23d975abe0c6"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
