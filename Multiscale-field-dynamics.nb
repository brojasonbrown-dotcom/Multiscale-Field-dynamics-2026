        RowBox[{"\"\<ScaleData\>\"", "->", "data"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ResidualMonotonicNonincreaseQ\>\"", "->", 
         RowBox[{"OrderedQ", "[", 
          RowBox[{"Reverse", "[", 
           RowBox[{"data", "[", "\"\<Residuals\>\"", "]"}], "]"}], "]"}]}], ",",
         "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<FixedPointQ\>\"", "->", 
         RowBox[{"data", "[", "\"\<FixedPointQ\>\"", "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
