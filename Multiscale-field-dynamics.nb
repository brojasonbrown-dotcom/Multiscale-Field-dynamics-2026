  "21ac5eb5-534b-b343-826c-f1d9e31eac25"],
 " is forcing,"
}], "Item",ExpressionUUID->"268449e2-086d-4147-91db-63d8a28e5166"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
