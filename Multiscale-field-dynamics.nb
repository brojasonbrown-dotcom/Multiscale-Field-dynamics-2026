Cell[CellGroupData[{

Cell["5.1 Matrix surrogates and spectral diagnostics", "Subsection",ExpressionUUID->"9a84a993-9033-4443-9365-57dc062f1749"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "dampedLaplacian1D", ",", "\[IndentingNewLine]", "  ", "spectralData", ",",
      "\[IndentingNewLine]", "  ", "truncationStabilityTable", ",", 
     "\[IndentingNewLine]", "  ", "qFactor", ",", "\[IndentingNewLine]", "  ",
      "modeEnergy"}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dampedLaplacian1D", "[", 
     RowBox[{
      RowBox[{"n_Integer", "?", "Positive"}], ",", 
      RowBox[{"\[Gamma]_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "lap", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"lap", "=", 
        RowBox[{
         RowBox[{"SparseArray", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", 
              RowBox[{"-", "2"}]}], ",", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "2"}], "}"}], "]"}], "->", "1"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"2", ",", "1"}], "}"}], "]"}], "->", "1"}]}], 
            "\[IndentingNewLine]", "      ", "}"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            RowBox[{"n", ",", "n"}], "}"}]}], "\[IndentingNewLine]", "    ", 
          "]"}], " ", "//", " ", "Normal"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"lap", "-", 
        RowBox[{"\[Gamma]", " ", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"spectralData", "[", 
     RowBox[{"matrix_", "?", "MatrixQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "vals", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"vals", "=", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"N", " ", "@", " ", "matrix"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Eigenvalues\>\"", "->", "vals"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<RealParts\>\"", "->", 
          RowBox[{"Re", "[", "vals", "]"}]}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<ImaginaryParts\>\"", "->", 
          RowBox[{"Im", "[", "vals", "]"}]}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<ContinuousTimeStableQ\>\"", "->", 
          RowBox[{"And", " ", "@@", " ", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Re", "[", "vals", "]"}], "<", "0"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<DiscreteTimeStableQ\>\"", "->", 
          RowBox[{"And", " ", "@@", " ", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "vals", "]"}], "<", "1"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StabilityMarginContinuous\>\"", "->", 
          RowBox[{"-", 
           RowBox[{"Max", "[", 
            RowBox[{"Re", "[", "vals", "]"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StabilityMarginDiscrete\>\"", "->", 
          RowBox[{"1", "-", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "vals", "]"}], "]"}]}]}]}], 
        "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"truncationStabilityTable", "[", 
     RowBox[{"operatorBuilder_", ",", "modeCounts_List"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"spectralData", "[", 
        RowBox[{"operatorBuilder", "[", "#", "]"}], "]"}], " ", "&"}], ",", 
      "modeCounts"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qFactor", "[", 
     RowBox[{
      RowBox[{"\[Omega]_", "?", "NumericQ"}], ",", 
      RowBox[{"\[Gamma]_", "?", "NumericQ"}]}], "]"}], " ", "/;", " ", 
    RowBox[{"\[Gamma]", ">", "0"}]}], ":=", 
   RowBox[{"\[Omega]", "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", "\[Gamma]"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qFactor", "[", 
     RowBox[{
      RowBox[{"\[Omega]_", "?", "NumericQ"}], ",", "0"}], "]"}], ":=", 
    "Infinity"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modeEnergy", "[", 
    RowBox[{"a_", ",", "adot_", ",", 
     RowBox[{"\[Omega]_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"adot", "^", "2"}], "+", 
      RowBox[{
       RowBox[{"\[Omega]", "^", "2"}], " ", 
       RowBox[{"a", "^", "2"}]}]}], ")"}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[113]:=",ExpressionUUID->"1fccf655-25b7-df42-a10b-2a9ec3b72d30"]
