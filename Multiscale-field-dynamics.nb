         RowBox[{"ListPlot", "[", "\[IndentingNewLine]", "       ", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Re", "[", "vals", "]"}], ",", 
              RowBox[{"Im", "[", "vals", "]"}]}], "}"}], "]"}], ",", 
           "\[IndentingNewLine]", "       ", 
