Cell[CellGroupData[{

Cell["5. Unified multiscale stability report", "Section",ExpressionUUID->"b593604c-07e8-4d45-99bb-08376befbbfe"],

Cell[TextData[{
 "Now we combine the three diagnostics. This does ",
 StyleBox["not",
  FontWeight->Bold],
 " assume they are one law. It simply computes the three criteria side by \
side and reports their intersection. "
}], "Text",ExpressionUUID->"e3441f08-0943-de46-a519-dd00e6d4049d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "multiscaleStabilityReport", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"multiscaleStabilityReport", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"matrix_", "?", "MatrixQ"}], ",", "\[IndentingNewLine]", "  ", 
     "transform_", ",", "\[IndentingNewLine]", "  ", "state_", ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"initialDensity_", "?", "MatrixQ"}], ",", "\[IndentingNewLine]", 
     "  ", "phaseSchedule_List", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"p_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"steps_Integer", " ", ":", " ", "12"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"tol_", " ", ":", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}]}], "\[IndentingNewLine]", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
      "spec", ",", "\[IndentingNewLine]", "    ", "scale", ",", 
       "\[IndentingNewLine]", "    ", "pointer", ",", "\[IndentingNewLine]", 
       "    ", "verdict"}], "\[IndentingNewLine]", "  ", "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"spec", "=", 
       RowBox[{"spectralData", "[", "matrix", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"scale", "=", 
       RowBox[{"scaleFixedPointData", "[", 
        RowBox[{"transform", ",", "state", ",", "steps", ",", "tol"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"pointer", "=", 
       RowBox[{"pointerModeData", "[", 
        RowBox[{"initialDensity", ",", "phaseSchedule", ",", "p"}], "]"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"verdict", "=", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<SpectrallyStableQ\>\"", "->", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"spec", "[", "\"\<ContinuousTimeStableQ\>\"", "]"}], 
           "]"}]}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<ScaleInvariantQ\>\"", "->", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"scale", "[", "\"\<FixedPointQ\>\"", "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<PointerStateSelectedQ\>\"", "->", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"pointer", "[", "\"\<PointerWeights\>\"", "]"}], "]"}], ">", 
           RowBox[{"1", "/", "2"}]}]}]}], "\[IndentingNewLine]", "  ", 
        "|>"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Spectral\>\"", "->", "spec"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Scale\>\"", "->", "scale"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Pointer\>\"", "->", "pointer"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Verdict\>\"", "->", "verdict"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<AllThreeQ\>\"", "->", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Values", "[", "verdict", "]"}]}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"2e34a111-4011-564d-9a06-\
cde6af193296"],

Cell[CellGroupData[{

Cell["5.1 Example unified run", "Subsection",ExpressionUUID->"7ff3c383-f71c-e246-84af-9731f4739844"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exampleMatrix", "=", 
   RowBox[{"dampedLaplacian1D", "[", 
    RowBox[{"8", ",", "0.5"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exampleState", "=", 
   RowBox[{"Normalize", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", "i", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "64"}], "}"}]}], "]"}], ",", "Norm"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exampleDensity", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], "}"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"examplePhases", "=", 
    RowBox[{"quasiPeriodicSchedule", "[", 
     RowBox[{"20", ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exampleUnified", "=", 
    RowBox[{"multiscaleStabilityReport", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
     "exampleMatrix", ",", "\[IndentingNewLine]", "  ", "dyadicCoarseGrain", ",",
       "\[IndentingNewLine]", "  ", "exampleState", ",", 
      "\[IndentingNewLine]", "  ", "exampleDensity", ",", 
      "\[IndentingNewLine]", "  ", "examplePhases", ",", 
      "\[IndentingNewLine]", "  ", "0.15", ",", "\[IndentingNewLine]", "  ", 
      "5", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"exampleUnified", "[", "\"\<Verdict\>\"", "]"}]}], "Input",Expression\
UUID->"ab610b0a-3e99-0049-97fc-5a496eed44b2"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
