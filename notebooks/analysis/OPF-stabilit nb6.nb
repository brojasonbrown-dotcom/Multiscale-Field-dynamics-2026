Cell[CellGroupData[{

Cell["6. Symbolic operator route for field models", "Section",ExpressionUUID->"842cabb9-b68e-fc42-9fb4-4591a99544c1"],

Cell["\<\
For OPF-style field models, the right next move is to linearize the Euler\
\[Dash]Lagrange equations around a stationary solution and extract the \
linearized operator.\
\>", "Text",ExpressionUUID->"1cb2b043-a564-4349-8cb5-96f0de198a00"],

Cell["The stability question then becomes: ", "Text",ExpressionUUID->"c889ecd0-f506-384d-987d-33a57849acfd"],

Cell["what is the spectrum of the linearized operator?", "Item",ExpressionUUID->"670ab594-993e-4d45-85b9-d0f383fcd321"],

Cell["does coarse-graining preserve the effective form?", "Item",ExpressionUUID->"8220854f-f3b7-2f40-afb2-40202f94c437"],

Cell["\<\
which linear combinations survive under repeated decohering interaction?\
\>", "Item",ExpressionUUID->"4000c177-6054-ab4b-97b4-75a77aede7e4"],

Cell[CellGroupData[{

Cell["6.1 Template for linearization around an equilibrium", "Subsection",ExpressionUUID->"d8becf76-1fee-ca4d-8831-cb2df19b93d9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "linearizeFieldEquations", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearizeFieldEquations", "[", 
    RowBox[{"eqns_", ",", "fields_List", ",", "perturbations_List", ",", 
     RowBox[{"\[CurlyEpsilon]sym_", ":", " ", "\[CurlyEpsilon]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rules", ",", "expanded"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{
      RowBox[{"rules", "=", 
       RowBox[{"Thread", "[", 
        RowBox[{"fields", "->", 
         RowBox[{"(", 
          RowBox[{"fields", "+", 
           RowBox[{"\[CurlyEpsilon]sym", " ", "perturbations"}]}], ")"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"expanded", "=", 
       RowBox[{"Normal", " ", "@", " ", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"eqns", " ", "/.", " ", "rules"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[CurlyEpsilon]sym", ",", "0", ",", "1"}], "}"}]}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"expanded", ",", "\[CurlyEpsilon]sym", ",", "1"}], "]"}], "==",
        "0"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",Expression\
UUID->"297b75ae-78e8-6a48-af63-3b7d74eb42a5"],

Cell["\<\
You can apply this to the OPF extended Euler equations once a nontrivial \
equilibrium and, ideally, a time-dependent kinetic structure are specified. \
\>", "Text",ExpressionUUID->"625570fc-4f70-cf43-9d9e-5d1016a4c411"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"9249b2a2-8b58-f743-9e98-7804d898143d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Mode extraction for PDE models", "Section",ExpressionUUID->"673ee787-9bbd-414f-ad89-daa4595c0dce"],

Cell["\<\
If the linearized field equations are PDEs over a region, numerical eigenmode \
analysis is the practical route.\
\>", "Text",ExpressionUUID->"0e9d7979-2e8c-724d-99e3-c3bd5e06a2d7"],

Cell["Relevant built-in functions are: ", "Text",ExpressionUUID->"16420864-b36c-b642-8f9d-77d278622bb2"],

Cell[TextData[ButtonBox["NDEigenvalues",
 BaseStyle->"Link",
 ButtonData->"paclet:ref/NDEigenvalues"]], "Item",ExpressionUUID->"430b1a3e-\
f18b-8a41-af65-fa2e7e4834b0"],

Cell[TextData[ButtonBox["NDEigensystem",
 BaseStyle->"Link",
 ButtonData->"paclet:ref/NDEigensystem"]], "Item",ExpressionUUID->"7244caa4-\
a996-bb4f-820d-26b3a3938fcd"],

Cell[TextData[ButtonBox["DiscretizedPDEData",
 BaseStyle->"Link",
 ButtonData->"paclet:FEMDocumentation/ref/DiscretizedPDEData"]], "Item",Expres\
sionUUID->"8de26b80-361b-5840-b2bf-de3a8d36bec9"],

Cell["The practical workflow is:", "Text",ExpressionUUID->"973f81d0-d8d6-bb4c-a667-6e06a969d8e7"],

Cell["1. derive or specify the linearized PDE operator", "Text",ExpressionUUID->"903ae7e0-e856-3a41-b900-0656caff3c8d"],

Cell["2. impose admissible boundary conditions", "Text",ExpressionUUID->"94a0d557-c0c2-4040-9fbd-9298a2723ce5"],

Cell["3. compute eigenvalues / eigenfunctions", "Text",ExpressionUUID->"e60d26fa-edb1-3b45-b87d-93fc3e92d746"],

Cell["4. identify stable, unstable, and marginal modes ", "Text",ExpressionUUID->"ba21b6db-fecc-8f4a-898d-ca77899b23c0"],

Cell[CellGroupData[{

Cell["7.1 PDE eigenmode template", "Subsection",ExpressionUUID->"63531a08-fb1c-4743-b64f-f54946e95500"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"**", " ", "template"}], " ", "only"}], ";", " ", 
    RowBox[{
    "requires", " ", "a", " ", "specific", " ", "PDE", " ", "and", " ", 
     "region"}]}], " ", "***)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"**", " ", "evals"}], "=", 
     RowBox[{"NDEigenvalues", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"op", "[", 
           RowBox[{"u", "[", 
            RowBox[{"x", ",", "y"}], "]"}], "]"}], "==", 
          RowBox[{"\[Lambda]", " ", 
           RowBox[{"u", "[", 
            RowBox[{"x", ",", "y"}], "]"}]}]}], ",", "bc"}], "}"}], ",", 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], " ", "\[Element]", " ", "region"}], ",",
        "n"}], "]"}]}], ";"}], " ", "***)"}]}]], "Input",ExpressionUUID->\
"9e39cbee-735f-474c-8fef-664d5ce5fde7"],

Cell["For operator stability, remember: ", "Text",ExpressionUUID->"28813e73-3bba-b449-9182-d5f3fbc135bc"],

Cell["\<\
in continuous-time settings, stable decay corresponds to spectra in the left \
half-plane\
\>", "Item",ExpressionUUID->"e86932c5-b7c6-c44f-b5c5-38c71611f19c"],

Cell["\<\
in second-order oscillatory problems, mode frequencies often come from square \
roots of eigenvalues\
\>", "Item",ExpressionUUID->"37c333ad-42a8-f04d-ae65-ae30f6258d8d"],

Cell["\<\
unconstrained systems can exhibit rigid-body or zero modes that must be \
interpreted separately\
\>", "Item",ExpressionUUID->"110b4858-7050-6a46-aa70-694a1046698f"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
