Cell[CellGroupData[{

Cell["1. Core conceptual separation", "Section",ExpressionUUID->"d36a80ef-ead9-dc44-928f-9d26c9b39071"],

Cell["We distinguish three layers: ", "Text",ExpressionUUID->"21f47c4d-c188-fe4a-a45e-880350751691"],

Cell[TextData[{
 StyleBox["operator / dynamics layer",
  FontWeight->Bold],
 ": the generator of evolution"
}], "Item",ExpressionUUID->"8e5d4263-2ef1-5440-9529-2b84d3dac894"],

Cell[TextData[{
 StyleBox["coarse-graining layer",
  FontWeight->Bold],
 ": the scale transformation"
}], "Item",ExpressionUUID->"6e1aa38f-62cd-1648-aac5-deef7ab3bca5"],

Cell[TextData[{
 StyleBox["selection layer",
  FontWeight->Bold],
 ": the measurement/noise-induced survival mechanism"
}], "Item",ExpressionUUID->"54ece896-2faf-6f41-a93a-c96094bc14fb"],

Cell["\<\
The goal is not to collapse these into one undefined slogan, but to compute \
three diagnostics and then study their intersection. \
\>", "Text",ExpressionUUID->"334f69c1-35d1-2042-b284-657e6f26c905"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
   "spectralStabilityQ", ",", "\[IndentingNewLine]", "  ", "scaleFixedPointQ",
     ",", "\[IndentingNewLine]", "  ", "pointerModes", ",", 
    "\[IndentingNewLine]", "  ", "multiscaleStabilityReport"}], 
   "\[IndentingNewLine]", "]"}], ";"}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"33910409-ca23-654a-8034-f0fdcae72598"],

