Cell[CellGroupData[{

Cell["\<\
4. Incommensurable self-measurement and pointer-state selection\
\>", "Section",ExpressionUUID->"be10e4ba-0663-7b41-9fec-ac1e00bc7038"],

Cell["\<\
The correct rigorous implementation is not mystical. We model: \
\>", "Text",ExpressionUUID->"a50d4af7-a39a-f14f-b8b4-830a35ec7f4a"],

Cell["a system basis", "Item",ExpressionUUID->"efc88b40-2c59-564d-a00a-dd8567f9b794"],

Cell["a decohering or dephasing channel", "Item",ExpressionUUID->"2e8856f6-7b85-6e4f-81d3-4ac5bff868a8"],

Cell["incommensurable or quasiperiodic phase forcing", "Item",ExpressionUUID->"b6e382fb-0657-b740-9a70-396d6cdab19b"],

Cell["survival of robust modes / basis states", "Item",ExpressionUUID->"c2640394-ef39-0849-8eb3-39eed121b676"],

Cell["\<\
The key object is the long-time persistence of components under repeated \
evolution plus measurement/noise. \
\>", "Text",ExpressionUUID->"4c81a5c1-185d-4740-a218-ad5e38f89c16"],

Cell[CellGroupData[{

Cell["4.1 Simple dephasing-plus-phase channel", "Subsection",ExpressionUUID->"ce14dd25-a9b5-5544-a336-c933cb4da55c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "dephasingChannel", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dephasingChannel", "[", 
    RowBox[{
     RowBox[{"state_", "?", "MatrixQ"}], ",", 
     RowBox[{"p_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"diag", ",", "offDiag"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{
      RowBox[{"diag", "=", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Diagonal", "[", "state", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"offDiag", "=", 
       RowBox[{"state", "-", "diag"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"diag", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "p"}], ")"}], " ", "offDiag"}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"9c6d3448-e465-a242-b890-ebc6b9934b70"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2 Quasiperiodic phase evolution", "Subsection",ExpressionUUID->"03e3290d-0b2d-1b49-8f61-bbbd495f80cf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "phaseUnitary", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phaseUnitary", "[", "phases_List", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "phases"}], "]"}], "]"}]}], ";"}]}], "Input",Expression\
UUID->"b187c6a7-3d9b-4b41-a5e1-0bc6a722623c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.3 One-step self-measurement evolution", "Subsection",ExpressionUUID->"e41c0323-79a1-9a45-bf5c-fe6dc94b0787"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "selfMeasurementStep", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"selfMeasurementStep", "[", 
    RowBox[{
     RowBox[{"state_", "?", "MatrixQ"}], ",", "phases_List", ",", 
     RowBox[{"p_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "u", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"u", "=", 
       RowBox[{"phaseUnitary", "[", "phases", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"dephasingChannel", "[", 
       RowBox[{
        RowBox[{"u", " ", ".", " ", "state", " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ",", "p"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionU\
UID->"137dc979-6fd9-5045-a6d1-add53004b3f4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.4 Iterate and identify pointer basis weights", "Subsection",ExpressionUUID->"09f725c7-5af2-ce4f-bae6-86c862d20b05"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "pointerModeData", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pointerModeData", "[", 
    RowBox[{
     RowBox[{"initialState_", "?", "MatrixQ"}], ",", "phaseSchedule_List", ",", 
     RowBox[{"p_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"orbit", ",", "finalState", ",", "weights"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"orbit", "=", 
       RowBox[{"FoldList", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"selfMeasurementStep", "[", 
           RowBox[{"#1", ",", "#2", ",", "p"}], "]"}], " ", "&"}], ",", 
         "initialState", ",", "phaseSchedule"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"finalState", "=", 
       RowBox[{"Last", "[", "orbit", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"weights", "=", 
       RowBox[{"Chop", "[", 
        RowBox[{"Diagonal", "[", "finalState", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Orbit\>\"", "->", "orbit"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<FinalState\>\"", "->", "finalState"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<PointerWeights\>\"", "->", "weights"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<DominantPointerIndex\>\"", "->", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Ordering", "[", 
           RowBox[{"weights", ",", 
            RowBox[{"-", "1"}]}], "]"}]}]}]}], "\[IndentingNewLine]", "  ", 
       "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",Expression\
UUID->"fd8c9015-5192-684d-a59c-0c1fc5e18ce2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.5 Example: quasiperiodic phase schedule", "Subsection",ExpressionUUID->"f5082771-d994-bb42-95e9-07b161343b51"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "quasiPeriodicSchedule", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"quasiPeriodicSchedule", "[", 
     RowBox[{
      RowBox[{"steps_Integer", "?", "Positive"}], ",", 
      RowBox[{"dim_Integer", "?", "Positive"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"n", " ", 
         RowBox[{"Sqrt", "[", "j", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "dim"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "steps"}], "}"}]}], "\[IndentingNewLine]", 
     "  ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"initialState2", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], "}"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"examplePointer", "=", 
    RowBox[{"pointerModeData", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"initialState2", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"quasiPeriodicSchedule", "[", 
       RowBox[{"20", ",", "2"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
      "0.15"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"examplePointer", "[", "\"\<FinalState\>\"", "]"}], " ", "//", " ", 
  "MatrixForm"}]}], "Input",ExpressionUUID->"89881c57-dea0-8e40-9a0a-\
833284dee071"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"9aea7e02-d17c-1148-b063-9ae8d5ba7ae1"]
}, Open  ]]
