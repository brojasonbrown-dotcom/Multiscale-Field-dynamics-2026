Cell[CellGroupData[{

Cell["9. Interactive exploration", "Section",ExpressionUUID->"156a1856-f3b1-6149-8990-11069e28a85e"],

Cell["\<\
please add full visual testing suits and structures to this notebook ,, make \
sure its complete rigorous and accurate\
\>", "ChatInput",
 TaggingRules-><|
  "ChatNotebookSettings" -> <|
    "Model" -> <|"Service" -> "LLMKit", "Name" -> Automatic|>, "LLMEvaluator" -> 
     "WolframAIAssistant", "ServiceCaller" -> 
     "Chatbar"|>|>,ExpressionUUID->"43112df3-3743-1147-aeaf-7724e8fb91c0"],

Cell[BoxData[GridBox[{
   {"\[Placeholder]"},
   {"\[Placeholder]"}
  }]], "Input",
 CellChangeTimes->{
  4.000908644218687*^9},ExpressionUUID->"26df1aa4-366f-5545-a7ed-\
fe32b859cc8a"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "   ", 
      RowBox[{
      "mat", ",", "\[IndentingNewLine]", "   ", "state", ",", 
       "\[IndentingNewLine]", "   ", "density", ",", "\[IndentingNewLine]", 
       "   ", "phases", ",", "\[IndentingNewLine]", "   ", "report"}], 
      "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{"dampedLaplacian1D", "[", 
        RowBox[{"n", ",", "\[Gamma]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"state", "=", 
       RowBox[{"Normalize", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"i", "^", "\[Alpha]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"2", "^", "m"}]}], "}"}]}], "]"}], ",", "Norm"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"density", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "c"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Conjugate", "[", "c", "]"}], ",", "1"}], "}"}]}], "}"}], 
        "/", "2"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"phases", "=", 
       RowBox[{"quasiPeriodicSchedule", "[", 
        RowBox[{"steps", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"report", "=", 
       RowBox[{
       "multiscaleStabilityReport", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
        "mat", ",", "\[IndentingNewLine]", "    ", "dyadicCoarseGrain", ",", 
         "\[IndentingNewLine]", "    ", "state", ",", "\[IndentingNewLine]", 
         "    ", "density", ",", "\[IndentingNewLine]", "    ", "phases", ",",
          "\[IndentingNewLine]", "    ", "p", ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{"m", "-", "1"}], ",", "8"}], "]"}], ",", 
         "\[IndentingNewLine]", "    ", "tol"}], "\[IndentingNewLine]", "  ", 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Column", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Unified Multiscale Stability Report\>\"", ",", "14", ",",
            "Bold"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"report", "[", "\"\<Verdict\>\"", "]"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<All three criteria met: \>\"", ",", 
            RowBox[{"report", "[", "\"\<AllThreeQ\>\"", "]"}]}], "}"}], "]"}],
          ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Continuous-time stability margin: \>\"", ",", 
            RowBox[{"report", "[", 
             
             RowBox[{"\"\<Spectral\>\"", 
              ",", "\"\<StabilityMarginContinuous\>\""}], "]"}]}], "}"}], 
          "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Scale fixed-point residual: \>\"", ",", 
            RowBox[{"report", "[", 
             RowBox[{"\"\<Scale\>\"", ",", "\"\<FinalResidual\>\""}], "]"}]}],
            "}"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Pointer weights: \>\"", ",", 
            RowBox[{"report", "[", 
             RowBox[{"\"\<Pointer\>\"", ",", "\"\<PointerWeights\>\""}], 
             "]"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", "  ", "}"}], 
       "]"}]}]}], "\[IndentingNewLine]", " ", "]"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "8", ",", "\"\<matrix size\>\""}], "}"}], ",", "4", ",",
      "24", ",", "2"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Gamma]", ",", "0.5", ",", "\"\<damping\>\""}], "}"}], ",", 
     "0.05", ",", "2", ",", "0.05"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "0.5", ",", "\"\<power-law exponent\>\""}], 
      "}"}], ",", "0.1", ",", "2", ",", "0.05"}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", "6", ",", "\"\<signal exponent length 2^m\>\""}], 
      "}"}], ",", "3", ",", "9", ",", "1"}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", ",", "0.8", ",", "\"\<initial coherence\>\""}], "}"}], ",",
      "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", ",", "0.15", ",", "\"\<dephasing strength\>\""}], "}"}], ",",
      "0", ",", "1", ",", "0.01"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"steps", ",", "20", ",", "\"\<phase steps\>\""}], "}"}], ",", 
     "5", ",", "60", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tol", ",", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}], ",", "\"\<fixed-point tolerance\>\""}], "}"}], ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "10"}]}], ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "3"}]}], ",", 
     RowBox[{"ControlType", "->", "SetterBar"}]}], "}"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",ExpressionUUID->"7ad2779b-2e5f-a840-\
8fa4-785695f18849"],

