 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"60e8bd9e-b2f3-d44d-89db-2ef9f3ea851f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. What counts as evidence for the synthesis hypothesis?", "Section",ExpressionUUID->"878f2ce4-4cde-4742-9375-928547997f1c"],

Cell["\<\
The synthesis hypothesis would gain support if, across diverse systems, one \
repeatedly found that:\
\>", "Text",ExpressionUUID->"b715d869-c082-9b48-b6f2-f2cab9aaec8c"],

Cell["\<\
1. spectral stability and scale fixed-point behavior coincide,\
\>", "Text",ExpressionUUID->"cd8622b4-e629-8b42-9faf-8c2100355ef5"],

Cell["\<\
2. the same modes are selected by decohering quasiperiodic forcing,\
\>", "Text",ExpressionUUID->"c57edf99-4ea1-8243-b034-082781be8314"],

Cell["\<\
3. the three diagnostics converge under refinement rather than drifting apart.\
\>", "Text",ExpressionUUID->"92802fa4-750e-1843-a188-b39241d32b3b"],

Cell["This can be tested empirically and computationally. ", "Text",ExpressionUUID->"67f949cf-77a8-1a45-b8d1-a8caa92e6448"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "synthesisEvidenceScore", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"synthesisEvidenceScore", "[", "report_Association", "]"}], ":=", 
   RowBox[{"Mean", " ", "@", " ", 
    RowBox[{"Boole", " ", "@", " ", 
     RowBox[{"Values", "[", 
      RowBox[{"report", "[", "\"\<Verdict\>\"", "]"}], "]"}]}]}]}], 
  ";"}]}], "Input",ExpressionUUID->"0dc14e1c-232a-3047-a055-894674e576c1"],

