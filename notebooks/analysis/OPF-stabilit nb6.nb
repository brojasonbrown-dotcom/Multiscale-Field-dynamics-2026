}, Open  ]],

Cell[CellGroupData[{

Cell["11. Summary", "Section",ExpressionUUID->"1c9eeb27-7ed4-fe4b-9083-41dd2b5d58a2"],

Cell[TextData[{
 "This notebook does ",
 StyleBox["not",
  FontWeight->Bold],
 " assume the universal claim is already proven."
}], "Text",ExpressionUUID->"0cb1c39e-0a11-3d4e-9dfd-c1c59223aaad"],

Cell["\<\
It instead provides a test harness for the precise question: \
\>", "Text",ExpressionUUID->"1285c70d-7284-3045-a176-e25fbc9331eb"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"when do spectral stability, scale invariance, and \
incommensurable measurement selection coincide in one and the same \
system?\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic},
