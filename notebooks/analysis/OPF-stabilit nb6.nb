Cell[CellGroupData[{

Cell["\<\
2. Spectral stability across infinite-dimensional mode structure\
\>", "Section",ExpressionUUID->"8a52568c-5ef3-b449-86b4-5d99b3af8379"],

Cell["The rigorous criterion is operator-theoretic: ", "Text",ExpressionUUID->"b9641d48-07b2-fc4a-9cb9-1c3faf2acf2b"],

Cell["\<\
continuous-time stability: spectrum in the open left half-plane\
\>", "Item",ExpressionUUID->"bc34eb21-6882-074b-9f8f-7dcee717cf00"],

Cell["\<\
discrete-time stability: spectrum strictly inside the unit disk\
\>", "Item",ExpressionUUID->"88445a6f-0b48-1049-9b82-1227382149cb"],

Cell["\<\
For symbolic finite-dimensional surrogates, we use eigenvalues directly.\
\>", "Text",ExpressionUUID->"13be62e7-60e9-b645-bf96-63587f9d4db3"],

Cell["\<\
For PDE or operator models, we use mode truncations and then inspect \
convergence of the stability verdict as truncation increases. \
\>", "Text",ExpressionUUID->"3230d987-0258-df42-b778-d041e3009b04"],

Cell[CellGroupData[{

Cell["2.1 Finite-dimensional spectral diagnostics", "Subsection",ExpressionUUID->"86f35590-0a9a-8f4a-83a6-3eaa4238fe1e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "spectralData", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spectralData", "[", 
    RowBox[{"matrix_", "?", "MatrixQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "vals", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"vals", "=", 
       RowBox[{"Eigenvalues", "[", "matrix", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Eigenvalues\>\"", "->", "vals"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<RealParts\>\"", "->", 
         RowBox[{"Re", "[", "vals", "]"}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<ImaginaryParts\>\"", "->", 
         RowBox[{"Im", "[", "vals", "]"}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<ContinuousTimeStableQ\>\"", "->", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Re", "[", "vals", "]"}], "<", "0"}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<DiscreteTimeStableQ\>\"", "->", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Abs", "[", "vals", "]"}], "<", "1"}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<StabilityMarginContinuous\>\"", "->", 
         RowBox[{"-", 
          RowBox[{"Max", "[", 
           RowBox[{"Re", "[", "vals", "]"}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<StabilityMarginDiscrete\>\"", "->", 
         RowBox[{"1", "-", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", "vals", "]"}], "]"}]}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"0be8d13c-4b8d-3347-be24-830af6a58966"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
2.2 Mode-truncation wrapper for infinite-dimensional approximations\
\>", "Subsection",ExpressionUUID->"610deff4-d51c-084d-a192-6ca37d65f936"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "truncationStabilityTable", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"truncationStabilityTable", "[", 
    RowBox[{"operatorBuilder_", ",", "modeCounts_List"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"spectralData", "[", 
       RowBox[{"operatorBuilder", "[", "#", "]"}], "]"}], " ", "&"}], ",", 
     "\[IndentingNewLine]", "    ", "modeCounts"}], "\[IndentingNewLine]", 
    "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"9b257c9b-2fe4-e241-9bb4-cfd411ffc756"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.3 Example: damped nearest-neighbor operator family", "Subsection",ExpressionUUID->"662d32bb-d7a5-494c-89c5-9c78f2b09742"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "dampedLaplacian1D", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dampedLaplacian1D", "[", 
     RowBox[{
      RowBox[{"n_Integer", "?", "Positive"}], ",", 
      RowBox[{"\[Gamma]_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "lap", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"lap", "=", 
        RowBox[{
         RowBox[{"SparseArray", "[", "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", 
              RowBox[{"-", "2"}]}], ",", "\[IndentingNewLine]", "      ", 
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "2"}], "}"}], "]"}], "->", "1"}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"2", ",", "1"}], "}"}], "]"}], "->", "1"}]}], 
            "\[IndentingNewLine]", "    ", "}"}], ",", "\[IndentingNewLine]", 
           "    ", 
           RowBox[{"{", 
            RowBox[{"n", ",", "n"}], "}"}]}], "\[IndentingNewLine]", "  ", 
          "]"}], " ", "//", " ", "Normal"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"lap", "-", 
        RowBox[{"\[Gamma]", " ", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exampleSpectral", "=", 
    RowBox[{"truncationStabilityTable", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"dampedLaplacian1D", "[", 
        RowBox[{"#", ",", "0.3"}], "]"}], " ", "&"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"8", ",", "16", ",", "32", ",", "64"}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "exampleSpectral"}], "Input",
 CellLabel->"In[59]:=",ExpressionUUID->"a43bcf79-9ef6-b74e-a0ee-25ae771a9735"],

