Cell[CellGroupData[{

Cell["3. Scale invariance as coarse-graining fixed-point testing", "Section",ExpressionUUID->"4ec61d14-40e7-2949-8d84-b77eee72e1ed"],

Cell["\<\
A system is scale-invariant if an appropriate coarse-graining transformation \
leaves the effective description unchanged up to rescaling.\
\>", "Text",ExpressionUUID->"52a66569-4081-de4b-8129-bc762b560bc0"],

Cell["We encode this in a practical way: ", "Text",ExpressionUUID->"774eb081-c3a8-f246-b9e5-56cd4afce2c9"],

Cell["define a coarse-graining transform", "Item",ExpressionUUID->"f41fe37d-1f15-0247-8f2a-d68bbf95ad47"],

Cell["iterate it", "Item",ExpressionUUID->"02ed1f32-fefd-414a-a8f6-286959ccfd69"],

Cell["test whether the object approaches a fixed point", "Item",ExpressionUUID->"db90436b-509c-ed4a-b070-5a8c59ab3978"],

Cell["measure the residual under renormalization", "Item",ExpressionUUID->"67c216d9-6680-2047-8737-71405fca7883"],

Cell[CellGroupData[{

Cell["3.1 Generic fixed-point residual", "Subsection",ExpressionUUID->"07604b75-d205-ed43-bf25-9288b4a87548"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "fixedPointResidual", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fixedPointResidual", "[", 
    RowBox[{"transform_", ",", "state_", ",", 
     RowBox[{"norm_", ":", " ", "Norm"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"norm", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"transform", "[", "state", "]"}], "-", "state"}], "}"}], "]"}],
     "]"}]}], ";"}]}], "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"68660c90-ba0f-f044-b426-97ca56d4bdb5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.2 Iterated RG-style evolution", "Subsection",ExpressionUUID->"b7cb0604-1dc9-0d4b-8eca-a923d656be7e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "rgOrbit", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rgOrbit", "[", 
    RowBox[{"transform_", ",", "state_", ",", 
     RowBox[{"steps_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"NestList", "[", 
    RowBox[{"transform", ",", "state", ",", "steps"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[65]:=",ExpressionUUID->"c2d0d38c-d097-7749-befc-1420c02262bd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.3 Fixed-point test", "Subsection",ExpressionUUID->"e3ef9262-29fe-3046-82ce-d679035c14be"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "scaleFixedPointData", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleFixedPointData", "[", 
    RowBox[{"transform_", ",", "state_", ",", 
     RowBox[{"steps_Integer", " ", ":", " ", "12"}], ",", 
     RowBox[{"tol_", " ", ":", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"orbit", ",", "residuals", ",", "finalResidual"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"orbit", "=", 
       RowBox[{"rgOrbit", "[", 
        RowBox[{"transform", ",", "state", ",", "steps"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"residuals", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"fixedPointResidual", "[", 
          RowBox[{"transform", ",", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "orbit"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"finalResidual", "=", 
       RowBox[{"Last", "[", "residuals", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Orbit\>\"", "->", "orbit"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Residuals\>\"", "->", "residuals"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<FinalResidual\>\"", "->", "finalResidual"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<FixedPointQ\>\"", "->", 
         RowBox[{"finalResidual", "<", "tol"}]}]}], "\[IndentingNewLine]", 
       "  ", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[67]:=",ExpressionUUID->"b99b7bec-f6bd-f64d-a769-30e35956cf3d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.4 Example: dyadic coarse-graining of a signal", "Subsection",ExpressionUUID->"71f1d707-bdd0-d649-a99f-210b939ee024"],

Cell["\<\
The simplest scale test uses local averaging followed by normalization. \
\>", "Text",ExpressionUUID->"ce205c19-af27-4c49-84a7-cb6a4ce1d220"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "dyadicCoarseGrain", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"dyadicCoarseGrain", "[", "list_List", "]"}], " ", "/;", " ", 
     RowBox[{"EvenQ", "[", 
      RowBox[{"Length", "[", "list", "]"}], "]"}]}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Normalize", "[", 
     RowBox[{
      RowBox[{"Mean", " ", "/@", " ", 
       RowBox[{"Partition", "[", 
        RowBox[{"list", ",", "2"}], "]"}]}], ",", "Norm"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exampleSignal", "=", 
   RowBox[{"Normalize", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", "i", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "64"}], "}"}]}], "]"}], ",", "Norm"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exampleScale", "=", 
    RowBox[{"scaleFixedPointData", "[", 
     RowBox[{"dyadicCoarseGrain", ",", "exampleSignal", ",", "5", ",", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"exampleScale", "[", "\"\<FinalResidual\>\"", "]"}]}], "Input",
 CellLabel->"In[69]:=",ExpressionUUID->"74f2fb07-8aba-7f49-bc0b-953a01590d48"],

Cell[BoxData[
 TemplateBox[{
  "Thread", "tdlen", 
   "\"Objects of unequal length in \\!\\(\\*RowBox[{RowBox[{\\\"{\\\", \
RowBox[{FractionBox[RowBox[{RowBox[{\\\"280\\\", \\\" \\\", \
SqrtBox[FractionBox[\\\"1675548305134385299761\\\", \
