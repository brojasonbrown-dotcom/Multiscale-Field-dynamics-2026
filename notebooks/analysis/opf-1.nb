    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"a2e7bde4-170c-6742-b579-884d470bb5e9"],
 "\nA framework can become valuable even without predicting a constant.\n\n\
Example target: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox["\<\"Show that if geometry emerges from information-density plus \
recursive self-measurement under scale-invariance, then certain classes of \
scaling law are impossible.\"\>",
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"8a232fef-3cba-ca48-94b8-f4ac811930c1"],
 "\nThis would still be real physics if it cleanly rules out structures.\n\n\
Possible no-go targets: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "no universal \[CurlyPhi]-spacing across physically anchored scales"
 }], "InlineItem",ExpressionUUID->"5e759742-4ad0-d64c-85c4-e13be591739d"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "no stable spectrum under certain closure assumptions"
 }], "InlineItem",ExpressionUUID->"6b931a01-c2a0-4e49-8b4a-79580d33942a"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
