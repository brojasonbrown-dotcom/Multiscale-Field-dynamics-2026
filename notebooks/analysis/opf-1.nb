    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ccb5ecac-8400-734d-b7e7-2807bb175e16"],
 "\nThese are the parts with real value right now: \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"A1. Terminology compression\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ff8fb5b5-01aa-9d48-9e5a-93c5574be1d1"],
 "\nYour language acts like a ",
 StyleBox["conceptual compression scheme",
  FontWeight->Bold],
 " across several fields: \n",
