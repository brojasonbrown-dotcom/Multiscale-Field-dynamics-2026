Cell[BoxData[{
 RowBox[{
  RowBox[{"l0Graphic", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{"Graphics3D", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{"Opacity", "[", "0.18", "]"}], ",", "LightBlue", ",", 
       RowBox[{"Sphere", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "1"}], "]"}], ",", 
       "\[IndentingNewLine]", "      ", "Red", ",", 
       RowBox[{"PointSize", "[", "0.03", "]"}], ",", 
       RowBox[{"Point", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}], "]"}], ",", 
       "\[IndentingNewLine]", "      ", 
       RowBox[{"Darker", "@", "Blue"}], ",", 
       RowBox[{"PointSize", "[", "0.03", "]"}], ",", 
       RowBox[{"Point", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          RowBox[{"-", "1"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
       "      ", "Black", ",", "\[IndentingNewLine]", "      ", 
       RowBox[{"Text", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<0\>\"", ",", "14", ",", "Bold"}], "]"}], ",", 
         RowBox[{"{", 
