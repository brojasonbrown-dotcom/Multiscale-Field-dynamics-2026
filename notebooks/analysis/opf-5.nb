Cell[CellGroupData[{

Cell["7. Layer 2 measurement kernel", "Section",ExpressionUUID->"ddcf464b-fa24-1141-9403-ce744e03f124"],

Cell[TextData[{
 "The stated Layer 2 mapping is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "Observable", "\[LongEqual]", "\[Integral]", "\[CapitalPsi]", 
         "\[DifferentialD]", 
         RowBox[{"(", "eigenbasis coordinates", ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\text{Observable} = \\int \\Psi \\, d(\\text{eigenbasis coordinates})",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "32e9fd8d-4f61-2841-b5d2-6bf4b542e662"],
 "We encode this as a functional measurement kernel. "
}], "Text",ExpressionUUID->"6c058574-4d6f-f643-b495-1ca576f1b5ae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "measurementKernel", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementKernel", "[", 
    RowBox[{"psi_", ",", "basisVars_List", ",", 
     RowBox[{"regionSpec_", ":", " ", "Automatic"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"Which", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"regionSpec", "===", "Automatic"}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"Integrate", "[", 
      RowBox[{"psi", ",", 
       RowBox[{"Sequence", " ", "@@", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], " ", "&"}], 
          " ", "/@", " ", "basisVars"}], ")"}]}]}], "]"}], ",", 
     "\[IndentingNewLine]", "    ", "True", ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"Integrate", "[", 
      RowBox[{"psi", ",", 
       RowBox[{"Sequence", " ", "@@", " ", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", 
             RowBox[{"#2", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"#2", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], " ", "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"basisVars", ",", "regionSpec"}], "}"}]}], "]"}]}]}], 
      "]"}]}], "\[IndentingNewLine]", "  ", "]"}]}], ";"}]}], "Input",Expressi\
onUUID->"dfdc9e60-b45c-5348-9c19-2ee67d6b3a01"],

Cell["Example Gaussian test state: ", "CodeText",ExpressionUUID->"d6f1c340-647e-6643-b1c1-329756955afb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gaussianPsi", "=", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "^", "2"}], "+", 
        RowBox[{"y", "^", "2"}], "+", 
        RowBox[{"z", "^", "2"}]}], ")"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"measurementKernel", "[", 
  RowBox[{"gaussianPsi", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], "Input",ExpressionUUI\
D->"d867bef9-f77d-ba4a-bb96-ccc410c61e1b"],

