Cell[CellGroupData[{

Cell["10. Interactive exploration panel", "Section",ExpressionUUID->"225753d4-ee94-2343-b2e7-3519b0c56d40"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
      "mat", ",", "\[IndentingNewLine]", "    ", "eigs", ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"kk", "=", 
        RowBox[{
         RowBox[{"kxVal", "^", "2"}], "+", 
         RowBox[{"kyVal", "^", "2"}], "+", 
         RowBox[{"kzVal", "^", "2"}]}]}]}], "\[IndentingNewLine]", "  ", 
      "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{
        RowBox[{"stiffnessMatrix", " ", "/.", " ", 
         RowBox[{"{", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"aRho", "->", "aRhoVal"}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"aChi", "->", "aChiVal"}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"aRes", "->", "aResVal"}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"kx", "->", "kxVal"}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"ky", "->", "kyVal"}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"kz", "->", "kzVal"}]}], "\[IndentingNewLine]", "    ", 
          "}"}]}], " ", "//", " ", "Simplify"}]}], ";", "\[IndentingNewLine]",
       "  ", 
      RowBox[{"eigs", "=", 
       RowBox[{
        RowBox[{"Eigenvalues", "[", "mat", "]"}], " ", "//", " ", 
        "Simplify"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Column", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"Style", "[", 
           
           RowBox[{"\"\<Linearized Modal Matrix\>\"", ",", "14", ",", 
            "Bold"}], "]"}], ",", "\[IndentingNewLine]", "      ", 
          RowBox[{"MatrixForm", "[", "mat", "]"}], ",", "\[IndentingNewLine]",
           "      ", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Eigenvalues\>\"", ",", "14", ",", "Bold"}], "]"}], ",",
           "\[IndentingNewLine]", "      ", "eigs", ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Wave-number squared\>\"", ",", "14", ",", "Bold"}], 
           "]"}], ",", "\[IndentingNewLine]", "      ", "kk"}], 
         "\[IndentingNewLine]", "    ", "}"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"Spacings", "->", "1.2"}]}], "\[IndentingNewLine]", "  ", 
       "]"}]}]}], "\[IndentingNewLine]", " ", "]"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"aRhoVal", ",", "1", ",", "\"\<a\[Rho]\>\""}], "}"}], ",", 
     "0.01", ",", "5", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"aChiVal", ",", "1", ",", "\"\<a\[Chi]\>\""}], "}"}], ",", 
     "0.01", ",", "5", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"aResVal", ",", "1", ",", "\"\<aR\>\""}], "}"}], ",", "0.01", ",",
      "5", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", "Delimiter", ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"kxVal", ",", "1", ",", "\"\<k_x\>\""}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"kyVal", ",", "0", ",", "\"\<k_y\>\""}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"kzVal", ",", "0", ",", "\"\<k_z\>\""}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"SaveDefinitions", "->", "True"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"114a16be-a53e-e242-b9a6-487cf25c1971"],

