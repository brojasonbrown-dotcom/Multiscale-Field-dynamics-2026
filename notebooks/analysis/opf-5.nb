Cell[CellGroupData[{

Cell["8. Maintenance operator", "Section",ExpressionUUID->"d901bc65-4ef0-c243-bb18-2c92310b34fc"],

Cell[TextData[{
 "The Layer 2 maintenance operator is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["f", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[CapitalGamma]", 
         StyleBox["f", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\frac{\\partial f}{\\partial t} + \\Gamma f = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0d348f62-6f6a-c84c-83ca-ddb01a77745f"],
 "with exact symbolic solution: "
}], "CodeText",ExpressionUUID->"8bc38494-73c5-a943-99e8-859acbca0c06"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "f", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"maintenanceSolution", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{"DSolveValue", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"f", "[", "t", "]"}], ",", "t"}], "]"}], "+", 
        RowBox[{"\[CapitalGamma]", " ", 
         RowBox[{"f", "[", "t", "]"}]}]}], "==", "0"}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"f", "[", "t", "]"}], ",", "\[IndentingNewLine]", "    ", "t"}],
      "\[IndentingNewLine]", "  ", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "maintenanceSolution"}], \
"Input",ExpressionUUID->"2181b892-4d45-f244-8312-b7d9e7f68a25"],

