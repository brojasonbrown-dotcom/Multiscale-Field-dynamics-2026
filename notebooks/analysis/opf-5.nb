 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"94391d86-3524-274d-9200-4ba55c17dc97"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Constant-field sector and exact stationary solution", "Section",ExpressionUUID->"df2b14b1-9495-7c48-92ec-54d24fe608ce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"constantSectorRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "->", "\[Rho]0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"\[Chi]", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "->", "\[Chi]0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"resolution", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "->", "r0"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"constantSectorEquations", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"extendedEuler", " ", "/.", " ", "constantSectorRules"}], " ", "//",
      " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"constantSectorSolve", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{"constantSectorEquations", ",", 
       RowBox[{"{", 
        RowBox[{"\[Rho]0", ",", "\[Chi]0", ",", "r0"}], "}"}], ",", "Reals"}],
       "]"}], " ", "//", " ", "FullSimplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "constantSectorSolve"}], \
"Input",ExpressionUUID->"5a7084c0-2076-424b-a6e2-0f776de6ce3b"],

