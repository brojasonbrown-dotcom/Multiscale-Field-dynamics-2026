Cell[CellGroupData[{

Cell["2. Layer 1: symbolic action and variational derivation", "Section",ExpressionUUID->"8bbf647e-1997-f04d-9e5e-433558c3727e"],

Cell[TextData[{
 "We take the OPF Layer 1 action in symbolic form: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], "\[LongEqual]", "\[Integral]", 
         RowBox[{"(", 
           RowBox[{"\[Rho]", "log", 
             RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
             SuperscriptBox[
              StyleBox["R", "TI"], "2"]}], ")"}], "\[DifferentialD]", 
         "\[CapitalOmega]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "S = \\int \\left(\\rho \\log(\\chi) + \\chi R^2\\right)\\, d\\Omega", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "734d1733-83bf-f74f-a98b-ae2853b175b2"],
 "To make the variational problem nondegenerate, we allow all three fields to \
vary over spacetime: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", "\[Rho]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["t", "TI"], ",", 
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"], ",", 
             StyleBox["z", "TI"]}], ")"}], ",  ", "\[Chi]", "\[LongEqual]", 
         "\[Chi]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["t", "TI"], ",", 
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"], ",", 
             StyleBox["z", "TI"]}], ")"}], ",  ", 
         StyleBox["R", "TI"], "\[LongEqual]", 
         StyleBox["R", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["t", "TI"], ",", 
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"], ",", 
             StyleBox["z", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\rho = \\rho(t,x,y,z),\\quad \\chi = \\chi(t,x,y,z),\\quad R = \
R(t,x,y,z)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "615e07fd-6f12-9c4a-8743-854d8895d75e"]
}], "Text",ExpressionUUID->"d1fe2b0b-d61e-3f41-bccb-38a0a90a31ac"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"\[Rho]", ",", "\[Chi]", ",", "resolution", ",", "lagrangian"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lagrangian", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{"opfActionDensity", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"\[Chi]", "[", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"resolution", "[", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}], 
     "\[IndentingNewLine]", "  ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"lagrangian", " ", "//", " ", "TraditionalForm"}]}], "Input",Expressi\
onUUID->"79782bcf-d9bd-304f-8843-f4dbcf630742"],

Cell[CellGroupData[{

Cell["2.1 Formal Euler\[Dash]Lagrange equations", "Subsection",ExpressionUUID->"b74b8a9c-083a-0b43-9e30-db70faf910af"],

Cell[TextData[{
 "Because the given action density contains no derivatives of the fields, the \
Euler\[Dash]Lagrange equations reduce to algebraic stationarity conditions: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["L", "TI"]}], 
          RowBox[{"\[PartialD]", "\[Rho]"}]], "\[LongEqual]", "0", ",  ", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["L", "TI"]}], 
          RowBox[{"\[PartialD]", "\[Chi]"}]], "\[LongEqual]", "0", ",  ", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["L", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["R", "TI"]}]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\frac{\\partial \\mathcal{L}}{\\partial \\rho}=0,\\quad\n\
\\frac{\\partial \\mathcal{L}}{\\partial \\chi}=0,\\quad\n\\frac{\\partial \
\\mathcal{L}}{\\partial R}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ed3f8b9-5e07-b648-9cf7-b222aab7acd9"]
}], "Text",ExpressionUUID->"25bd8be5-646a-5f46-a257-f67c23d9fbc7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eulerEquations", "=", 
    RowBox[{"Thread", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"lagrangian", ",", "#"}], "]"}], "==", "0"}], " ", "&"}], 
      " ", "/@", " ", 
      RowBox[{"{", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"\[Rho]", "[", 
         RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\[Chi]", "[", 
         RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"resolution", "[", 
         RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}], 
       "\[IndentingNewLine]", "   ", "}"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"eulerEquations", " ", "//", " ", "Simplify"}]}], "Input",ExpressionU\
UID->"76eddf74-48a2-144f-b251-e1dca51b6869"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2 Reduced analytic solution", "Subsection",ExpressionUUID->"0848267a-9ef2-474f-b0f9-8126cd3b2a46"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"reducedSolutions", "=", 
    RowBox[{
     RowBox[{"Reduce", "[", 
      RowBox[{"eulerEquations", ",", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\[Rho]", "[", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\[Chi]", "[", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"resolution", "[", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}], 
        "\[IndentingNewLine]", "  ", "}"}], ",", "Reals"}], "]"}], " ", "//", 
     " ", "FullSimplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "reducedSolutions"}], \
"Input",ExpressionUUID->"acc86f49-4f66-0a4e-83fa-428daa501e1a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.3 Interpretation", "Subsection",ExpressionUUID->"87102d38-4689-c14b-8b36-40d250f65af1"],

Cell["\<\
From the stated action alone, the stationary conditions are expected to \
force: \
\>", "Text",ExpressionUUID->"09e568f3-72b9-cc41-9db4-fd2da6b6050d"],

Cell[TextData[{
 Cell[BoxData[Cell["Log[\[Chi][...]] == 0",
   Background->None,ExpressionUUID->"a6e2ad82-251c-df49-966f-edca7aaa12b4"]], 
  "InlineCode",ExpressionUUID->"0013c41b-4c83-164b-b717-7e49219049fd"],
 " so ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Chi]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\chi = 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "88eba4c7-9353-494f-9c63-510c3c3b0b0c"]
}], "Item",ExpressionUUID->"01acd3c1-9d6e-e146-81b4-8ac9a0f5801d"],

Cell[TextData[{
 Cell[BoxData[Cell["\[Rho][...]/\[Chi][...] + resolution[...]^2 == 0",
   Background->None,ExpressionUUID->"adf0bc7d-9073-a84a-9081-3157f799fbcd"]], 
  "InlineCode",ExpressionUUID->"4f4fcc57-e0fb-4a49-9c8e-05b949707e2e"],
 " so ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", "-", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho = -R^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b412be91-0fa7-d741-b7f7-77d42620c8db"],
 " when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Chi]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\chi=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d895b32-6576-2744-ad51-db7726d43791"]
}], "Item",ExpressionUUID->"2677a50f-7ec1-2448-83e6-05a18c9722fd"],

Cell[TextData[{
 Cell[BoxData[Cell["2 \\chi R == 0",
   Background->None,ExpressionUUID->"2dd9773b-5e31-f744-bfd9-930185a1076e"]], 
  "InlineCode",ExpressionUUID->"7c14803f-6982-3345-ac57-a937d5fa515e"],
 " so ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "R = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c7d9d25c-4fff-c44e-be34-e1a014d57382"]
}], "Item",ExpressionUUID->"874ba350-dd61-d047-a1aa-70ccdb270214"],

Cell[TextData[{
 "hence ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[Rho]", "\[LongEqual]", "0", ", ", "\[Chi]", "\[LongEqual]", "1", 
         ", ", 
         StyleBox["R", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\rho = 0,\\ \\chi = 1,\\ R = 0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eee5a7f5-f6ac-074a-bc57-cf1985a50f72"]
}], "Item",ExpressionUUID->"64feed7e-0238-6b48-a7aa-a3566f098fc5"],

Cell[TextData[{
 "This means the bare OPF action as written has a ",
 StyleBox["trivial stationary point",
  FontWeight->Bold],
 ". If nontrivial field dynamics are intended, derivative, coupling, or \
constraint terms must be added. "
}], "Text",ExpressionUUID->"c74aa61e-199f-e245-9b64-f46b9574e36b"],

