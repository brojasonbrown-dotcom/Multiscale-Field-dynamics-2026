Notebook[{

Cell[CellGroupData[{
Cell["RHUFT / OPF Rigorous Derivation Notebook", "Title",ExpressionUUID->"5f3cca9d-ba3c-fa4b-81bf-6730b26b93fe"],

Cell[TextData[{
 "This notebook continues your derivation attempt in a way that is ",
 StyleBox["inspectable, modular, symbolic-first, and interactive",
  FontWeight->Bold],
 "."
}], "Text",ExpressionUUID->"dbc8a134-e844-8649-85a1-c4907a610707"],

Cell["\<\
It also corrects a few Wolfram Language issues in the draft: \
\>", "Text",ExpressionUUID->"02eac010-65d2-5d4a-9991-96b109d92859"],

Cell[TextData[{
 "the lower boundary label should use ",
 Cell[BoxData[Cell["\[Infinity]",
   Background->None,ExpressionUUID->"231d34f8-e1f9-b644-9a9c-bfc5e53e3a31"]], 
  "InlineCode",ExpressionUUID->"e6d66b6a-cad5-ba49-a182-b02879fbdd69"],
 " instead of the malformed character"
}], "Item",ExpressionUUID->"2aa064d8-41a1-f64a-9408-ca841e8d7d49"],

Cell[TextData[{
 "exact ",
 Cell[BoxData[
  RowBox[{"WorkingPrecision", "->", "Infinity"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "385d99ef-550d-8349-a04b-902abd00f54e"],
 " is not executable for numerical procedures in the kernel"
}], "Item",ExpressionUUID->"63edf1b8-3409-464c-a9e6-e6ced2702859"],

Cell["\<\
a symbolic variational pipeline is possible and is the correct place to start\
\>", "Item",ExpressionUUID->"b88b15d9-7226-0c41-a32d-ae018fe6510c"],

Cell[TextData[{
 "several OPF directives can be represented as ",
 StyleBox["formal constraints",
  FontSlant->Italic],
 " even when not directly executable as stated"
}], "Item",ExpressionUUID->"c73c8301-543b-234d-b02f-9b27d3bf5185"],

Cell["The notebook is organized as:", "Text",ExpressionUUID->"545958ac-b218-f74b-8aba-49a11fc645ce"],

Cell["1. corrected Layer 0 visual", "Text",ExpressionUUID->"05415db3-3ba1-954f-b50f-9c5a49ec9a3c"],

Cell["2. Layer 1 symbolic action and Euler\[Dash]Lagrange derivation", "Text",ExpressionUUID->"46d529ac-a7b7-a041-8470-5f5389d6b4b9"],

Cell["3. stationary/constant-field reduction", "Text",ExpressionUUID->"3e04b4c6-f8da-1d40-ab03-24a34acc9cf3"],

Cell["4. linearization and modal stability extraction", "Text",ExpressionUUID->"90dcecf2-4f42-8c4a-aa19-d72f0975ecb9"],

Cell["\<\
5. \[OpenCurlyDoubleQuote]missing variable\[CloseCurlyDoubleQuote] analysis \
against a placeholder Standard Model parameter set\
\>", "Text",ExpressionUUID->"f1fc594f-df78-8c49-bab2-9bd1d64a7f2e"],

Cell["6. Layer 2 measurement kernel", "Text",ExpressionUUID->"394ea49e-0ca6-4d46-b4a3-e63d4982c4ff"],

Cell["7. full callable pipeline", "Text",ExpressionUUID->"08591f96-977e-f14d-bc63-61ba1cd02134"],

Cell["8. interactive parameter exploration panels ", "Text",ExpressionUUID->"f7a3876c-4120-0740-be4c-1f3d5a4615b8"],

