Cell[CellGroupData[{

Cell["6. Missing-variable analysis", "Section",ExpressionUUID->"0389e7fa-8143-6541-8a6e-000fbc16d303"],

Cell["\<\
The user directive asks for a complement between variables in the Layer 1 \
action and a Standard Model constant list. Since the Standard Model constant \
list is not a built-in canonical symbol set, we represent it explicitly as a \
placeholder association. \
\>", "Text",ExpressionUUID->"dbf2a195-9ad0-e04e-8119-f1943ad7e961"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"standardModelConstants", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
     "c", ",", "\[HBar]", ",", "gravitationalConstant", ",", 
      "elementaryCharge", ",", "\[IndentingNewLine]", "  ", "electronMass", ",",
       "protonMass", ",", "neutronMass", ",", "\[IndentingNewLine]", "  ", 
      "fineStructureConstant", ",", "weakMixingAngle", ",", 
      "\[IndentingNewLine]", "  ", "strongCouplingConstant", ",", 
      "higgsVacuumExpectationValue"}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"layer1Symbols", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{"DeleteDuplicates", " ", "@", " ", 
     RowBox[{"Cases", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{"lagrangian", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"s_Symbol", " ", "/;", " ", 
        RowBox[{
         RowBox[{"Context", "[", "s", "]"}], "===", "\"\<Global`\>\""}]}], ",",
        "\[IndentingNewLine]", "    ", "Infinity"}], "\[IndentingNewLine]", 
      "  ", "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"missingVariables", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Complement", "[", 
      RowBox[{"layer1Symbols", ",", "standardModelConstants"}], "]"}], " ", "//",
      " ", "Sort"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"<|", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"\"\<Layer1Symbols\>\"", "->", "layer1Symbols"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<MissingVariables\>\"", "->", "missingVariables"}]}], 
  "\[IndentingNewLine]", "|>"}]}], "Input",ExpressionUUID->"8a9b7404-610a-\
2d44-b2ec-d58146843c41"],

Cell[BoxData[
 TagBox[GridBox[{
