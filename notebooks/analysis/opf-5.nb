Cell[CellGroupData[{

Cell["9. Full callable pipeline", "Section",ExpressionUUID->"bed91923-9a6f-6b4f-9cf9-53b970853207"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "deriveLayer1", ",", "\[IndentingNewLine]", "  ", "solveConstantSector", ",",
      "\[IndentingNewLine]", "  ", "linearizeLayer1", ",", 
     "\[IndentingNewLine]", "  ", "extractModalMatrix", ",", 
     "\[IndentingNewLine]", "  ", "measureState", ",", "\[IndentingNewLine]", 
     "  ", "opfPipeline"}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"deriveLayer1", "[", "]"}], ":=", "extendedEuler"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"solveConstantSector", "[", "]"}], ":=", "constantSectorSolve"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"linearizeLayer1", "[", "]"}], ":=", "linearizedSystem"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"extractModalMatrix", "[", "]"}], ":=", "stiffnessMatrix"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"measureState", "[", 
     RowBox[{"psi_", ",", "vars_List", ",", 
      RowBox[{"regionSpec_", ":", " ", "Automatic"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"measurementKernel", "[", 
     RowBox[{"psi", ",", "vars", ",", "regionSpec"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"opfPipeline", "[", "]"}], ":=", "\[IndentingNewLine]", "  ", 
   RowBox[{"<|", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"\"\<Layer0Graphic\>\"", "->", "l0Graphic"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"\"\<Layer1EulerEquations\>\"", "->", 
      RowBox[{"deriveLayer1", "[", "]"}]}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"\"\<ConstantSectorSolutions\>\"", "->", 
      RowBox[{"solveConstantSector", "[", "]"}]}], ",", "\[IndentingNewLine]",
      "    ", 
     RowBox[{"\"\<LinearizedSystem\>\"", "->", 
      RowBox[{"linearizeLayer1", "[", "]"}]}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"\"\<ModalMatrix\>\"", "->", 
      RowBox[{"extractModalMatrix", "[", "]"}]}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{
      RowBox[{"\"\<ModalEigenvalues\>\"", "->", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"extractModalMatrix", "[", "]"}], "]"}]}], " ", "//", " ", 
      "FullSimplify"}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"\"\<MaintenanceSolution\>\"", "->", "maintenanceSolution"}]}], 
    "\[IndentingNewLine]", "  ", "|>"}]}], ";"}]}], "Input",ExpressionUUID->\
"8a74e650-d90d-b948-9c66-a04018346a60"],

Cell[BoxData[
 RowBox[{"opfPipeline", "[", "]"}]], "Input",ExpressionUUID->"60b5f590-64ae-e747-b110-eaaf2c2b4cac"],

