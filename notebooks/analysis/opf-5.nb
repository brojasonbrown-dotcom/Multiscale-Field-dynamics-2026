Cell[CellGroupData[{

Cell["0. Setup", "Section",ExpressionUUID->"93206cbb-541c-2540-b24e-405ba25314e2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t", ",", "\[CapitalGamma]"}], 
        "}"}], ",", "Reals"}], "]"}], "&&", "\[IndentingNewLine]", "  ", 
     RowBox[{"\[CapitalGamma]", ">", "0"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords3", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords4", "=", 
    RowBox[{"{", 
     RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"opfActionDensity", "[", 
    RowBox[{"\[Rho]_", ",", "\[Chi]_", ",", "resolution_"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"\[Rho]", " ", 
     RowBox[{"Log", "[", "\[Chi]", "]"}]}], "+", 
    RowBox[{"\[Chi]", " ", 
     RowBox[{"resolution", "^", "2"}]}]}]}], ";"}]}], "Input",ExpressionUUID->\
"ee63a949-1785-974e-a370-e0e7e9804255"],

