Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"\[Epsilon]", ",", "u", ",", "v", ",", "w"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "->", 
       RowBox[{"\[Epsilon]", " ", 
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y", ",", "z"}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"\[Chi]", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "->", 
       RowBox[{"1", "+", 
        RowBox[{"\[Epsilon]", " ", 
         RowBox[{"v", "[", 
          RowBox[{"x", ",", "y", ",", "z"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"resolution", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "->", 
       RowBox[{"\[Epsilon]", " ", 
        RowBox[{"w", "[", 
         RowBox[{"x", ",", "y", ",", "z"}], "]"}]}]}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearizedEuler", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{"Normal", "[", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"extendedEuler", " ", "/.", " ", "linRules"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Epsilon]", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearizedSystem", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"#", ",", "\[Epsilon]", ",", "1"}], "]"}], "==", "0"}], " ", 
       "&"}], " ", "/@", " ", 
      RowBox[{"(", 
       RowBox[{"Subtract", " ", "@@@", " ", "linearizedEuler"}], ")"}]}], " ",
      "//", " ", "Simplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "linearizedSystem"}], \
"Input",ExpressionUUID->"a71e3233-e838-b347-b69c-ff4a19249c62"],

Cell[CellGroupData[{

Cell["5.1 Plane-wave modal ansatz", "Subsection",ExpressionUUID->"9fa2bed1-e79c-a447-8b66-681fb06d338a"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["u", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["u", "TI"], "0"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["k", "TI"], "\[CenterDot]", 
            StyleBox["x", "TI"]}]], ",  ", 
         StyleBox["v", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["v", "TI"], "0"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["k", "TI"], "\[CenterDot]", 
            StyleBox["x", "TI"]}]], ",  ", 
         StyleBox["w", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["w", "TI"], "0"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["k", "TI"], "\[CenterDot]", 
            StyleBox["x", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "u = u_0 e^{i k\\cdot x},\\quad\nv = v_0 e^{i k\\cdot x},\\quad\nw = w_0 \
e^{i k\\cdot x}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1b6d9ae1-aa73-7c40-b509-0035e08195d3"]
}], "Text",ExpressionUUID->"9e0d7d02-4f60-d346-8674-cf8735b6fa04"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "kx", ",", "ky", ",", "kz", ",", "u0", ",", "v0", ",", "w0", ",", 
     "phase"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phase", "=", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"kx", " ", "x"}], "+", 
        RowBox[{"ky", " ", "y"}], "+", 
        RowBox[{"kz", " ", "z"}]}], ")"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"planeWaveRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "->", 
       RowBox[{"u0", " ", "phase"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"v", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "->", 
       RowBox[{"v0", " ", "phase"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"w", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "->", 
       RowBox[{"w0", " ", "phase"}]}]}], "\[IndentingNewLine]", "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modalEquations", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"linearizedSystem", " ", "/.", " ", "planeWaveRules"}], " ", "/.",
        " ", 
       RowBox[{"{", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"phase", ",", "x"}], "]"}], "->", 
          RowBox[{"I", " ", "kx", " ", "phase"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"phase", ",", "y"}], "]"}], "->", 
          RowBox[{"I", " ", "ky", " ", "phase"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"phase", ",", "z"}], "]"}], "->", 
          RowBox[{"I", " ", "kz", " ", "phase"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"phase", ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "->", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"kx", "^", "2"}]}], " ", "phase"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"phase", ",", 
            RowBox[{"{", 
             RowBox[{"y", ",", "2"}], "}"}]}], "]"}], "->", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"ky", "^", "2"}]}], " ", "phase"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"phase", ",", 
            RowBox[{"{", 
             RowBox[{"z", ",", "2"}], "}"}]}], "]"}], "->", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"kz", "^", "2"}]}], " ", "phase"}]}]}], 
        "\[IndentingNewLine]", "   ", "}"}]}], " ", "//", " ", "Simplify"}], 
     ")"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modalEquations", "=", 
    RowBox[{
     RowBox[{"modalEquations", " ", "/.", " ", 
      RowBox[{"phase", "->", "1"}]}], " ", "//", " ", "Simplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "modalEquations"}], "Input",\
ExpressionUUID->"4e63ceb9-59dd-d045-84c9-7bda0247fd40"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.2 Stiffness matrix and eigen-analysis", "Subsection",ExpressionUUID->"f6fc74d3-4048-6040-b048-470f8b7c34ce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kSq", "=", 
    RowBox[{
     RowBox[{"kx", "^", "2"}], "+", 
     RowBox[{"ky", "^", "2"}], "+", 
     RowBox[{"kz", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stiffnessMatrix", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"CoefficientArrays", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Subtract", " ", "@@@", " ", "modalEquations"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "v0", ",", "w0"}], "}"}]}], 
        "\[IndentingNewLine]", "  ", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}], " ", "//", " ", "Normal"}], " ", "//", 
     " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"stiffnessMatrix", " ", "//", " ", "MatrixForm"}]}], "Input",Expressi\
onUUID->"02224bb9-e2c3-9543-87e5-e2440a09ea88"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"stiffnessEigenvalues", "=", 
   RowBox[{
    RowBox[{"Eigenvalues", "[", "stiffnessMatrix", "]"}], " ", "//", " ", 
    "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", "stiffnessEigenvalues"}], "Input",ExpressionUU\
ID->"4516c9f0-be1c-2a4d-87f3-40f99c9c3765"],

Cell["\<\
This is the rigorous point where the OPF \[OpenCurlyDoubleQuote]stable \
frequency\[CloseCurlyDoubleQuote] criterion should be applied.  \
\>", "Text",ExpressionUUID->"50014936-d5b0-c246-bcf9-b63ed5c143ac"],

Cell["\<\
As written, the model is elliptic/static rather than dynamical in time, so \
one obtains spatial mode constraints rather than true temporal resonant \
frequencies. To extract oscillatory frequencies, explicit time-derivative \
terms must be added. \
\>", "Text",ExpressionUUID->"aa0dcd3b-c55b-fa42-b1d9-d1dad93a74ae"],

