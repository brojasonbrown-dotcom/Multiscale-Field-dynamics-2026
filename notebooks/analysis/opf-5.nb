 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"ebcd4d94-31b5-5144-ab86-8ef2e33e425a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Controlled extension: nontrivial field dynamics", "Section",ExpressionUUID->"c9cc9d83-bc9a-244d-a9b8-66624d4ff768"],

Cell["\<\
A mathematically meaningful next step is to add gradient penalties so the \
variational problem produces PDEs rather than pure algebraic constraints.\
\>", "Text",ExpressionUUID->"aba79c43-89dd-9342-b997-5148a85e5041"],

Cell[TextData[{
 "Define an extended Lagrangian: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["ext", FontSlant -> "Plain"]], "\[LongEqual]", "\[Rho]", 
         "log", 
         RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "+", 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], "\[Rho]"], "2"], "\[DoubleVerticalBar]", 
         "\[Del]", 
         SuperscriptBox["\[Rho]\[DoubleVerticalBar]", "2"], "+", 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], "\[Chi]"], "2"], "\[DoubleVerticalBar]", 
         "\[Del]", 
         SuperscriptBox["\[Chi]\[DoubleVerticalBar]", "2"], "+", 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], 
           StyleBox["R", "TI"]], "2"], "\[DoubleVerticalBar]", "\[Del]", 
         StyleBox["R", "TI"], 
         SuperscriptBox["\[DoubleVerticalBar]", "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathcal{L}_{\\mathrm{ext}}\n=\n\\rho \\log(\\chi) + \\chi R^2\n+ \
\\frac{a_\\rho}{2}\\|\\nabla \\rho\\|^2\n+ \\frac{a_\\chi}{2}\\|\\nabla \\chi\
\\|^2\n+ \\frac{a_R}{2}\\|\\nabla R\\|^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bf5a3634-4b65-7b4e-9477-0bdf6b71ae81"]
}], "Text",ExpressionUUID->"8f3e43e6-e095-db44-bbf0-14a5a878bfcf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "aRho", ",", "aChi", ",", "aRes", ",", "gradNormSq", ",", 
     "extendedLagrangian"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gradNormSq", "[", "f_", "]"}], ":=", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"f", ",", "#"}], "]"}], "^", "2"}], " ", "&"}], " ", "/@", 
      " ", "coords3"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"extendedLagrangian", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"\[Chi]", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "]"}]}], "+", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\[Chi]", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], " ", 
      RowBox[{
       RowBox[{"resolution", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "^", "2"}]}], "+", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"aRho", "/", "2"}], " ", 
      RowBox[{"gradNormSq", "[", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "]"}]}], "+", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"aChi", "/", "2"}], " ", 
      RowBox[{"gradNormSq", "[", 
       RowBox[{"\[Chi]", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "]"}]}], "+", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"aRes", "/", "2"}], " ", 
      RowBox[{"gradNormSq", "[", 
       RowBox[{"resolution", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"extendedLagrangian", " ", "//", " ", "TraditionalForm"}]}], "Input",\
ExpressionUUID->"5e3380f1-de02-b84d-bf50-163f107f627f"],

Cell["Now derive proper Euler\[Dash]Lagrange PDEs. ", "Text",ExpressionUUID->"f64ec0e7-b74c-3d41-9644-23a0304e24bd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<VariationalMethods`\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vars", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
      RowBox[{"\[Chi]", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
      RowBox[{"resolution", "[", 
       RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"extendedEuler", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"EulerEquations", "[", 
      RowBox[{"extendedLagrangian", ",", "vars", ",", "coords3"}], "]"}], " ",
      "//", " ", "FullSimplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "extendedEuler"}], "Input",E\
xpressionUUID->"5177b543-af1a-b04c-bc36-dccbef597516"],

